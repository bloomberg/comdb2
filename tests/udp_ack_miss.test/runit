#!/usr/bin/env bash
bash -n "$0" || exit 1
set -x

# With udp on, replicants ack commits over udp.  The master counts, per node,
# the commits it waited on and the udp acks that arrived, and writes a line to
# its log (a WARN line) when too many udp acks are missing.
#
# rand_udp_fails drops a percentage of a node's outgoing udp packets.  Check
# that the master warns only about the node that drops, at most once per
# udp_drop_warn_time, and never while udp is healthy or a replicant is only slow.

DBNAME=$1
[[ -z "$DBNAME" ]] && { echo "Usage: $0 <dbname>"; exit 1; }
[[ -z "$CLUSTER" ]] && { echo "Test only suitable for a clustered setup"; exit 0; }

SQL="${CDB2SQL_EXE} ${CDB2_OPTIONS} --tabs ${DBNAME} default"
WARN_TIME=5
WRITERS=8
MSG="udp acks from"

master=$(${SQL} "select host from comdb2_cluster where is_master='Y'")
replicants=$(${SQL} "select host from comdb2_cluster where is_master='N'")
replicant=$(echo "${replicants}" | head -1)

# Only the master writes the missing-acks line; read every node's log in case
# mastership moves during the test
function masterlog
{
    cat ${TESTDIR}/logs/${DBNAME}.*.db
}

function fail
{
    echo "FAIL: $1"
    masterlog | grep "$MSG"
    exit 1
}

# setattr <host> <attr> <value>
function setattr
{
    ${CDB2SQL_EXE} ${CDB2_OPTIONS} --host $1 ${DBNAME} \
        "exec procedure sys.cmd.send('bdb setattr $2 $3')" || fail "could not set $2 on $1"
}

function set_udp_fails
{
    setattr $1 RAND_UDP_FAILS $2
}

# Every commit waits for the replicants' acks: load <seconds> [writers] [pause between commits]
function load
{
    local end=$((SECONDS + $1))
    local writers=${2:-$WRITERS}
    local pause=${3:-0}
    for ((i = 0; i < writers; i++)); do
        while [[ $SECONDS -lt $end ]]; do
            ${SQL} "insert into t values(1)" > /dev/null
            sleep ${pause}
        done &
    done
    wait
}

function nwarnings
{
    masterlog | grep -c "$MSG"
}

function current_master
{
    ${SQL} "select host from comdb2_cluster where is_master='Y'"
}

# transfer_master <to>: ask whoever is master to hand over, until <to> is master
# and takes writes
function transfer_master
{
    local m
    for ((i = 0; i < 12; i++)); do
        m=$(current_master)
        if [[ "$m" == "$1" ]]; then
            ${SQL} "insert into t values(1)" > /dev/null && return
        elif [[ -n "$m" ]]; then
            ${CDB2SQL_EXE} ${CDB2_OPTIONS} --host $m ${DBNAME} "exec procedure sys.cmd.send('upgrade $1')"
        fi
        sleep 5
    done
    fail "mastership did not move to $1"
}

${SQL} "create table t(a int)" || fail "create table failed"

# Healthy udp: no warnings, under load or idle
load 5
before=$(nwarnings)
load 15
[[ $(nwarnings) -eq $before ]] || fail "warned while udp was healthy"
sleep 15
[[ $(nwarnings) -eq $before ]] || fail "warned while idle with udp healthy"

# Replicant drops this percentage of its udp: warns about that replicant, rate limited.
# expect_warnings <percent> [seconds] [writers] [pause between commits]
function expect_warnings
{
    local pct=$1
    set_udp_fails ${replicant} ${pct}
    local before=$(nwarnings)
    local start=$SECONDS
    load ${2:-20} ${3:-$WRITERS} ${4:-0}
    local elapsed=$((SECONDS - start))
    local new=$(($(nwarnings) - before))
    [[ $new -ge 1 ]] || fail "no warning while ${replicant} dropped ${pct}% of udp"
    [[ $new -le $((elapsed / WARN_TIME + 1)) ]] || fail "${new} warnings in ${elapsed}s, rate limit is ${WARN_TIME}s"
    local others=$(masterlog | grep "$MSG" | tail -n ${new} | grep -vc "$MSG ${replicant}:")
    [[ $others -eq 0 ]] || fail "warned about a node other than ${replicant}"
}

# Replicant drops this percentage of its udp, or none: no warnings once the
# rate-limit window from an earlier phase has passed
function expect_silence
{
    local pct=$1
    set_udp_fails ${replicant} ${pct}
    load $((WARN_TIME + 1))
    local before=$(nwarnings)
    load 15
    [[ $(nwarnings) -eq $before ]] || fail "warned while ${replicant} dropped ${pct}% of udp"
}

# Replicants that ack every commit, but more than a second late: the master
# waits on them more than once per commit.  No udp is lost, so no warnings.
# Several writers, so a window holds enough commits to warn if they were miscounted.
function expect_silence_when_slow
{
    local r
    for r in ${replicants}; do
        setattr $r REP_DEBUG_DELAY 1100
    done
    load $((WARN_TIME + 1)) 4
    local before=$(nwarnings)
    load 30 4
    local after=$(nwarnings)
    for r in ${replicants}; do
        setattr $r REP_DEBUG_DELAY 0
    done
    [[ $after -eq $before ]] || fail "warned while replicants were slow but dropped no udp"
}

# Losses counted during one term as master must not be reported in a later one.
# Leave a few losses in the master's counts, move mastership away and back, then
# commit with no loss.  Runs before any phase that warns, so the rate limit is clear.
function expect_silence_after_new_term
{
    local other=$(echo "${replicants}" | grep -vx "${replicant}" | head -1)
    # Long window: the losses stay counted, not reported, until mastership moves
    setattr ${master} UDP_DROP_WARN_TIME 60
    set_udp_fails ${replicant} 100
    load 5 1 0.5
    set_udp_fails ${replicant} 0
    local before=$(nwarnings)
    [[ $before -eq 0 ]] || fail "warned before mastership moved"
    transfer_master ${other}
    transfer_master ${master}
    load 20 1 0.5
    setattr ${master} UDP_DROP_WARN_TIME ${WARN_TIME}
    [[ $(nwarnings) -eq $before ]] || fail "reported losses from an earlier term as master"
}

# A burst of losses too small to warn about in any one window, followed by
# commits with no loss: the old losses must not be reported along with them
function expect_silence_after_old_losses
{
    # Each window of WARN_TIME seconds loses fewer acks than this
    setattr ${master} UDP_DROP_DELTA_THRESHOLD 40
    load $((WARN_TIME + 1)) 1
    set_udp_fails ${replicant} 100
    load 20 1
    set_udp_fails ${replicant} 0
    local before=$(nwarnings)
    load 20 1
    local after=$(nwarnings)
    setattr ${master} UDP_DROP_DELTA_THRESHOLD 2
    [[ $after -eq $before ]] || fail "reported old losses while udp was healthy"
}

expect_silence_after_new_term
expect_silence_when_slow

# One writer whose commits each wait for the tcp backup ack: only a few commits
# per window, so the master has to keep counting across windows before it warns
expect_warnings 100 30 1
# A quiet node losing half its acks.  Lease renewals also go over udp; they
# must not be counted as acks or they hide the loss.  Renew often, so that a
# renewal nearly always gets through before the tcp backup ack would.
setattr ${replicant} MASTER_LEASE_RENEW_INTERVAL 20
expect_warnings 50 40 1 0.5
setattr ${replicant} MASTER_LEASE_RENEW_INTERVAL 200
expect_silence_after_old_losses
expect_warnings 100
# A busy node: a lost ack is often covered by the next commit's ack, so far
# fewer commits miss than packets are lost (50% lost misses only ~18%).  Lose
# most of them so the warning does not depend on timing.
expect_warnings 90
# Below udp_drop_warn_percent (10%)
expect_silence 5
expect_silence 0

echo "Success"
