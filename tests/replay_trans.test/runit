#!/usr/bin/env bash
bash -n "$0" || exit 1

set -x
source ${TESTSROOTDIR}/tools/runit_common.sh

dbnm=$1

if [ "x$dbnm" == "x" ] ; then
    echo "need a DB name"
    exit 1
fi

function verify() {
    cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "exec procedure sys.cmd.verify('t1')" &> verify.out
    if ! grep succeeded verify.out > /dev/null ; then
	failexit "Verify did not succeed, see verify3.out"
    fi
}

function init() {
    cdb2sql ${CDB2_OPTIONS} $dbnm default "CREATE TABLE t1(i INT UNIQUE, j DATETIME)"
    cdb2sql ${CDB2_OPTIONS} $dbnm default "INSERT INTO t1 VALUES(1, NOW())"

    master=`getmaster`
    if [ -n "$CLUSTER" ] ; then
        logfile="$TESTDIR/logs/$dbnm.$master.db"
    else
        logfile="$TESTDIR/logs/$dbnm.db"
    fi
    cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $master "PUT TUNABLE 'debug.invalid_genid' 1"
}

function set_all_nodes_tunable() {
    local tunable=$1
    local value=$2
    local node
    if [ -n "$CLUSTER" ]; then
        for node in $CLUSTER; do
            cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $node "PUT TUNABLE '$tunable' $value"
        done
    else
        cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $master "PUT TUNABLE '$tunable' $value"
    fi
}

function cleanup() {
    cdb2sql ${CDB2_OPTIONS} $dbnm default "DROP TABLE t1"
}

function assert_fail() {
    if [[ $1 -eq 0 ]]; then
        failexit "transaction succeeded, expected it to fail"
    fi
}

function run_bad_tx_with_intransres() {
    cdb2sql ${CDB2_OPTIONS} $dbnm default - <<EOF
SET INTRANSRESULTS ON
BEGIN
UPDATE t1 SET j = NOW() WHERE i = 1;
COMMIT
EOF
    assert_fail $?
}

function run_bad_tx_without_intransres() {
    cdb2sql ${CDB2_OPTIONS} $dbnm default - <<EOF
SET INTRANSRESULTS OFF
BEGIN
UPDATE t1 SET j = NOW() WHERE i = 1;
COMMIT
EOF
    assert_fail $?
}

function assert_no_state_wrong() {
    local logs=$logfile node
    if [ -n "$CLUSTER" ]; then
        logs=""
        for node in $CLUSTER; do logs="$logs $TESTDIR/logs/$dbnm.$node.db"; done
    fi
    if grep -q "state is wrong" $logs; then
        failexit "$1: replay state not cleaned up"
    fi
}

function run_client_timeout_during_retry() {
    echo "Test: client timeout during retry"
    # Raise retry max on all nodes so retries are still in flight when
    # the client-side api timeout fires.
    set_all_nodes_tunable osql_verify_retry_max 100000

    # Client-side api_call_timeout expires while the server is still retrying.
    # The server should clean up the replay state without "state is wrong" errors.
    COMDB2_CONFIG_API_CALL_TIMEOUT=1000 cdb2sql ${CDB2_OPTIONS} $dbnm default - <<EOF > timeout.out 2>&1 || true
BEGIN
UPDATE t1 SET j = NOW() WHERE i = 1;
COMMIT
EOF
    cat timeout.out
    # 100000 retries take far longer than 1s, so only a client-side timeout
    # ends the txn this early.
    grep -q "Timeout while reading" timeout.out || failexit "client did not time out during retry"

    sleep 2

    set_all_nodes_tunable osql_verify_retry_max 499

    # Server should still be healthy
    out=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "SELECT i FROM t1 WHERE i = 1")
    if [[ "$out" != "1" ]]; then
        failexit "server unhealthy after client timeout during retry, got: $out"
    fi

    assert_no_state_wrong "client disconnect"

    echo "client timeout during retry: passed"
}

function run_queue_full_during_retry() {
    echo "Test: queue full during retry"
    # Shrink the SQL engine pool so it's easy to saturate.
    # Set on all nodes since the client may connect to any of them.
    set_all_nodes_tunable sqlenginepool.maxt 4
    set_all_nodes_tunable sqlenginepool.maxq 2

    # Saturate the pool with long-running queries
    for i in $(seq 1 6); do
        cdb2sql ${CDB2_OPTIONS} $dbnm default "SELECT SLEEP(5)" &>/dev/null &
    done
    sleep 1

    # Trigger a tx that will need to retry — pool is full, dispatch may fail
    cdb2sql ${CDB2_OPTIONS} $dbnm default - <<EOF 2>&1 || true
BEGIN
UPDATE t1 SET j = NOW() WHERE i = 1;
COMMIT
EOF

    # Wait for SLEEP queries to finish and pool to drain
    wait

    # Restore pool settings
    set_all_nodes_tunable sqlenginepool.maxt 48
    set_all_nodes_tunable sqlenginepool.maxq 0

    # Server should still be healthy
    out=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "SELECT i FROM t1 WHERE i = 1")
    if [[ "$out" != "1" ]]; then
        failexit "server unhealthy after queue-full retry, got: $out"
    fi
    echo "queue full during retry: passed"
}

# A retry that can't get back into the queue must still answer the client with
# its verify error, rather than leave it to hit its read timeout. A full queue
# is too timing-dependent to hit reliably, so debug.fail_verify_requeue stands
# in for it.
#   $1 label
#   $2 verify_retry_count_before_backoff, $3 verify_retry_backoff_ms
function run_failed_requeue() {
    local label=$1
    echo "Test: failed re-queue $label"
    set_all_nodes_tunable osql_verify_retry_max 100000
    set_all_nodes_tunable verify_retry_count_before_backoff $2
    set_all_nodes_tunable verify_retry_backoff_ms $3

    local node=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "SELECT comdb2_host()")
    local nodelog=$logfile
    [ -n "$CLUSTER" ] && nodelog=$TESTDIR/logs/$dbnm.$node.db
    local requeue_fails=$(grep -c "could not re-queue retry" $nodelog)

    # invalid_genid is still on, so every replay fails and the txn keeps retrying.
    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node - <<EOF > retry.out 2>&1 &
BEGIN
UPDATE t1 SET j = NOW() WHERE i = 1;
COMMIT
EOF
    local txpid=$!
    sleep 0.5
    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node "PUT TUNABLE 'debug.fail_verify_requeue' 1"

    # Retrying alone would take far longer at 100000 retries; only a failed
    # re-queue ends it early.
    local waited=0
    while kill -0 $txpid 2>/dev/null; do
        if (( waited >= 30 )); then
            kill $txpid
            failexit "$label: txn never answered after a failed re-queue"
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait $txpid && failexit "$label: txn succeeded, expected a verify error"

    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node "PUT TUNABLE 'debug.fail_verify_requeue' 0"
    set_all_nodes_tunable verify_retry_backoff_ms 50
    set_all_nodes_tunable verify_retry_count_before_backoff 3
    set_all_nodes_tunable osql_verify_retry_max 499

    cat retry.out
    # The client's read timeout firing means the server never answered.
    grep -q "Timeout while reading" retry.out && failexit "$label: no answer from server, client timed out"
    grep -q "failed with rc 2 " retry.out || failexit "$label: expected a verify error (rc 2)"
    (( $(grep -c "could not re-queue retry" $nodelog) > requeue_fails )) ||
        failexit "$label: no failed re-queue logged on $node"

    out=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "SELECT i FROM t1 WHERE i = 1")
    if [[ "$out" != "1" ]]; then
        failexit "$label: server unhealthy after failed re-queue, got: $out"
    fi
    assert_no_state_wrong "failed re-queue $label"
    echo "failed re-queue $label: passed"
}

function run_healthy_contention() {
    local backoff=$1
    echo "Test: healthy contention produces correct effects across replays (backoff ${backoff}ms)"
    set_all_nodes_tunable verify_retry_backoff_ms $backoff
    # Real (not forged) verify replays: many writers race to bump the same row
    # to current+1. invalid_genid must be OFF here so replays actually succeed.
    # Assert (1) replays happened and (2) get_effects stayed correct: the sum of
    # updates each writer reported succeeding equals the final row value.
    set_all_nodes_tunable debug.invalid_genid 0

    local node=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default \
        "SELECT host FROM comdb2_cluster WHERE is_master='N' AND coherent_state='coherent' LIMIT 1")
    [[ -z "$node" ]] && node=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "SELECT comdb2_host()")
    local nwriters=10 duration=15
    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node "CREATE TABLE ctr(a INT PRIMARY KEY, b INT)"
    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node "INSERT INTO ctr VALUES(1, 0)"

    # Counter is cumulative and already high from the forced-failure scenarios
    # above, so measure the delta caused by this workload, not the raw value.
    local vr_before=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $node \
        "SELECT value FROM comdb2_metrics WHERE name='verify_replays'")

    writer() {
        local out=$1 n=0 cur nupd start=$SECONDS
        while (( SECONDS - start < duration )); do
            cur=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $node "SELECT b FROM ctr WHERE a=1")
            nupd=$(cdb2sql --showeffects ${CDB2_OPTIONS} $dbnm --host $node \
                "UPDATE ctr SET b=$((cur+1)) WHERE a=1 AND b=$cur" \
                | grep "Number of rows updated " | sed "s/.*updated //g")
            [[ "$nupd" == "1" ]] && n=$((n+1))
        done
        echo $n > $out
    }

    for i in $(seq 1 $nwriters); do writer ${TMPDIR}/w.$i.out & done
    wait

    local reported=0 f
    for f in ${TMPDIR}/w.*.out; do reported=$((reported + $(cat $f))); done
    local final=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $node "SELECT b FROM ctr WHERE a=1")
    local vr_after=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host $node \
        "SELECT value FROM comdb2_metrics WHERE name='verify_replays'")
    local replays=$((vr_after - vr_before))

    echo "reported=$reported final=$final verify_replays(delta)=$replays"
    [[ $replays -gt 0 ]] || failexit "expected verify replays under contention, got 0"
    [[ $reported -eq $final ]] || failexit "get_effects mismatch: reported $reported but row is $final"

    cdb2sql ${CDB2_OPTIONS} $dbnm --host $node "DROP TABLE ctr"
    rm -f ${TMPDIR}/w.*.out
    echo "healthy contention (backoff ${backoff}ms): passed"
}

init
run_bad_tx_with_intransres
run_bad_tx_without_intransres
run_client_timeout_during_retry
run_queue_full_during_retry
# Back-to-back retries: the worker's own re-queue fails.
run_failed_requeue "on immediate re-queue" 100000 0
# Parked retries: the re-queue fails when the timer fires.
run_failed_requeue "when a parked retry wakes up" 0 4000
verify
cleanup
# 50 = default backoff; 0 = the old back-to-back retries
run_healthy_contention 50
run_healthy_contention 0
set_all_nodes_tunable verify_retry_backoff_ms 50
