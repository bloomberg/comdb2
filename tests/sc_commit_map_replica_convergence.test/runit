#!/usr/bin/env bash
bash -n "$0" || exit 1

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh
set -o pipefail

dbnm=$1
N=${SC_COMMIT_MAP_ROWS:-2000}
MAX_DELTA=${SC_COMMIT_MAP_MAX_DELTA:-200}

fail() { echo "FAIL: $*"; exit 1; }

master=$(getmaster)
[[ -n "$master" ]] || fail "could not find master"
mapfile -t nodes < <(getclusternodes)
(( ${#nodes[@]} > 1 )) || { echo "Cluster required; skipping"; exit 0; }

sql_node() {
	cdb2sql --tabs ${CDB2_OPTIONS} --host "$1" "$dbnm" "$2"
}

map_count() {
	sql_node "$1" "select count(*) from comdb2_transaction_commit"
}

send_node() {
	cdb2sql ${CDB2_OPTIONS} --host "$1" "$dbnm" \
		"exec procedure sys.cmd.send('$2')" >/dev/null 2>&1
}

settle_count() {
	local node=$1 previous="" current same=0
	for _ in $(seq 1 180); do
		current=$(map_count "$node")
		if [[ -n "$current" && "$current" == "$previous" ]]; then
			(( same++ ))
			(( same >= 3 )) && { echo "$current"; return; }
		else
			same=0
		fi
		previous=$current
		sleep 1
	done
	fail "commit map on $node did not settle"
}

wait_value() {
	local node=$1 sql=$2 expected=$3 current=""
	for _ in $(seq 1 180); do
		current=$(sql_node "$node" "$sql")
		[[ "$current" == "$expected" ]] && return
		sleep 1
	done
	fail "$node did not return $expected for '$sql' (last ${current:-none})"
}

cleanup() {
	for node in "${nodes[@]}"; do send_node "$node" "sync log-delete on"; done
}
trap cleanup EXIT
for node in "${nodes[@]}"; do send_node "$node" "sync log-delete off"; done

sql_node "$master" "create table t(i int, j int)" >/dev/null
sql_node "$master" "insert into t select value, value from generate_series(1, $N)" >/dev/null
sleep 2

declare -A before after
for node in "${nodes[@]}"; do before[$node]=$(settle_count "$node"); done

sql_node "$master" "rebuild t" >/dev/null || fail "rebuild failed"
wait_for_cluster
asof_target=$(date +%s)
sleep 2

for node in "${nodes[@]}"; do
	after[$node]=$(settle_count "$node")
	delta=$(( after[$node] - before[$node] ))
	echo "SC_REPLICA_SKIP: node=$node before=${before[$node]} after=${after[$node]} delta=$delta"
	(( delta < MAX_DELTA )) ||
		fail "$node added $delta map entries for a $N-row rebuild"
done

master=$(getmaster)
master_count=${after[$master]}
for node in "${nodes[@]}"; do
	difference=$(( after[$node] - master_count ))
	(( difference < 0 )) && difference=$(( -difference ))
	(( difference <= MAX_DELTA )) ||
		fail "$node map differs from master by $difference"
done

replica=""
for node in "${nodes[@]}"; do
	[[ "$node" != "$master" ]] && { replica=$node; break; }
done
[[ -n "$replica" ]] || fail "could not choose replica for snapshot"

expected_sum=$(sql_node "$replica" "select sum(j) from t")
fifo=/tmp/sc_commit_map_checkpoint_replica_fifo.$$
out=/tmp/sc_commit_map_checkpoint_replica_out.$$
mkfifo "$fifo"
cdb2sql --allow-incoherent --tabs ${CDB2_OPTIONS} --host "$replica" "$dbnm" - \
	<"$fifo" >"$out" 2>&1 &
snapshot_pid=$!
exec 9>"$fifo"
printf '%s\n' "set transaction snapshot isolation" "begin" \
	"select count(*) from t" "select sum(j) from t" >&9
sleep 2
sql_node "$master" "update t set j = j + 1000 where i <= $((N / 2))" >/dev/null
updated_sum=$((expected_sum + 1000 * (N / 2)))
wait_value "$replica" "select sum(j) from t" "$updated_sum"
printf '%s\n' "select count(*) from t" "select sum(j) from t" "commit" >&9
exec 9>&-
wait "$snapshot_pid" || fail "replica snapshot client failed"
mapfile -t snapshot_values < <(grep -vE '^\[' "$out")
rm -f "$fifo" "$out"
(( snapshot_values[0] == N && snapshot_values[2] == N )) ||
	fail "replica snapshot row count changed: ${snapshot_values[*]}"
[[ "${snapshot_values[1]}" == "$expected_sum" &&
	"${snapshot_values[3]}" == "$expected_sum" ]] ||
	fail "replica snapshot sum changed: ${snapshot_values[*]}"
echo "SC_REPLICA_CHECKPOINT_SNAPSHOT: node=$replica rows=$N"

victim=""
for node in "${nodes[@]}"; do
	[[ "$node" != "$master" ]] && { victim=$node; break; }
done
[[ -n "$victim" ]] || fail "could not choose replica to restart"
kill_restart_node "$victim" 0 1
wait_for_cluster
recovered=$(settle_count "$victim")
master_count=$(settle_count "$(getmaster)")
difference=$(( recovered - master_count ))
(( difference < 0 )) && difference=$(( -difference ))
echo "SC_REPLICA_RECOVERY_SKIP: node=$victim recovered=$recovered master=$master_count difference=$difference"
(( difference <= MAX_DELTA )) ||
	fail "$victim recovery map differs from master by $difference"

asof_read() {
	local node=$1 output
	output=$(cdb2sql --allow-incoherent --tabs ${CDB2_OPTIONS} --host "$node" \
		"$dbnm" - 2>&1 <<EOF
set transaction snapshot isolation
begin transaction as of datetime $asof_target
select count(*), sum(j) from t
commit
EOF
)
	grep -E "^${N}[[:space:]]+${expected_sum}$" <<<"$output" >/dev/null ||
		fail "$node could not reconstruct post-rebuild AS-OF state: $output"
}

asof_read "$victim"
echo "SC_REPLICA_CHECKPOINT_RECOVERY: node=$victim target=$asof_target"

old_master=$(getmaster)
downgrade_master || fail "could not force promotion"
new_master=$(getmaster)
[[ -n "$new_master" && "$new_master" != "$old_master" ]] ||
	fail "master did not change ($old_master -> ${new_master:-none})"
wait_value "$new_master" "select sum(j) from t" "$updated_sum"
asof_read "$new_master"
echo "SC_REPLICA_CHECKPOINT_PROMOTION: old=$old_master new=$new_master"

echo "Passed test"
