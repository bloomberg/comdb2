#!/usr/bin/env bash
bash -n "$0" || exit 1

dbname=$1

${TESTSROOTDIR}/tools/compare_results.sh -s -d $dbname
[ $? -eq 0 ] || exit 1

# Test that compress_gzip() compresses in gzip format
str1="hello world"
str2=`cdb2sql --binary ${CDB2_OPTIONS} $dbname default "select compress_gzip(\"$str1\")" | gzip -d`
if [[ "${str1}x" != "${str2}x" ]]; then
    echo "Couldn't compress using gzip"
    echo "Expected: $str1"
    echo "Got     : $str2"
    exit 1
fi

# Test that (un)compress functions do not leak their result buffers
sql() {
    cdb2sql --tabs ${CDB2_OPTIONS} $dbname default "$1"
}

sqlmem() {
    sql "select sum(used) from comdb2_memstats where scope='sqlenginepool' and name in ('sqlite', 'SQLITE')"
}

rows=500
blobsz=100000
maxgrowth=$((10 * 1024 * 1024))

sql "create table leak_zlib(b blob)" || exit 1
sql "create table leak_gzip(b blob)" || exit 1
sql "insert into leak_zlib select compress(zeroblob($blobsz)) from generate_series(1, $rows)" || exit 1
sql "insert into leak_gzip select compress_gzip(zeroblob($blobsz)) from generate_series(1, $rows)" || exit 1

for q in \
    "select sum(length(compress(randomblob($blobsz)))) from generate_series(1, $rows)" \
    "select sum(length(compress_zlib(randomblob($blobsz)))) from generate_series(1, $rows)" \
    "select sum(length(compress_gzip(randomblob($blobsz)))) from generate_series(1, $rows)" \
    "select sum(length(uncompress(b))) from leak_zlib" \
    "select sum(length(uncompress_zlib(b))) from leak_zlib" \
    "select sum(length(uncompress_gzip(b))) from leak_gzip"; do
    before=$(sqlmem)
    sql "$q" > /dev/null || exit 1
    after=$(sqlmem)
    growth=$((after - before))
    echo "$q: sql memory grew by $growth bytes"
    if [[ $growth -gt $maxgrowth ]]; then
        echo "Memory leak detected: $q (grew by $growth bytes)"
        exit 1
    fi
done

exit 0
