#!/usr/bin/env bash
bash -n "$0" || exit 1
# A snapshot txn must still see the old blobs after another session updates or deletes their rows and
# reuses the freed pages.  Blobs of 150KB span three 64KB overflow pages.
db=$1
host=$(cdb2sql ${CDB2_OPTIONS} -tabs $db default "select comdb2_host()")
sql="cdb2sql -s ${CDB2_OPTIONS} -tabs $db --host $host"
q() { $sql "$1" > /dev/null || { echo "FAILED: $1"; exit 1; }; }
sel() { echo "select length(b), checksum_md5(b) from t1 where id = $1"; }

q "insert into t1(id, b) values (1, randomblob(150000)), (2, randomblob(150000))"
want1=$($sql "$(sel 1)"); want2=$($sql "$(sel 2)")

# Snapshot session: statements in on fd 3, one reply line per select out on fd 4.
rm -f S.in S.out; mkfifo S.in S.out
stdbuf -oL $sql - < S.in > S.out 2>&1 &
exec 3>S.in 4<S.out
trap 'kill $(jobs -p) 2>/dev/null; rm -f S.in S.out' EXIT
echo "set transaction snapshot" >&3; echo "begin" >&3
rd() { local l; read -t 30 -r -u 4 l || { echo "FAILED: $1: no reply from snapshot session"; exit 1; }
       echo "$1: $l"; [[ "$l" == "$2" ]] || { echo "FAILED: $3"; exit 1; }; }

sel 1 >&3; rd "updated-row before" "$want1" "snapshot did not read the row"
sel 2 >&3; rd "deleted-row before" "$want2" "snapshot did not read the row"
q "update t1 set b = randomblob(150000) where id = 1"
q "delete from t1 where id = 2"
for i in 3 4 5 6; do q "insert into t1(id, b) values ($i, randomblob(150000))"; done
sel 1 >&3; rd "updated-row after " "$want1" "snapshot lost old blob after update"
sel 2 >&3; rd "deleted-row after " "$want2" "snapshot lost old blob after delete+reuse"
echo "commit" >&3; echo "quit" >&3
exec 3>&- 4<&-; wait
echo "Testcase passed."
