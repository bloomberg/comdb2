#!/usr/bin/env bash
bash -n "$0" | exit 1
source ${TESTSROOTDIR}/tools/runit_common.sh

dbnm=$1
if [ "x$dbnm" == "x" ] ; then
    echo "need a DB name"
    exit 1
fi

NROWS=2000

run() {
    cdb2sql ${CDB2_OPTIONS} $dbnm default "$1"
}

runtabs() {
    cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default "$1"
}

# comdb2 advertises index names to sqlite in "new style" form:
# "$<keyname>_<crc>".  Match on that prefix rather than the whole name.
stat_rows_like() {
    runtabs "select count(*) from sqlite_stat1 where tbl='$1' and idx like '\$$2_%'"
}

dump_stats() {
    echo "--- sqlite_stat1 ---"
    runtabs "select tbl, idx, stat from sqlite_stat1"
    echo "--------------------"
}

# No polling: the stats commit before the schema change finalizes, and a
# replicant acks a transaction only once it holds its locks, so a read on any
# coherent node either sees the stats or blocks until it can.  Stats missing
# right after the schema change returns are a real failure.
assert_stats_present() {
    local tbl=$1 key=$2 what=$3
    local n=$(stat_rows_like $tbl $key)
    if [ "$n" == "0" ] || [ "x$n" == "x" ]; then
        echo "FAIL: $what: no sqlite_stat1 rows for $tbl key $key"
        dump_stats
        exit 1
    fi
    echo "ok: $what (stat rows: $n)"
}

assert_stats_absent() {
    local tbl=$1 key=$2 what=$3
    local n=$(stat_rows_like $tbl $key)
    if [ "$n" != "0" ]; then
        echo "FAIL: $what: expected no stat rows for $tbl key $key, got $n"
        dump_stats
        exit 1
    fi
    echo "ok: $what"
}

# Statistics are gathered against the pre-commit newdb, whose index tags carry
# a ".NEW." prefix.  They must be written under the name the index will have
# once the schema change commits; if any leak through, the planner would never
# find them.
assert_no_dotnew_stats() {
    local n1=$(runtabs "select count(*) from sqlite_stat1 where idx like '%.NEW.%'")
    if [ "$n1" != "0" ]; then
        echo "FAIL: $1: sqlite_stat1 has .NEW. index names"
        dump_stats
        exit 1
    fi
    echo "ok: $1: no .NEW. names in sqlite_stat1"
}

# The reason these statistics are committed before the schema change finalizes:
# replication is ordered, so the stats transaction lands on every replicant
# ahead of the schema change itself.  No node should ever be able to see the
# new index without its statistics.
assert_stats_on_all_nodes() {
    local tbl=$1 key=$2 what=$3
    local nodes n cnt
    nodes=$(getclusternodes)
    # standalone runs have no cluster rows; nothing extra to check
    [ -z "$nodes" ] && { echo "ok: $what (single node, skipped)"; return; }
    for n in $nodes; do
        cnt=$($CDB2SQL_EXE --tabs ${CDB2_OPTIONS} $dbnm --host $n \
              "select count(*) from sqlite_stat1 where tbl='$tbl' and idx like '\$${key}_%'")
        if [ "$cnt" == "0" ] || [ "x$cnt" == "x" ]; then
            echo "FAIL: $what: node $n has no stats for $tbl key $key"
            $CDB2SQL_EXE --tabs ${CDB2_OPTIONS} $dbnm --host $n \
                "select tbl, idx, stat from sqlite_stat1"
            exit 1
        fi
    done
    echo "ok: $what (all nodes: $(echo $nodes | tr '\n' ' '))"
}

populate() {
    local tbl=$1
    # skewed distribution: 'common' dominates, 'rare' is highly selective
    cdb2sql ${CDB2_OPTIONS} $dbnm default - <<EOF > /dev/null
set maxtransize 100000
begin
$(for ((i=0; i<NROWS; i++)); do
    if [ $((i % 500)) -eq 0 ]; then
        echo "insert into $tbl(a, b, c) values($i, 'rare', $i)"
    else
        echo "insert into $tbl(a, b, c) values($i, 'common', $i)"
    fi
done)
commit
EOF
}

echo "=== setup ==="
run "drop table if exists t1" > /dev/null
run "drop table if exists t2" > /dev/null
run "truncate sqlite_stat1" > /dev/null
run "truncate sqlite_stat4" > /dev/null

run "create table t1 { schema { int a  cstring b[32]  int c } }" > /dev/null
populate t1
assertcnt t1 $NROWS

# ---------------------------------------------------------------------------
# CREATE INDEX populates stats with no explicit ANALYZE
# ---------------------------------------------------------------------------
echo "=== CREATE INDEX ==="
assert_stats_absent t1 IXA "no stats before index exists"

run "create index ixa on t1(a)" > /dev/null
assert_stats_present t1 IXA "CREATE INDEX populated stats"
assert_no_dotnew_stats "CREATE INDEX"
assert_stats_on_all_nodes t1 IXA "CREATE INDEX stats visible on every node"
dump_stats

# ---------------------------------------------------------------------------
# ALTER TABLE adding an index does the same
# ---------------------------------------------------------------------------
echo "=== ALTER ADD INDEX ==="
ixa_before=$(runtabs "select stat from sqlite_stat1 where tbl='t1' and idx like '\$IXA_%'")
run "alter table t1 { schema { int a  cstring b[32]  int c }
                      keys { dup \"IXA\" = a
                             dup \"IXB\" = b } }" > /dev/null
assert_stats_present t1 IXB "ALTER ADD INDEX populated stats"
assert_no_dotnew_stats "ALTER ADD INDEX"
# The whole table is analyzed, including IXA, which is reused: it holds no
# data in newdb yet, so it has to be read from the old table.  Same data, so
# the same stats -- an empty read would lose them.
assert_stats_present t1 IXA "ALTER ADD INDEX refreshed IXA stats"
ixa_after=$(runtabs "select stat from sqlite_stat1 where tbl='t1' and idx like '\$IXA_%'")
if [ "$ixa_after" != "$ixa_before" ]; then
    echo "FAIL: reused IXA stats changed: '$ixa_before' -> '$ixa_after'"
    dump_stats
    exit 1
fi
echo "ok: reused IXA stats read from the old table ($ixa_after)"
dump_stats

# ---------------------------------------------------------------------------
# Altering an index definition refreshes its stats.
# IXB goes from (b) to (b, a); the stat string must change shape.
# ---------------------------------------------------------------------------
echo "=== ALTER INDEX DEFINITION ==="
before=$(runtabs "select stat from sqlite_stat1 where tbl='t1' and idx like '\$IXB_%'")
echo "stat before: $before"

run "alter table t1 { schema { int a  cstring b[32]  int c }
                      keys { dup \"IXA\" = a
                             dup \"IXB\" = b + a } }" > /dev/null
assert_stats_present t1 IXB "altered index has stats"
assert_stats_present t1 IXA "altering IXB left IXA stats intact"
# Altering the definition renames the index ($IXB_<crc> covers the columns).
# Analyzing the whole table moves all of t1's rows aside to cdb2.t1.sav, as a
# full ANALYZE does, so the old name's row no longer sits under t1.
nixb=$(stat_rows_like t1 IXB)
if [ "$nixb" != "1" ]; then
    echo "FAIL: expected one IXB stat row after the alter, got $nixb"
    dump_stats
    exit 1
fi
echo "ok: old IXB row moved aside, not left under t1"

after=$(runtabs "select stat from sqlite_stat1 where tbl='t1' and idx like '\$IXB_%'")
echo "stat after: $after"

# (b) yields two integers, (b,a) yields three -- the stats describe the new
# definition, not the old one.
nvals=$(echo $after | wc -w)
if [ "$nvals" -lt 3 ]; then
    echo "FAIL: altered index stats still describe the old definition: '$after'"
    exit 1
fi
echo "ok: altered index stats reflect new key structure ($nvals values)"
dump_stats

# ---------------------------------------------------------------------------
# A rebuild that does not change key structure must not lose stats.
# Adding a column rebuilds datacopy indexes; their stats stay valid.
# ---------------------------------------------------------------------------
echo "=== datacopy rebuild preserves stats ==="
run "drop table if exists t2" > /dev/null
run "create table t2 { schema { int a  cstring b[32]  int c }
                       keys { datacopy dup \"IXA\" = a } }" > /dev/null
populate t2
# A plain ANALYZE is refused while a schema change is in progress
# (do_analyze -> get_schema_change_in_progress), and on a cluster the previous
# alter can still be settling.  Retry on the outcome we actually care about --
# stats existing -- rather than on parsing ANALYZE's output.
analyze_until_stats() {
    local tbl=$1 key=$2 i n
    for i in $(seq 1 30); do
        run "analyze $tbl" > /dev/null 2>&1
        n=$(stat_rows_like $tbl $key)
        [ "$n" != "0" ] && [ "x$n" != "x" ] && return 0
        sleep 2
    done
    return 1
}
if ! analyze_until_stats t2 IXA; then
    echo "FAIL: baseline ANALYZE never produced stats for t2"
    dump_stats
    exit 1
fi
assert_stats_present t2 IXA "baseline stats on datacopy index"

run "alter table t2 { schema { int a  cstring b[32]  int c  int d null=yes }
                      keys { datacopy dup \"IXA\" = a } }" > /dev/null
assert_stats_present t2 IXA "datacopy rebuild kept stats"

# ---------------------------------------------------------------------------
# DROP INDEX leaves no stats behind for the dropped index
# ---------------------------------------------------------------------------
echo "=== DROP INDEX ==="
run "drop index \"IXB\" on t1" > /dev/null
run "analyze t1" > /dev/null
assert_stats_absent t1 IXB "dropped index has no stats"

# ---------------------------------------------------------------------------
# Tunable off restores previous behavior
# ---------------------------------------------------------------------------
echo "=== tunable off ==="
# put tunable is node-local, and the schema change runs on the master, so
# this has to reach every node.
sendtocluster "put tunable analyze_new_indexes 0" > /dev/null
run "drop table if exists t2" > /dev/null
run "create table t2 { schema { int a  cstring b[32]  int c } }" > /dev/null
populate t2
run "create index ixz on t2(a)" > /dev/null
assert_stats_absent t2 IXZ "tunable off: no stats collected"

sendtocluster "put tunable analyze_new_indexes 1" > /dev/null
run "create index ixy on t2(b)" > /dev/null
assert_stats_present t2 IXY "tunable back on: stats collected"
# t2 was never analyzed and IXZ was built with the tunable off.  Creating IXY
# analyzes the whole table, so IXZ gets stats too instead of being the one
# index the planner has to guess about.
assert_stats_present t2 IXZ "existing unanalyzed index got stats too"

# ---------------------------------------------------------------------------
# Plan quality, the reason for the feature.  t3 has a selective, analyzed
# index on cust (~40 rows per value) and then gets a new index on status,
# which has only 3 values.  Without stats the planner assumes the new index
# matches ~10 rows and switches to it; with stats it keeps using cust.
# ---------------------------------------------------------------------------
PLANQ="select count(*), sum(amount) from t3 where cust = 7 and status = 'open'"

plan_uses() {
    runtabs "explain query plan $PLANQ" | grep -cF "USING INDEX \$${1}_"
}

setup_t3() {
    run "drop table if exists t3" > /dev/null
    run "create table t3(id int, cust int, status cstring(10), amount int)" > /dev/null
    run "insert into t3 select value, value % 500, case value % 3 when 0 then 'open' when 1 then 'shipped' else 'closed' end, value % 100 from generate_series(1, 20000)" > /dev/null
    run "create index cust on t3(cust)" > /dev/null
    if ! analyze_until_stats t3 CUST; then
        echo "FAIL: baseline ANALYZE never produced stats for t3"
        dump_stats
        exit 1
    fi
}

check_plan() {
    local want=$1 what=$2
    if [ "$(plan_uses $want)" == "0" ]; then
        echo "FAIL: $what: expected the plan to use index $want"
        runtabs "explain query plan $PLANQ"
        dump_stats
        exit 1
    fi
    echo "ok: $what"
}

echo "=== plan without stats for the new index (tunable off) ==="
sendtocluster "put tunable analyze_new_indexes 0" > /dev/null
setup_t3
check_plan CUST "before the new index the plan uses cust"
run "create index status on t3(status)" > /dev/null
assert_stats_absent t3 STATUS "tunable off: new index has no stats"
check_plan STATUS "tunable off: the planner switches to the unselective new index"

echo "=== plan with stats for the new index (tunable on) ==="
sendtocluster "put tunable analyze_new_indexes 1" > /dev/null
setup_t3
run "create index status on t3(status)" > /dev/null
assert_stats_present t3 STATUS "tunable on: new index has stats"
check_plan CUST "tunable on: the planner keeps the selective index"

# ---------------------------------------------------------------------------
# A full rebuild has no schema-change plan: convert writes every index into
# newdb, so the whole table is analyzed from there.  The indexes here were
# built with the feature off, so the stats can only come from the rebuild.
# sc_analyze_required must not treat the missing plan as a failure.
# ---------------------------------------------------------------------------
echo "=== REBUILD (no plan) ==="
sendtocluster "put tunable analyze_new_indexes 0" > /dev/null
run "drop table if exists t5" > /dev/null
run "create table t5(a int, b int)" > /dev/null
run "insert into t5 select value, value % 7 from generate_series(1, 100)" > /dev/null
run "create index t5a on t5(a)" > /dev/null
run "create index t5b on t5(b)" > /dev/null
assert_stats_absent t5 T5A "indexes built with the feature off have no stats"

sendtocluster "put tunable analyze_new_indexes 1" > /dev/null
sendtocluster "put tunable sc_analyze_required 1" > /dev/null
if ! run "rebuild t5" > /dev/null; then
    echo "FAIL: REBUILD failed with sc_analyze_required on"
    exit 1
fi
sendtocluster "put tunable sc_analyze_required 0" > /dev/null
assert_stats_present t5 T5A "REBUILD analyzed t5a"
assert_stats_present t5 T5B "REBUILD analyzed t5b"

# ---------------------------------------------------------------------------
# sc_analyze_required: if the analyze cannot run, the schema change fails
# instead of proceeding without stats.  Disabling sampling makes it unable to
# run, since reused indexes can only be read through their samples.
# ---------------------------------------------------------------------------
echo "=== sc_analyze_required ==="
run "drop table if exists t4" > /dev/null
run "create table t4(a int, b int)" > /dev/null
run "insert into t4 select value, value % 7 from generate_series(1, 100)" > /dev/null
sendtocluster "exec procedure sys.cmd.send('analyze nosample')" > /dev/null

run "create index t4a on t4(a)" > /dev/null
if [ "$(runtabs "select count(*) from comdb2_keys where tablename='t4' and keyname='T4A'")" != "1" ]; then
    echo "FAIL: required off: CREATE INDEX should succeed without stats"
    exit 1
fi
assert_stats_absent t4 T4A "required off: index created without stats"

sendtocluster "put tunable sc_analyze_required 1" > /dev/null
out=$(run "create index t4b on t4(b)" 2>&1)
if [ $? -eq 0 ] || ! echo "$out" | grep -q "Cannot analyze table t4: sampling is disabled"; then
    echo "FAIL: required on: CREATE INDEX should fail when analyze cannot run: $out"
    exit 1
fi
if [ "$(runtabs "select count(*) from comdb2_keys where tablename='t4' and keyname='T4B'")" != "0" ]; then
    echo "FAIL: required on: failed CREATE INDEX left the index behind"
    exit 1
fi
echo "ok: required on: schema change failed and the index was not created"

sendtocluster "put tunable sc_analyze_required 0" > /dev/null
sendtocluster "exec procedure sys.cmd.send('analyze sample')" > /dev/null

echo "SUCCESS"
exit 0
