#!/usr/bin/env bash
bash -n "$0" || exit 1

# sc_commit_map_skip on a cluster.  Every node keeps the converter commits out
# of its commit LSN map (only the master with sc_commit_map_skip_replicants
# off), also when a replicant rebuilds its map at startup.  A master that loses
# mastership mid rebuild, even while waiting for its checkpoint, leaves the
# rebuild to the next master instead of aborting it, and every node reads the
# rebuilt table correctly afterwards.  A rebuild whose checkpoint stays
# blocked past the timeout fails, and mastership stays where it is.

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh
set -o pipefail

[ -z "${CLUSTER}" ] && { echo "Test requires a cluster"; exit 0; }

dbnm=$1
N=${SC_COMMIT_MAP_ROWS:-5000}
SLACK=${SC_COMMIT_MAP_SLACK:-200}
SUM=$((N * (N + 1) / 2))

on() { local h=$1; shift; cdb2sql --tabs ${CDB2_OPTIONS} --host "$h" "$dbnm" "$@"; }
# ask the cluster's own nodes: getmaster goes through the client's default route,
# which has answered with nothing, or a host outside the cluster, under load
master() {
	local node m
	for node in $CLUSTER; do
		m=$(on $node "select host from comdb2_cluster where is_master='Y'" 2>/dev/null)
		[[ -n "$m" && " $CLUSTER " == *" $m "* ]] && { echo $m; return 0; }
	done
	return 1
}
fail() { echo "FAIL: $*"; exit 1; }
log() { echo $TESTDIR/logs/$dbnm.$1.db; }
entries() { on $1 "exec procedure sys.cmd.send('bdb clminfo')" | grep -oP '(?<=Entries: )[0-9]+'; }
snapshot() {
	on $1 - <<EOF | grep -v -e '^$' -e '^\['
set transaction snapshot isolation
begin
$2
commit
EOF
}

# every node reads the table, in a snapshot, as it should be
check_nodes() {
	local tbl=$1 node got
	for node in $CLUSTER; do
		for _ in $(seq 1 60); do
			got=$(snapshot $node "select count(*), sum(j) from $tbl" 2>/dev/null)
			[[ "$got" == "$N	$SUM" ]] && break
			sleep 1
		done
		[[ "$got" == "$N	$SUM" ]] || fail "$tbl on $node: got '$got'"
	done
}

wait_committed() {
	local st
	for _ in $(seq 1 300); do
		st=$(on $(master) "select status from comdb2_sc_status where name='$1'" 2>/dev/null)
		[[ "$st" == "COMMITTED" ]] && return 0
		[[ "$st" == "ABORTED" ]] && fail "schema change of $1 was aborted"
		sleep 1
	done
	fail "schema change of $1 did not finish: '$st'"
}

fill() {
	on $(master) "create table $1(i int, j int)" >/dev/null || fail "create $1"
	on $(master) "insert into $1 select value, value from generate_series(1, $N)" >/dev/null || fail "fill $1"
}

for node in $CLUSTER; do
	on $node "exec procedure sys.cmd.send('sync log-delete off 3600')" >/dev/null
done
trap 'for node in $CLUSTER; do on $node "exec procedure sys.cmd.send(\"sync log-delete on\")" >/dev/null 2>&1; done' EXIT

# hold the master's rebuild of $1 at its checkpoint; prints the master
hold_rebuild() {
	local m=$(master) holds
	holds=$(grep -c "holding before the commit LSN map checkpoint" "$(log $m)")
	on $m "put tunable 'debug_sc_commit_map_checkpoint_hold' 1" >/dev/null
	on $m "rebuild $1" >/dev/null 2>&1 &
	for _ in $(seq 1 600); do
		(( $(grep -c "holding before the commit LSN map checkpoint" "$(log $m)") > holds )) && break
		sleep 0.1
	done
	(( $(grep -c "holding before the commit LSN map checkpoint" "$(log $m)") > holds )) || fail "rebuild of $1 never held"
	echo $m
}

declare -A before
# rebuild $1 on the master; prints each node's growth as "node delta"
rebuild_deltas() {
	local m=$(master) node
	for node in $CLUSTER; do before[$node]=$(entries $node); done
	on $m "rebuild $1" >/dev/null || fail "rebuild $1"
	check_nodes $1
	for node in $CLUSTER; do echo "$node $(( $(entries $node) - before[$node] ))"; done
}

echo "=== with sc_commit_map_skip_replicants off, only the master leaves the converter commits out"
fill u
m=$(master)
on $m "put tunable 'sc_commit_map_skip_replicants' 0" >/dev/null
rebuild_deltas u >"$TMPDIR/deltas.u"
while read node delta; do
	echo "$node: $delta entries"
	if [[ $node == $m ]]; then
		(( delta < SLACK )) || fail "master $node added $delta entries"
	else
		(( delta >= N )) || fail "replicant $node added only $delta entries"
	fi
done < "$TMPDIR/deltas.u"
on $m "put tunable 'sc_commit_map_skip_replicants' 1" >/dev/null

echo "=== by default every node leaves the converter commits out"
fill t
m=$(master)
rebuild_deltas t >"$TMPDIR/deltas.t"
while read node delta; do
	echo "$node: $delta entries"
	(( delta < SLACK )) || fail "$node added $delta entries"
done < "$TMPDIR/deltas.t"

echo "=== a restarted replicant rebuilds its map from the log without the flagged commits"
for r in $CLUSTER; do [[ $r != $(master) ]] && break; done
kill_restart_node $r 2
on $r "exec procedure sys.cmd.send('sync log-delete off 3600')" >/dev/null
e=$(entries $r)
echo "$r: $e entries after restart"
# u's converter commits (unflagged) are back, t's (flagged) are not
(( e >= N )) || fail "$r rebuilt only $e entries: recovery did not reach u's rebuild"
(( e < 2 * N )) || fail "$r rebuilt $e entries: t's converter commits are back"

echo "=== snapshots on a replicant, begun before publication, never read a partial table"
# one reads before and after publication, the other only after; the replicant
# applied the publication before either reads again
fill g
m=$(hold_rebuild g) || fail "rebuild of g never held"
for r in $CLUSTER; do [[ $r != $m ]] && break; done
reloads=$(grep -c "update_dbstore table 'g'" "$(log $r)")
for k in 1 2; do
	rm -f $TMPDIR/rep$k.fifo
	mkfifo $TMPDIR/rep$k.fifo
	cdb2sql --tabs ${CDB2_OPTIONS} --host "$r" "$dbnm" - <$TMPDIR/rep$k.fifo >$TMPDIR/rep$k.out 2>&1 &
	snap_pid[$k]=$!
done
exec 8>$TMPDIR/rep1.fifo 9>$TMPDIR/rep2.fifo
printf '%s\n' "set transaction snapshot isolation" "begin" "select count(*), sum(j) from g" >&8
printf '%s\n' "set transaction snapshot isolation" "begin" >&9
for _ in $(seq 1 100); do grep -q "^$N	$SUM$" $TMPDIR/rep1.out && break; sleep 0.1; done
grep -q "^$N	$SUM$" $TMPDIR/rep1.out || { cat $TMPDIR/rep1.out; fail "snapshot on $r did not start"; }
on $m "put tunable 'debug_sc_commit_map_checkpoint_hold' 0" >/dev/null
wait_committed g
for _ in $(seq 1 300); do
	(( $(grep -c "update_dbstore table 'g'" "$(log $r)") > reloads )) && break
	sleep 0.1
done
(( $(grep -c "update_dbstore table 'g'" "$(log $r)") > reloads )) || fail "$r did not apply the publication of g"
printf '%s\n' "select count(*), sum(j) from g" "commit" >&8
printf '%s\n' "select count(*), sum(j) from g" "commit" >&9
exec 8>&- 9>&-
wait ${snap_pid[1]} ${snap_pid[2]}
for k in 1 2; do
	echo "--- snapshot $k on $r"
	cat $TMPDIR/rep$k.out
	# the only allowed outcome: the read after publication fails as schema changed
	grep -E "^[0-9]+	" $TMPDIR/rep$k.out | grep -v "^$N	$SUM$" && fail "snapshot $k on replicant $r read a partial table"
	grep -q "table \"g\" was schema changed" $TMPDIR/rep$k.out || fail "snapshot $k on replicant $r did not fail as schema changed"
	[[ $(grep -c "^\[select .*\] failed with rc" $TMPDIR/rep$k.out) == 1 ]] || fail "snapshot $k on replicant $r: expected exactly one failed read"
done
check_nodes g

echo "=== a downgrade while the master waits for its checkpoint leaves the rebuild to the next master"
fill d
m=$(master)
holds=$(grep -c "holding before the commit LSN map checkpoint" "$(log $m)")
on $m "put tunable 'debug_sc_commit_map_checkpoint_hold' 1" >/dev/null
on $m "rebuild d" >/dev/null 2>&1 &
rb_pid=$!
for _ in $(seq 1 600); do
	(( $(grep -c "holding before the commit LSN map checkpoint" "$(log $m)") > holds )) && break
	sleep 0.1
done
(( $(grep -c "holding before the commit LSN map checkpoint" "$(log $m)") > holds )) || fail "rebuild of d never held"
downgrade_master
on $m "put tunable 'debug_sc_commit_map_checkpoint_hold' 0" >/dev/null
wait $rb_pid
grep -q "Master downgrading before the commit LSN map checkpoint" "$(log $m)" || fail "downgrade did not stop the wait on $m"
wait_committed d
nm=$(master)
echo "old master $m, new master $nm"
grep -q "checkpoint is past the converter commits" "$(log $nm)" || fail "new master $nm did not checkpoint"
check_nodes d
on $nm "exec procedure sys.cmd.send('llmeta list')" | grep "LLMETA_SCHEMACHANGE" | grep -v "HISTORY" | grep -qw d &&
	fail "schema change of d left in llmeta"

echo "=== a checkpoint blocked past the timeout fails the rebuild; mastership stays and a retry succeeds"
fill b
m=$(master)
blocked=$(grep -c "Commit LSN map checkpoint still blocked" "$(log $m)")
on $m "put tunable 'sc_commit_map_checkpoint_timeout_ms' 2000" >/dev/null
on $m "exec procedure sys.cmd.send('bdb setattr DELAY_WRITES_IN_RECORD_C 8000')" >/dev/null
# an application transaction that holds the checkpoint back past the timeout
on $m "insert into t values(-1, -1), (-2, -2)" >/dev/null 2>&1 &
ins_pid=$!
sleep 1
on $m "rebuild b" >/dev/null 2>&1; rc=$?
wait $ins_pid; ins_rc=$?
on $m "exec procedure sys.cmd.send('bdb setattr DELAY_WRITES_IN_RECORD_C 0')" >/dev/null 2>&1
on $m "put tunable 'sc_commit_map_checkpoint_timeout_ms' 600000" >/dev/null 2>&1
echo "rebuild rc $rc, blocking insert rc $ins_rc"
(( rc != 0 )) || fail "rebuild of b succeeded past a blocked checkpoint"
(( $(grep -c "Commit LSN map checkpoint still blocked" "$(log $m)") > blocked )) || fail "timeout was not reported"
[[ "$(master)" == "$m" ]] || fail "mastership moved from $m to $(master)"
(( ins_rc == 0 )) || fail "the blocking insert failed"
[[ "$(on $m "select count(*) from t where i < 0")" == 2 ]] || fail "the blocking insert is not there"
check_nodes b
on $m "rebuild b" >/dev/null || fail "retry of the rebuild of b"
check_nodes b
on $m "delete from t where i < 0" >/dev/null

echo "=== a snapshot on the old master, started before the downgrade, never reads a partial table"
fill f
m=$(hold_rebuild f) || fail "rebuild of f never held"
fifo=$TMPDIR/old.fifo
out=$TMPDIR/old.out
rm -f "$fifo"
mkfifo "$fifo"
cdb2sql --tabs ${CDB2_OPTIONS} --host "$m" "$dbnm" - <"$fifo" >"$out" 2>&1 &
snap_pid=$!
exec 9>"$fifo"
printf '%s\n' "set transaction snapshot isolation" "begin" "select count(*), sum(j) from f" >&9
for _ in $(seq 1 100); do grep -q "^$N	$SUM$" "$out" && break; sleep 0.1; done
grep -q "^$N	$SUM$" "$out" || { cat "$out"; fail "snapshot on $m did not start"; }
downgrade_master
on $m "put tunable 'debug_sc_commit_map_checkpoint_hold' 0" >/dev/null 2>&1
wait_committed f
printf '%s\n' "select count(*), sum(j) from f" "commit" >&9
exec 9>&-
wait $snap_pid
cat "$out"
# the only allowed outcome: the first read saw the whole table, the read after
# publication failed as schema changed (not a partial table, not some other error)
[[ $(grep -c "^$N	$SUM$" "$out") == 1 ]] || fail "the old snapshot's first read did not return the table"
grep -E "^[0-9]+	" "$out" | grep -v "^$N	$SUM$" && fail "snapshot on the old master read a partial table"
grep -q "table \"f\" was schema changed" "$out" || fail "the old snapshot's read after publication did not fail as schema changed"
[[ $(grep -c "^\[select .*\] failed with rc" "$out") == 1 ]] || fail "the old snapshot: expected exactly one failed read"
# and the old master itself is fine: it answers, and a fresh snapshot reads the table
[[ "$(on $m "select 1")" == "1" ]] || fail "$m does not answer"
echo "old master $m, new master $(master)"
# after the old snapshot: fresh snapshots on that node running the same query
# first, then a schema change there, leave an sql engine with an unfinalized
# statement (happens without sc_commit_map_skip too)
check_nodes f

echo "=== a master swing during conversion: the next master resumes, every node reads the result"
fill s
m=$(master)
on $m "exec procedure sys.cmd.send('bdb setattr SC_FORCE_DELAY 1')" >/dev/null
on $m "rebuild s" >/dev/null 2>&1 &
rb_pid=$!
for _ in $(seq 1 100); do
	converted=$(on $m "select coalesce(max(converted), 0) from comdb2_sc_status where name='s'")
	(( converted > 0 )) && break
	sleep 0.1
done
(( converted > 0 )) || fail "rebuild of s never started"
downgrade_master
on $m "exec procedure sys.cmd.send('bdb setattr SC_FORCE_DELAY 0')" >/dev/null
wait $rb_pid
wait_committed s
check_nodes s

for tbl in u t g d b f s; do
	do_verify $tbl
done
echo "Passed test"
