update_delete_limit
dtastripe 1
ssl_client_mode OPTIONAL

# Disable parallel rep: reload-analyze isn't a serialization point
REP_WORKERS 0
REP_PROCESSORS 0
early 0

# These are imported sqlite tests: they assert query plans, row estimates and
# search counts on the assumption that CREATE INDEX leaves an index with no
# statistics.  Collecting statistics during the schema change invalidates that
# assumption (486 of the 493 diffs are purely plan/estimate changes), so keep
# the old behavior here and let sc_analyze.test cover the feature.
analyze_new_indexes off
