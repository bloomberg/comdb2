#!/usr/bin/env bash
bash -n "$0" || exit 1

# The physrep metadb stored procedures, run against this db as the metadb: verify errors are retried, other
# failures are returned, a node is never offered or linked to its own subtree, and a cycle cannot hang registration.

db=$1
set -e

master=$(cdb2sql --tabs ${CDB2_OPTIONS} $db default "select host from comdb2_cluster where is_master='Y'")

function sql
{
    cdb2sql --tabs ${CDB2_OPTIONS} $db default "$@"
}

function fail
{
    echo "FAILED: $*"
    exit 1
}

function create_tables
{
    local firstfile=$1
    sql "drop table if exists comdb2_physrep_connections"
    sql "drop table if exists comdb2_physreps"
    if [[ $firstfile == 1 ]]; then
        sql "create table comdb2_physreps(dbname cstring(60), host cstring(120), file int, offset int, firstfile int, last_keepalive datetime, state cstring(60), unique (dbname, host))"
    else
        sql "create table comdb2_physreps(dbname cstring(60), host cstring(120), file int, offset int, last_keepalive datetime, state cstring(60), unique (dbname, host))"
    fi
    sql "create table comdb2_physrep_connections(dbname cstring(60), host cstring(120), source_dbname cstring(60), source_host cstring(120), unique (dbname, host, source_dbname, source_host), foreign key(dbname, host) references comdb2_physreps(dbname, host) on delete cascade)"
}

# add_node <firstfile> <dbname> <host>
function add_node
{
    if [[ $1 == 1 ]]; then
        sql "insert into comdb2_physreps(dbname, host, file, offset, firstfile, last_keepalive, state) values ('$2', '$3', 100, 0, 1, now(), 'Active')"
    else
        sql "insert into comdb2_physreps(dbname, host, file, offset, last_keepalive, state) values ('$2', '$3', 100, 0, now(), 'Active')"
    fi
}

# link <dbname> <host> <source_dbname> <source_host>
function link
{
    sql "insert into comdb2_physrep_connections values ('$1', '$2', '$3', '$4')"
}

function connections
{
    sql "select dbname || '@' || host || '<-' || source_dbname || '@' || source_host from comdb2_physrep_connections order by 1" | tr '\n' ' '
}

# src@s1 <- mid@m1 <- leaf@l1: mid replicates from src, and leaf from mid
function build_chain
{
    local firstfile=$1
    create_tables $firstfile
    add_node $firstfile src s1
    add_node $firstfile src s2
    add_node $firstfile mid m1
    add_node $firstfile leaf l1
    link mid m1 src s1
    link leaf l1 mid m1
}

echo "== reset_nodes retries a verify error"
build_chain 0
# Every other record insert on the master fails verify; m2 has no physreps row, so its upsert is one
cdb2sql ${CDB2_OPTIONS} --host $master $db "exec procedure sys.cmd.send('on alternate_verify_fail')"
rc=0
sql "exec procedure sys.physrep.reset_nodes('mid', \"'m1' 'm2'\", 'Inactive')" || rc=$?
cdb2sql ${CDB2_OPTIONS} --host $master $db "exec procedure sys.cmd.send('off alternate_verify_fail')"
[[ $rc == 0 ]] || fail "reset_nodes returned $rc"
[[ $(sql "select count(*) from comdb2_physrep_connections where dbname = 'mid'") == 0 ]] ||
    fail "reset_nodes left mid's connection: $(connections)"
[[ $(sql "select count(*) from comdb2_physreps where dbname = 'mid' and state = 'Inactive'") == 2 ]] ||
    fail "reset_nodes did not mark m1 and m2 Inactive"

echo "== update_registry returns a failure that is not a verify error"
build_chain 0
# m9 has no physreps row, so linking it violates the foreign key
if out=$(sql "exec procedure sys.physrep.update_registry('mid', 'm9', 'src', 's2', \"'m1'\")" 2>&1); then
    fail "update_registry succeeded despite a foreign key violation: $out"
fi
echo "$out"
[[ $out == *"rc -201"* ]] || fail "expected rc -201: $out"
[[ $(connections) == "leaf@l1<-mid@m1 mid@m1<-src@s1 " ]] || fail "failed update_registry changed connections: $(connections)"

for firstfile in 0 1; do
    echo "== register_replicant never offers the requester or its subtree (firstfile $firstfile)"
    build_chain $firstfile
    out=$(sql "exec procedure sys.physrep.register_replicant('mid', 'm1', '100:0', 'src', \"'s1', 's2'\")")
    echo "$out"
    echo "$out" | grep -qw s1 || fail "register_replicant did not offer src@s1: $out"
    if echo "$out" | grep -qwE 'm1|l1'; then
        fail "register_replicant offered mid@m1 itself or its child leaf@l1: $out"
    fi
done

echo "== update_registry refuses to link a node to itself or its own descendant"
build_chain 0
for src in "leaf', 'l1" "mid', 'm1"; do
    if out=$(sql "exec procedure sys.physrep.update_registry('mid', 'm1', '$src', \"'m1'\")" 2>&1); then
        fail "update_registry linked mid@m1 to '$src': $out"
    fi
    echo "$out"
    [[ $out == *"rc -202"* ]] || fail "expected rc -202: $out"
    [[ $(connections) == "leaf@l1<-mid@m1 mid@m1<-src@s1 " ]] || fail "refused update_registry changed connections: $(connections)"
done
sql "exec procedure sys.physrep.update_registry('mid', 'm1', 'src', 's2', \"'m1'\")"
[[ $(connections) == "leaf@l1<-mid@m1 mid@m1<-src@s2 " ]] || fail "update_registry did not move mid@m1 to src@s2: $(connections)"

echo "== update_registry refuses to link a node below its grandchild"
build_chain 0
add_node 0 leaf2 x1
link leaf2 x1 leaf l1
if out=$(sql "exec procedure sys.physrep.update_registry('mid', 'm1', 'leaf2', 'x1', \"'m1'\")" 2>&1); then
    fail "update_registry linked mid@m1 to its grandchild leaf2@x1: $out"
fi
echo "$out"
[[ $out == *"rc -202"* ]] || fail "expected rc -202: $out"
[[ $(connections) == "leaf2@x1<-leaf@l1 leaf@l1<-mid@m1 mid@m1<-src@s1 " ]] || fail "refused update_registry changed connections: $(connections)"

echo "== update_registry links a sibling to the same source"
build_chain 0
add_node 0 leaf l2
sql "exec procedure sys.physrep.update_registry('leaf', 'l2', 'mid', 'm1', \"'l2'\")"
[[ $(connections) == "leaf@l1<-mid@m1 leaf@l2<-mid@m1 mid@m1<-src@s1 " ]] || fail "update_registry did not link leaf@l2 to mid@m1: $(connections)"

for firstfile in 0 1; do
    echo "== register_replicant returns despite a cycle it is not part of (firstfile $firstfile)"
    build_chain $firstfile
    add_node $firstfile leaf l2
    # mid@m1 <-> leaf@l1 is a cycle; leaf@l2 registering from mid@m1 walks it without passing through itself
    link mid m1 leaf l1
    rc=0
    out=$(timeout 60 cdb2sql --tabs ${CDB2_OPTIONS} $db default "exec procedure sys.physrep.register_replicant('leaf', 'l2', '100:0', 'mid', \"'m1'\")" 2>&1) || rc=$?
    [[ $rc != 124 ]] || fail "register_replicant did not return with a cycle in the topology"
    [[ $rc == 0 ]] || fail "register_replicant failed rc $rc: $out"
    echo "$out" | grep -qw m1 || fail "register_replicant did not offer mid@m1: $out"
done

echo "== update_registry returns despite a cycle above the source"
build_chain 0
add_node 0 a a1
add_node 0 b b1
# a@a1 <-> b@b1 is a cycle the caller is not part of; the walk up from a@a1 stops at the depth cap
link a a1 b b1
link b b1 a a1
rc=0
out=$(timeout 60 cdb2sql --tabs ${CDB2_OPTIONS} $db default "exec procedure sys.physrep.update_registry('leaf', 'l1', 'a', 'a1', \"'l1'\")" 2>&1) || rc=$?
[[ $rc != 124 ]] || fail "update_registry did not return with a cycle above the source"
[[ $rc == 0 ]] || fail "update_registry failed rc $rc: $out"
[[ $(connections) == "a@a1<-b@b1 b@b1<-a@a1 leaf@l1<-a@a1 mid@m1<-src@s1 " ]] || fail "update_registry did not move leaf@l1 to a@a1: $(connections)"

echo "== update_registry finds the caller at the depth cap"
create_tables 0
add_node 0 c h0
# c@h(i) replicates from c@h(i-1); c@h0 is 32 steps up from c@h32, the deepest the walk goes
for i in $(seq 1 32); do
    add_node 0 c h$i
    link c h$i c h$((i - 1))
done
if out=$(sql "exec procedure sys.physrep.update_registry('c', 'h0', 'c', 'h32', \"'h0'\")" 2>&1); then
    fail "update_registry linked c@h0 to its descendant 32 levels down: $out"
fi
[[ $out == *"rc -202"* ]] || fail "expected rc -202: $out"

echo "Testcase passed."
exit 0
