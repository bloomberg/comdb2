#!/usr/bin/env bash
bash -n "$0" || exit 1

# A log truncate that undoes a queue add or drop must leave every node's
# in-memory queue list (comdb2_queues) matching llmeta.  Before the fix, an
# undone add aborted the node when it reopened the missing queue file, and an
# undone drop made the next drop panic with "replicant can't find queue".
# A truncate that undoes an add also runs with a Lua consumer on every node, so the
# reload must not free the queue under a consumer that still holds it.
# offline.testopts runs it all with online_recovery off.

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh

nodes=${CLUSTER:-$(hostname)}

function failexit
{
    echo "Failed: $1"
    exit 1
}

function sql_master
{
    $CDB2SQL_EXE ${CDB2_OPTIONS} -tabs $DBNAME --host $master "$1"
}

function current_lsn
{
    sql_master "exec procedure sys.cmd.send('flush')" >/dev/null
    sql_master "select lsn from comdb2_transaction_logs(NULL, NULL, 4) limit 1"
}

function truncate_to
{
    echo "Truncating to $1"
    sql_master "exec procedure sys.cmd.truncate_log(\"$1\")" || failexit "truncate_log $1"
    # Wait for every node to come back up
    for node in $nodes; do
        tries=0
        until $CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME --host $node "select 1" >/dev/null 2>&1; do
            let tries=tries+1
            [[ $tries -ge 60 ]] && failexit "$node not up after truncate"
            sleep 1
        done
    done
}

# Every node's in-memory queue list must have exactly $1 rows for __qaud.
# Replicants truncate after the master returns, so allow them time to catch up.
function check_queue
{
    for node in $nodes; do
        tries=0
        while :; do
            out=$($CDB2SQL_EXE ${CDB2_OPTIONS} -tabs $DBNAME --host $node "select count(*) from comdb2_queues where queuename = '__qaud'")
            [[ "$out" == "$1" ]] && break
            let tries=tries+1
            [[ $tries -ge 30 ]] && failexit "$2: $node has '$out' __qaud queues, expected $1"
            sleep 1
        done
    done
}

function create_consumer
{
    sql_master "create lua consumer aud on (table t1 for insert)" || failexit "create consumer"
}

function drop_consumer
{
    sql_master "drop lua consumer aud" || failexit "drop consumer"
}

master=$(getmaster)
[[ -z "$master" ]] && failexit "no master"

sql_master "create table t1(a int)" || failexit "create t1"
sql_master "create procedure aud version 'v1' {
local function main()
    local c = db:consumer()
    while true do
        c:get()
        c:consume()
    end
end}" || failexit "create procedure"

# Start a consumer on every node; the truncate must kick them out, not crash anyone
function start_consumers
{
    consumer_pids=""
    for node in $nodes; do
        $CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME --host $node "exec procedure aud()" >/dev/null 2>&1 &
        consumer_pids="$consumer_pids $!"
    done
    for i in $(seq 1 10); do
        sql_master "insert into t1 values($i)" >/dev/null || failexit "insert"
    done
    sleep 2
}

function wait_consumers
{
    for pid in $consumer_pids; do
        for i in $(seq 1 30); do
            kill -0 $pid 2>/dev/null || break
            sleep 1
        done
        kill -0 $pid 2>/dev/null && echo "consumer $pid outlived the truncate" && kill $pid
        wait $pid 2>/dev/null
    done
}

for iter in 1 2 3; do
    # Undo a drop: every node must get the queue back, and a second drop must not panic anyone
    create_consumer
    lsn=$(current_lsn)
    drop_consumer
    check_queue 0 "after drop"
    truncate_to $lsn
    check_queue 1 "iteration $iter: after truncating away the drop"
    drop_consumer
    check_queue 0 "iteration $iter: after second drop"

    # Undo an add: every node must lose the queue, and adding it again must work everywhere
    lsn=$(current_lsn)
    create_consumer
    check_queue 1 "after add"
    start_consumers
    truncate_to $lsn
    check_queue 0 "iteration $iter: after truncating away the add"
    wait_consumers
    create_consumer
    check_queue 1 "iteration $iter: after second add"
    drop_consumer
done

echo "Success"
