#!/usr/bin/env bash
bash -n "$0" || exit 1

# Commands sent from SQL (sys.cmd.send) run inside a SQL thread that already
# holds the bdb lock.  Their thread start/done calls must not trip the
# "exiting thread holding lock" check and abort the server: partition purge
# (whether or not the partition exists) and checkcsc2.  The command runs on the
# node that receives it, and only the master would drop a shard, so send it
# there.

source ${TESTSROOTDIR}/tools/runit_common.sh

DBNAME=$1
master=$($CDB2SQL_EXE --tabs ${CDB2_OPTIONS} $DBNAME default "select host from comdb2_cluster where is_master='Y'")

send_cmd() {
    $CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME --host $master \
        "exec procedure sys.cmd.send('$1')"
    if ! $CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME --host $master "select 1" >/dev/null; then
        echo "Failed: master $master died after '$1'"
        exit 1
    fi
}

send_cmd "partitions purge no_such_view"

$CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME default "create table t (a int)" || exit 1
$CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME default \
    "create time partition on t as tv period 'daily' retention 2 start '2030-01-01T00:00:00 UTC'" || exit 1
send_cmd "partitions purge tv"

# tv has no shards beyond retention, so the purge must leave its only shard
if ! $CDB2SQL_EXE ${CDB2_OPTIONS} $DBNAME default "select * from tv" >/dev/null; then
    echo "Failed: purge dropped a shard still in use by tv"
    exit 1
fi

send_cmd checkcsc2

echo "Success"
