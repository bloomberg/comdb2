#!/usr/bin/env bash
bash -n "$0" | exit 1
set -x

# Distributed schema changes (CREATE/DROP/ALTER TABLE) on a generic-shard
# partition as 2pc distributed transactions (enable_2pc + enable_2pc_ddl).
#
# Every shard is a 2pc participant and the db running the ddl is the
# coordinator.  A participant prepares its schema change's finalize transaction
# and commits or aborts it with the coordinator's decision; the coordinator
# does not prepare its own schema change, it writes the decision row in the
# same transaction.  A participant that restarts with a prepared schema change
# asks the coordinator for the outcome before it opens llmeta; a new master
# resolves inherited prepares before it resumes schema changes.
#
# Test cases:
#  1. Basic create: create partitioned table across 4 shards, verify all shards
#  2. Basic drop: drop partitioned table, verify cleanup on all shards
#  3. Create-then-drop: full lifecycle
#  4. Verify non-key sharding still fails properly with 2pc enabled
#  5. Multiple create/drop cycles: stress test for resource leaks
#  6. Distributed ALTER TABLE — add column: propagates to all shards
#  7. Distributed ALTER TABLE — add index, then a second ALTER and a DROP
#  8. Participant master exits after preparing DROP/CREATE/ALTER; its cluster
#     restarts, resolves the prepare and does not deadlock
#  9. Coordinator decides abort (another participant fails to prepare); the
#     crashed participant rolls its change back on restart
# 10. Coordinator unreachable: the participant does not finish starting until
#     the coordinator is back
# 11. Operator override: 'disttxn_resolve <id> abort' in the lrl lets the
#     participant start without the coordinator
# 12. Master swing: the participant master exits after preparing; the new
#     master resolves the prepare
# 13. Coordinator exits before / after committing its decision
# 14. Replicants do not show a prepared schema change before it commits
################################################################################

# Validate required environment variables
echo "main db vars"
vars="TESTCASE DBNAME DBDIR TESTSROOTDIR TESTDIR CDB2_OPTIONS CDB2_CONFIG SECONDARY_DBNAME SECONDARY_DBDIR SECONDARY_CDB2_CONFIG SECONDARY_CDB2_OPTIONS TERTIARY_DBNAME TERTIARY_DBDIR TERTIARY_CDB2_CONFIG TERTIARY_CDB2_OPTIONS QUATERNARY_DBNAME QUATERNARY_DBDIR QUATERNARY_CDB2_CONFIG QUATERNARY_CDB2_OPTIONS"
for required in $vars; do
    q=${!required}
    echo "$required=$q"
    if [[ -z "$q" ]]; then
        echo "$required not set" >&2
        exit 1
    fi
done

# Build shard list
shards=""
SHARDS_LIST="$DBNAME $SECONDARY_DBNAME $TERTIARY_DBNAME $QUATERNARY_DBNAME"
numshards=4

# Configure partition discovery and cross-database resolution
# Each database needs to be able to find every other database for 2PC
cluster_line=$(head -n 1 $DBDIR/comdb2db.cfg)
echo "s1$cluster_line" >> $DBDIR/comdb2db.cfg
echo "s2$cluster_line" >> $DBDIR/comdb2db.cfg
echo "s3$cluster_line" >> $DBDIR/comdb2db.cfg
echo "partition partitiondb:$SHARDS_LIST" >> $DBDIR/comdb2db.cfg

# For 2PC, each secondary database needs to resolve the primary and other secondaries
# via their comdb2db.cfg (used by cdb2_open in dispatch_participants)
for cfgfile in $SECONDARY_DBDIR/comdb2db.cfg $TERTIARY_DBDIR/comdb2db.cfg $QUATERNARY_DBDIR/comdb2db.cfg; do
    echo "s1$cluster_line" >> $cfgfile
    echo "s2$cluster_line" >> $cfgfile
    echo "s3$cluster_line" >> $cfgfile
    # Add primary db reference
    echo "${cluster_line}" >> $cfgfile 2>/dev/null
done

# SQL command shortcuts
P_SQLT="cdb2sql --tabs ${CDB2_OPTIONS} partitiondb default"
P_SQL="cdb2sql ${CDB2_OPTIONS} partitiondb default"
S0_SQLT="cdb2sql --tabs ${CDB2_OPTIONS} ${DBNAME} default"
S0_SQL="cdb2sql ${CDB2_OPTIONS} ${DBNAME} default"
S1_SQLT="cdb2sql --tabs ${SECONDARY_CDB2_OPTIONS} ${SECONDARY_DBNAME} default"
S1_SQL="cdb2sql ${SECONDARY_CDB2_OPTIONS} ${SECONDARY_DBNAME} default"
S2_SQLT="cdb2sql --tabs ${TERTIARY_CDB2_OPTIONS} ${TERTIARY_DBNAME} default"
S2_SQL="cdb2sql ${TERTIARY_CDB2_OPTIONS} ${TERTIARY_DBNAME} default"
S3_SQLT="cdb2sql --tabs ${QUATERNARY_CDB2_OPTIONS} ${QUATERNARY_DBNAME} default"
S3_SQL="cdb2sql ${QUATERNARY_CDB2_OPTIONS} ${QUATERNARY_DBNAME} default"

CDB2SQL_EXE=${CDB2SQL_EXE:-cdb2sql}
COMDB2_EXE=${COMDB2_EXE:-comdb2}

# Coordinator tier must match machine_class in tier_local.lrl / tier_cluster.lrl
if [[ -n "$CLUSTER" ]]; then
    COORDINATOR_TIER="prod"
else
    COORDINATOR_TIER="local"
fi

OUT=log.txt
export stopfile=./stopfile.txt
export LOGDIR=$TESTDIR/logs

rm -f ${OUT} $stopfile

function fail_exit
{
    echo "Failed: $@" | tee ${DBNAME}.fail_exit
    touch $stopfile
}

function timems
{
    date +%s%3N
}

