########################################
# TEST 48: a participant's prepare record lists its comdb2_tables lock.
# Replicants apply a prepared schema change at its commit, holding the locks
# its prepare record lists; system tables on replicants rely on the
# comdb2_tables write lock to read the table list while scdone changes it.
# The participant releases the lock on its master once prepared (TEST 39),
# but the prepare record must still carry it.
########################################
function last_prepare_locks
{
    local db=$1 opts=$2 dir=$3 out
    if [[ -n "$CLUSTER" ]]; then
        local master=$(master_of $db "$opts")
        out=$(ssh -n -o StrictHostKeyChecking=no $master "$COMDB2_EXE --tool cdb2_printlog -h $dir/logs" 2>/dev/null)
    else
        out=$($COMDB2_EXE --tool cdb2_printlog -h $dir/logs 2>/dev/null)
    fi
    # the last dist_prepare record, up to the next record
    echo "$out" | awk '/^\[[0-9]+\]\[[0-9]+\]/ { inp = ($0 ~ /__txn_dist_prepare/); if (inp) blk = "" } inp { blk = blk $0 "\n" } END { printf "%s", blk }'
}

function test_prepare_record_lists_comdb2_tables
{
    echo "=== TEST: test_prepare_record_lists_comdb2_tables ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    local ddl pair db opts dir prep
    for ddl in "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" "drop table t"; do
        if ! $C_SQL "$ddl"; then
            fail_exit "test_prepare_record_lists_comdb2_tables: '$ddl' failed"
            return
        fi
        for pair in "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS|$SECONDARY_DBDIR" \
                    "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS|$QUATERNARY_DBDIR"; do
            IFS='|' read -r db opts dir <<< "$pair"
            prep=$(last_prepare_locks $db "$opts" $dir)
            echo "last prepare record of ${db} after '${ddl}':"
            echo "$prep"
            if ! echo "$prep" | grep -q "dist-txnid: ${DBNAME}-"; then
                fail_exit "test_prepare_record_lists_comdb2_tables: no prepare record from coordinator ${DBNAME} on ${db} after '$ddl'"
                return
            fi
            if ! echo "$prep" | grep -q "TABLELOCK: comdb2_tables"; then
                fail_exit "test_prepare_record_lists_comdb2_tables: ${db}'s prepare record for '$ddl' does not list the comdb2_tables lock; its replicants apply the schema change without it"
                return
            fi
        done
    done
    echo "test_prepare_record_lists_comdb2_tables PASSED"
}

########################################
# TEST 49: undoing a participant's committed schema change reloads its schema
# A participant commits its prepared schema change with a dist-commit record.
# If that commit is later undone (log truncation: a master that loses an
# election to a node without the commit), the participant must reload its
# schemas, as for any undone schema change; otherwise it keeps serving a table
# whose files and llmeta entries the undo removed.
# Leaves t on the other shards: run it last.
########################################
function participant_lsn
{
    $S1_SQLT "exec procedure sys.cmd.send('flush')" >/dev/null 2>&1
    $S1_SQLT "select lsn from comdb2_transaction_logs(NULL, NULL, 4) limit 1"
}

function test_truncate_undoes_participant_create
{
    echo "=== TEST: test_truncate_undoes_participant_create ==="
    setup_testcase
    [[ -f $stopfile ]] && return
    if [[ -n "$CLUSTER" ]]; then
        # a cluster's replicants would have to truncate too
        echo "test_truncate_undoes_participant_create SKIPPED on a cluster"
        return
    fi

    local lsn
    lsn=$(participant_lsn)
    echo "${SECONDARY_DBNAME} lsn before the create: $lsn"
    if [[ -z "$lsn" ]]; then
        fail_exit "test_truncate_undoes_participant_create: no lsn from ${SECONDARY_DBNAME}"
        return
    fi
    if ! $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"; then
        fail_exit "test_truncate_undoes_participant_create: create failed"
        return
    fi
    verify_table t
    [[ -f $stopfile ]] && return

    $S1_SQL "exec procedure sys.cmd.truncate_log(\"$lsn\")"
    sleep 2

    local tables
    tables=$($S1_SQLT "select tablename from comdb2_tables where tablename='t'" 2>&1)
    echo "${SECONDARY_DBNAME} comdb2_tables after the truncate: '$tables'"
    if [[ -n "$tables" ]]; then
        fail_exit "test_truncate_undoes_participant_create: ${SECONDARY_DBNAME} still lists t after its create was undone (schemas not reloaded)"
        return
    fi
    if $S1_SQLT "select * from t" >/dev/null 2>&1; then
        fail_exit "test_truncate_undoes_participant_create: ${SECONDARY_DBNAME} still serves t after its create was undone"
        return
    fi
    echo "test_truncate_undoes_participant_create PASSED"
}

########################################
# TEST 50: a client transaction on a prepared participant that names the
# undecided create's table waits for the decision and keeps its earlier writes.
# The statement fails to prepare ("no such table") while the create is hidden,
# then prepares again once the coordinator commits; the failed prepare must not
# have aborted the transaction meanwhile.
########################################
function test_intrans_wait_keeps_txn
{
    echo "=== TEST: test_intrans_wait_keeps_txn ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return
    $S3_SQL "drop table if exists u" >/dev/null 2>&1
    $S3_SQL "create table u(a int)" >/dev/null 2>&1

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > intrans_wait_create.out 2>&1 &
    local create_pid=$!
    sleep 2
    # only the participant's master waits for the decision; a replicant has no t until the commit
    local host=default
    [[ -n "$CLUSTER" ]] && host="--host $(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS")"
    timeout 60 $CDB2SQL_EXE $QUATERNARY_CDB2_OPTIONS $QUATERNARY_DBNAME $host > intrans_wait_txn.out 2>&1 <<EOF
begin
insert into u values(1)
insert into t values(1, 1)
commit
EOF
    local txn_rc=$?
    wait $create_pid
    local create_rc=$?
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    local nu=$($S3_SQLT "select count(*) from u" 2>&1)
    local nt=$($S3_SQLT "select count(*) from t" 2>&1)
    echo "create rc ${create_rc} ($(cat intrans_wait_create.out)); txn rc ${txn_rc} ($(cat intrans_wait_txn.out)); u rows ${nu}, t rows ${nt}"

    if (( create_rc != 0 )); then
        fail_exit "test_intrans_wait_keeps_txn: create failed: $(cat intrans_wait_create.out)"
        return
    fi
    if (( txn_rc == 0 )) && [[ "$nu" != "1" || "$nt" != "1" ]]; then
        fail_exit "test_intrans_wait_keeps_txn: ${QUATERNARY_DBNAME} reported the transaction committed but has u=${nu} t=${nt} rows"
        return
    fi
    if (( txn_rc != 0 )); then
        fail_exit "test_intrans_wait_keeps_txn: transaction failed after waiting for the decision: $(cat intrans_wait_txn.out)"
        return
    fi
    echo "test_intrans_wait_keeps_txn PASSED"
}

########################################
# TEST 51: a read that waits for a prepared participant's undecided drop stops
# when its client gives up.  The coordinator exits once every participant
# prepared, so the drop stays undecided until it comes back.  One read has
# maxquerytime 2, the other's client is killed after 3s; neither may keep its
# sql thread waiting for the decision.
########################################
function test_pending_table_wait_stops_for_client
{
    echo "=== TEST: test_pending_table_wait_stops_for_client ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    local host=default
    [[ -n "$CLUSTER" ]] && host="--host $(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS")"
    local q="$CDB2SQL_EXE --tabs $QUATERNARY_CDB2_OPTIONS $QUATERNARY_DBNAME $host"

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    sleep 2

    timeout 60 $q > pending_wait_maxquerytime.out 2>&1 <<EOT &
set maxquerytime 2
select count(*) from t
EOT
    local mqt_pid=$!
    timeout 3 $q "select count(*) from t" > pending_wait_killed.out 2>&1
    wait $mqt_pid
    local mqt_rc=$?
    sleep 4
    local waiting=$($q "select count(*) from comdb2_connections where sql = 'select count(*) from t'" 2>&1)
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    echo "while the drop was undecided: maxquerytime read rc ${mqt_rc} ($(cat pending_wait_maxquerytime.out)); sql threads still waiting: ${waiting}"
    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return

    if (( mqt_rc == 0 )) || [[ "$waiting" != "0" ]]; then
        fail_exit "test_pending_table_wait_stops_for_client: ${QUATERNARY_DBNAME} still has ${waiting} sql threads waiting for the undecided drop after their clients gave up"
        return
    fi
    echo "test_pending_table_wait_stops_for_client PASSED"
}

function run_testcase
{
    local testcase=$1 start=$SECONDS
    current_testcase=$testcase
    last_testcase=$testcase
    current_start=$start
    $testcase
    current_testcase=""
    local took=$((SECONDS - start))
    timings="$timings
    $testcase ${took}s"
    echo "TIMING: $testcase took ${took}s"
}

# the failure goes last: CI shows only the tail of this log
function fail_with_timings
{
    echo "Testcase timings:$timings"
    echo "Failed testcase(s): $(testcase_label "${1:-$last_testcase}")"
    if [[ -s ${DBNAME}.fail_exit ]]; then
        cat ${DBNAME}.fail_exit
    else
        echo "Failed: no reason recorded"
    fi
    echo "Testcase failed"
    exit -1
}

# the harness's timeout sends TERM first: still say what ran and for how long
trap 'echo "Failed: timed out in ${current_testcase:-setup} after $((SECONDS - current_start))s" >> ${DBNAME}.fail_exit; fail_with_timings "${current_testcase:-setup}"' TERM

# RC2PC_ONLY="test_a test_b": run only these testcases; each failure is
# recorded and the next one still runs
if [[ -n "$RC2PC_ONLY" ]]; then
    failed=""
    for testcase in $RC2PC_ONLY; do
        rm -f $stopfile
        run_testcase $testcase
        clear_debug_tunables
        [[ -f $stopfile ]] && failed="$failed $testcase"
    done
    if [[ -n "$failed" ]]; then
        fail_with_timings "$failed"
    fi
    echo "Success"
    exit 0
fi

