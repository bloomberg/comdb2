########################################
# Helper: set tunable on all nodes of a database
########################################
function set_tunable
{
    local dbname=$1
    local opts=$2
    local tunable=$3
    local value=$4
    if [[ -z "$CLUSTER" ]]; then
        $CDB2SQL_EXE -admin $opts $dbname default "put tunable $tunable '$value'" 2>/dev/null
        return
    fi
    for node in $CLUSTER; do
        $CDB2SQL_EXE -admin $opts $dbname --host $node "put tunable $tunable '$value'" 2>/dev/null
    done
}

########################################
# Helper: the comdb2db config a database's own cdb2api uses
########################################
function cdb2_config_of
{
    case $1 in
        $DBNAME) echo $CDB2_CONFIG ;;
        $SECONDARY_DBNAME) echo $SECONDARY_CDB2_CONFIG ;;
        $TERTIARY_DBNAME) echo $TERTIARY_CDB2_CONFIG ;;
        $QUATERNARY_DBNAME) echo $QUATERNARY_CDB2_CONFIG ;;
    esac
}

########################################
# Helper: kill every node of a database (flush first)
########################################
function kill_cluster
{
    typeset dbname=$1
    typeset options=$2

    # Flush every node before killing any of them.  Killing the replicants
    # first leaves the master running with no replicas; it then stalls instead
    # of failing, and so does every other db whose fdb lookups reach it.
    if [[ -z "$CLUSTER" ]]; then
        $CDB2SQL_EXE $options $dbname default "exec procedure sys.cmd.send('flush')" 2>/dev/null
        kill -9 $(cat ${TMPDIR}/${dbname}.pid) 2>/dev/null
        return
    fi
    for node in $CLUSTER; do
        $CDB2SQL_EXE $options $dbname --host $node "exec procedure sys.cmd.send('flush')" 2>/dev/null
    done
    for node in $CLUSTER; do
        kill -9 $(cat ${TMPDIR}/${dbname}.${node}.pid) 2>/dev/null
    done
}

########################################
# Helper: run a shell command on the lrl of every node of a database; in a
# cluster each node starts from its own copy of the lrl
########################################
function edit_lrl
{
    typeset lrl=$1
    typeset cmd=$2

    (eval "$cmd")
    for node in $CLUSTER; do
        [[ $node == $(hostname) ]] && continue
        ssh -o StrictHostKeyChecking=no $node "lrl=$lrl; $cmd" </dev/null
    done
}

########################################
# Helper: start one node of a database
########################################
function restart_node
{
    typeset dbname=$1
    typeset dbdir=$2
    typeset node=$3

    if [[ -z "$CLUSTER" ]]; then
        mv $LOGDIR/${dbname}.db $LOGDIR/${dbname}.db.$(date +%s) 2>/dev/null
        # exec, with every stream redirected, so no shell lingers holding the test's output open
        (cd $dbdir && CDB2_CONFIG=$(cdb2_config_of $dbname) exec ${COMDB2_EXE} $dbname --no-global-lrl \
            --lrl $dbdir/${dbname}.lrl --pidfile ${TMPDIR}/${dbname}.pid) </dev/null &> $LOGDIR/${dbname}.db &
        return
    fi

    REP_ENV_VARS="${dbdir}/replicant_env_vars"
    PARAMS="$dbname --no-global-lrl"
    mv --backup=numbered $LOGDIR/${dbname}.${node}.db $LOGDIR/${dbname}.${node}.db.old 2>/dev/null
    if [ $node == $(hostname) ]; then
        ${COMDB2_EXE} ${PARAMS} --lrl $dbdir/${dbname}.lrl --pidfile ${TMPDIR}/${dbname}.${node}.pid 2>&1 | gawk '{ print strftime("%H:%M:%S>"), $0; fflush(); }' >$LOGDIR/${dbname}.${node}.db 2>&1 &
    else
        CMD="source ${REP_ENV_VARS} ; ${COMDB2_EXE} ${PARAMS} --lrl $dbdir/${dbname}.lrl --pidfile ${TMPDIR}/${dbname}.pid"
        ssh -o StrictHostKeyChecking=no -tt $node ${CMD} </dev/null > >(gawk '{ print strftime("%H:%M:%S>"), $0; fflush(); }' >> $LOGDIR/${dbname}.${node}.db) 2>&1 &
        echo $! > ${TMPDIR}/${dbname}.${node}.pid
    fi
}

########################################
# Helper: start every node of a database
########################################
function restart_cluster
{
    typeset dbname=$1
    typeset dbdir=$2
    if [[ -z "$CLUSTER" ]]; then
        restart_node $dbname $dbdir
        return
    fi
    for node in $CLUSTER; do
        restart_node $dbname $dbdir $node
    done
}

########################################
# Helper: kill and restart a database cluster
########################################
function kill_restart_cluster
{
    typeset dbname=$1
    typeset options=$2
    typeset dbdir=$3
    typeset sleeptime=$4

    kill_cluster $dbname "$options"
    sleep $sleeptime
    restart_cluster $dbname $dbdir
}

########################################
# Helper: wait until all nodes of a database respond
########################################
function block_until_cluster_is_up
{
    typeset dbname=$1
    typeset options=$2
    typeset max_wait=${3:-120}
    typeset elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        typeset isup=1
        if [[ -z "$CLUSTER" ]]; then
            $CDB2SQL_EXE $options $dbname default "select 1" >/dev/null 2>&1 || isup=0
        fi
        for node in ${CLUSTER}; do
            $CDB2SQL_EXE $options $dbname --host $node "select 1" 2>/dev/null
            if [[ $? != 0 ]]; then
                isup=0
            fi
        done
        [[ "$isup" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    echo "Cluster $dbname did not come up after $max_wait seconds"
    return 1
}

########################################
# Helper: verify table exists on all shards (with retry for scdone propagation)
########################################
function verify_table
{
    tbl=$1
    local max_wait=30
    local elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        local all_ok=1
        $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        [[ "$all_ok" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done

    # Final check with error reporting
    $S0_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${DBNAME}"
        return 1
    fi
    $S1_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${SECONDARY_DBNAME}"
        return 1
    fi
    $S2_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${TERTIARY_DBNAME}"
        return 1
    fi
    $S3_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${QUATERNARY_DBNAME}"
        return 1
    fi
    return 0
}

########################################
# Helper: verify table does NOT exist on any shard (with retry for scdone propagation)
########################################
function verify_table_gone
{
    tbl=$1
    local max_wait=30
    local elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        local all_gone=1
        $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        [[ "$all_gone" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done

    # Final check with error reporting
    $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${DBNAME}"
        return 1
    fi
    $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${SECONDARY_DBNAME}"
        return 1
    fi
    $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${TERTIARY_DBNAME}"
        return 1
    fi
    $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${QUATERNARY_DBNAME}"
        return 1
    fi
    return 0
}

########################################
# Helper: verify table is absent from llmeta gen_shard
########################################
function verify_llmeta
{
    local tblname=${1:-t}
    local result entry
    result=$($S0_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on $DBNAME"
    fi
    result=$($S1_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${SECONDARY_DBNAME}"
    fi
    result=$($S2_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${TERTIARY_DBNAME}"
    fi
    result=$($S3_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${QUATERNARY_DBNAME}"
    fi
}

########################################
# Helper: clean up test table
########################################
function setup_testcase
{
    # A node lost in an earlier test would otherwise surface as an unrelated
    # fan-out error in this one
    if [[ -n "$CLUSTER" ]]; then
        for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                    "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
            IFS='|' read -r db opts <<< "$pair"
            if ! block_until_cluster_is_up $db "$opts" 60; then
                fail_exit "setup_testcase: $db is not fully up"
                return
            fi
        done
    fi

    $P_SQL "DROP TABLE IF EXISTS t" 2>/dev/null
    # Give a moment for drop to propagate
    sleep 1
}

########################################
# TEST 1: Basic 2PC create
########################################
function test_basic_create
{
    echo "=== TEST: test_basic_create ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_basic_create: could not create partitioned table"
        return
    fi

    verify_table "t"
    [[ -f $stopfile ]] && return

    echo "test_basic_create PASSED"
}

########################################
# TEST 2: Basic 2PC drop
########################################
function test_basic_drop
{
    echo "=== TEST: test_basic_drop ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    # Create first
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_basic_drop: could not create partitioned table"
        return
    fi

    verify_table "t"
    [[ -f $stopfile ]] && return

    # Now drop
    $P_SQL "drop table t"
    if (( $? != 0 )); then
        fail_exit "test_basic_drop: could not drop partitioned table"
        return
    fi

    # Verify llmeta is clean
    verify_llmeta t
    [[ -f $stopfile ]] && return

    echo "test_basic_drop PASSED"
}

########################################
# TEST 3: Create-then-drop lifecycle
########################################
function test_create_drop_lifecycle
{
    echo "=== TEST: test_create_drop_lifecycle ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    # Create
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not create"
        return
    fi
    verify_table "t"
    [[ -f $stopfile ]] && return

    # Drop
    $P_SQL "drop table t"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not drop"
        return
    fi
    verify_llmeta t
    [[ -f $stopfile ]] && return

    # Re-create to verify clean state
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not re-create after drop"
        return
    fi
    verify_table "t"
    [[ -f $stopfile ]] && return

    # Final cleanup
    $P_SQL "drop table t"

    echo "test_create_drop_lifecycle PASSED"
}

