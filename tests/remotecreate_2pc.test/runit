#!/usr/bin/env bash
bash -n "$0" | exit 1
set -x

# Distributed schema changes (CREATE/DROP TABLE) on a generic-shard
# partition as 2pc distributed transactions (enable_2pc + enable_2pc_ddl).
#
# Every shard is a 2pc participant and the db running the ddl is the
# coordinator.  A participant prepares its schema change's finalize transaction
# and commits or aborts it with the coordinator's decision; the coordinator
# does not prepare its own schema change, it writes the decision row in the
# same transaction.
#
# Test cases:
#  1. Basic create: create partitioned table across 4 shards, verify all shards
#  2. Basic drop: drop partitioned table, verify cleanup on all shards
#  3. Create-then-drop: full lifecycle
#  4. Verify non-key sharding still fails properly with 2pc enabled
#  5. Multiple create/drop cycles: stress test for resource leaks
#  6. Coordinator decides abort (a participant fails to prepare): no shard
#     applies the change
#  7. Replicants do not show a prepared schema change before it commits
#  8. A participant that takes too long makes the coordinator abort on
#     disttxn_ddl_timeout_ms
#  9. Two schema changes whose coordinators are each other's participants
#     cannot wait for each other's schema locks forever
# 10. A participant that loses its master before it prepares resumes its
#     schema change from its 2pc sc_list and aborts it
# 11. A coordinator that loses its master before it commits resumes its
#     schema change from its 2pc sc_list, aborts it, and its participants abort
################################################################################

# Validate required environment variables
echo "main db vars"
vars="TESTCASE DBNAME DBDIR TESTSROOTDIR TESTDIR CDB2_OPTIONS CDB2_CONFIG SECONDARY_DBNAME SECONDARY_DBDIR SECONDARY_CDB2_CONFIG SECONDARY_CDB2_OPTIONS TERTIARY_DBNAME TERTIARY_DBDIR TERTIARY_CDB2_CONFIG TERTIARY_CDB2_OPTIONS QUATERNARY_DBNAME QUATERNARY_DBDIR QUATERNARY_CDB2_CONFIG QUATERNARY_CDB2_OPTIONS"
for required in $vars; do
    q=${!required}
    echo "$required=$q"
    if [[ -z "$q" ]]; then
        echo "$required not set" >&2
        exit 1
    fi
done

# Build shard list
shards=""
SHARDS_LIST="$DBNAME $SECONDARY_DBNAME $TERTIARY_DBNAME $QUATERNARY_DBNAME"
numshards=4

# Configure partition discovery and cross-database resolution
# Each database needs to be able to find every other database for 2PC
cluster_line=$(head -n 1 $DBDIR/comdb2db.cfg)
echo "s1$cluster_line" >> $DBDIR/comdb2db.cfg
echo "s2$cluster_line" >> $DBDIR/comdb2db.cfg
echo "s3$cluster_line" >> $DBDIR/comdb2db.cfg
echo "partition partitiondb:$SHARDS_LIST" >> $DBDIR/comdb2db.cfg

# For 2PC, each secondary database needs to resolve the primary and other secondaries
# via their comdb2db.cfg (used by cdb2_open in dispatch_participants)
for cfgfile in $SECONDARY_DBDIR/comdb2db.cfg $TERTIARY_DBDIR/comdb2db.cfg $QUATERNARY_DBDIR/comdb2db.cfg; do
    echo "s1$cluster_line" >> $cfgfile
    echo "s2$cluster_line" >> $cfgfile
    echo "s3$cluster_line" >> $cfgfile
    # Add primary db reference
    echo "${cluster_line}" >> $cfgfile 2>/dev/null
done

# SQL command shortcuts
P_SQLT="cdb2sql --tabs ${CDB2_OPTIONS} partitiondb default"
P_SQL="cdb2sql ${CDB2_OPTIONS} partitiondb default"
S0_SQLT="cdb2sql --tabs ${CDB2_OPTIONS} ${DBNAME} default"
S0_SQL="cdb2sql ${CDB2_OPTIONS} ${DBNAME} default"
S1_SQLT="cdb2sql --tabs ${SECONDARY_CDB2_OPTIONS} ${SECONDARY_DBNAME} default"
S1_SQL="cdb2sql ${SECONDARY_CDB2_OPTIONS} ${SECONDARY_DBNAME} default"
S2_SQLT="cdb2sql --tabs ${TERTIARY_CDB2_OPTIONS} ${TERTIARY_DBNAME} default"
S2_SQL="cdb2sql ${TERTIARY_CDB2_OPTIONS} ${TERTIARY_DBNAME} default"
S3_SQLT="cdb2sql --tabs ${QUATERNARY_CDB2_OPTIONS} ${QUATERNARY_DBNAME} default"
S3_SQL="cdb2sql ${QUATERNARY_CDB2_OPTIONS} ${QUATERNARY_DBNAME} default"

CDB2SQL_EXE=${CDB2SQL_EXE:-cdb2sql}
COMDB2_EXE=${COMDB2_EXE:-comdb2}

# Coordinator tier must match machine_class in tier_local.lrl / tier_cluster.lrl
if [[ -n "$CLUSTER" ]]; then
    COORDINATOR_TIER="prod"
else
    COORDINATOR_TIER="local"
fi

OUT=log.txt
export stopfile=./stopfile.txt
export LOGDIR=$TESTDIR/logs

rm -f ${OUT} $stopfile

function fail_exit
{
    echo "Failed: $@" | tee ${DBNAME}.fail_exit
    touch $stopfile
}

########################################
# Helper: find the tertiary master
########################################
function find_tertiary_master
{
    $CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME default 'select host from comdb2_cluster where is_master="Y"'
}

########################################
# Helper: set tunable on all nodes of a database
########################################
function set_tunable
{
    local dbname=$1
    local opts=$2
    local tunable=$3
    local value=$4
    if [[ -z "$CLUSTER" ]]; then
        $CDB2SQL_EXE -admin $opts $dbname default "put tunable $tunable '$value'" 2>/dev/null
        return
    fi
    for node in $CLUSTER; do
        $CDB2SQL_EXE -admin $opts $dbname --host $node "put tunable $tunable '$value'" 2>/dev/null
    done
}

########################################
# Helper: wait until all nodes of a database respond
########################################
function block_until_cluster_is_up
{
    typeset dbname=$1
    typeset options=$2
    typeset max_wait=${3:-120}
    typeset elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        typeset isup=1
        if [[ -z "$CLUSTER" ]]; then
            $CDB2SQL_EXE $options $dbname default "select 1" >/dev/null 2>&1 || isup=0
        fi
        for node in ${CLUSTER}; do
            $CDB2SQL_EXE $options $dbname --host $node "select 1" 2>/dev/null
            if [[ $? != 0 ]]; then
                isup=0
            fi
        done
        [[ "$isup" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    echo "Cluster $dbname did not come up after $max_wait seconds"
    return 1
}

########################################
# Helper: verify table exists on all shards (with retry for scdone propagation)
########################################
function verify_table
{
    tbl=$1
    local max_wait=30
    local elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        local all_ok=1
        $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null || all_ok=0
        [[ "$all_ok" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done

    # Final check with error reporting
    $S0_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${DBNAME}"
        return 1
    fi
    $S1_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${SECONDARY_DBNAME}"
        return 1
    fi
    $S2_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${TERTIARY_DBNAME}"
        return 1
    fi
    $S3_SQLT "SELECT * from ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table: could not select from ${tbl} on ${QUATERNARY_DBNAME}"
        return 1
    fi
    return 0
}

########################################
# Helper: verify table does NOT exist on any shard (with retry for scdone propagation)
########################################
function verify_table_gone
{
    tbl=$1
    local max_wait=30
    local elapsed=0

    while [[ "$elapsed" -lt "$max_wait" ]]; do
        local all_gone=1
        $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null && all_gone=0
        [[ "$all_gone" == 1 ]] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done

    # Final check with error reporting
    $S0_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${DBNAME}"
        return 1
    fi
    $S1_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${SECONDARY_DBNAME}"
        return 1
    fi
    $S2_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${TERTIARY_DBNAME}"
        return 1
    fi
    $S3_SQLT "SELECT * from ${tbl}" 2>/dev/null
    if (( $? == 0 )); then
        fail_exit "verify_table_gone: table ${tbl} still exists on ${QUATERNARY_DBNAME}"
        return 1
    fi
    return 0
}

########################################
# Helper: verify table is absent from llmeta gen_shard
########################################
function verify_llmeta
{
    local tblname=${1:-t}
    local result entry
    result=$($S0_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on $DBNAME"
    fi
    result=$($S1_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${SECONDARY_DBNAME}"
    fi
    result=$($S2_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${TERTIARY_DBNAME}"
    fi
    result=$($S3_SQLT "EXEC PROCEDURE sys.cmd.send('llmeta list')" | grep "gen_shard")
    if echo "$result" | grep -q "\"${tblname}\""; then
        fail_exit "verify_llmeta: table '$tblname' still in gen_shard on ${QUATERNARY_DBNAME}"
    fi
}

########################################
# Helper: after a rolled back drop, every shard lists the table exactly once,
# rows can be written through the partition, and it can still be dropped
########################################
function verify_table_usable
{
    local tbl=$1 pair db opts n
    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        n=$($CDB2SQL_EXE --tabs $opts $db default "select count(*) from comdb2_tables where tablename like '%${tbl}'")
        if [[ "$n" != "1" ]]; then
            $CDB2SQL_EXE $opts $db default "select tablename from comdb2_tables"
            fail_exit "verify_table_usable: $db lists ${tbl} $n times"
            return 1
        fi
    done
    # partitiondb sends a statement to one shard and nothing routes it to the
    # others: write to and count every shard directly
    local i=0
    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        for _ in 1 2; do
            i=$((i + 1))
            $CDB2SQL_EXE $opts $db default "insert into ${tbl}(a, b) values($i, $i)"
            if (( $? != 0 )); then
                fail_exit "verify_table_usable: insert $i into ${tbl} on $db failed"
                return 1
            fi
        done
    done
    local waited=0 c
    while (( waited++ < 30 )); do
        n=0
        for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                    "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
            IFS='|' read -r db opts <<< "$pair"
            c=$($CDB2SQL_EXE --tabs $opts $db default "select count(*) from ${tbl}")
            n=$((n + ${c:-0}))
        done
        [[ "$n" == "8" ]] && break
        sleep 1
    done
    if [[ "$n" != "8" ]]; then
        # where are the rows missing: every shard, from every node
        local node hostopt
        for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                    "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
            IFS='|' read -r db opts <<< "$pair"
            echo "DIAG $db master: $($CDB2SQL_EXE --tabs $opts $db default "select host from comdb2_cluster where is_master='Y'")"
            for node in ${CLUSTER:-default}; do
                hostopt="--host $node"
                [[ "$node" == "default" ]] && hostopt="default"
                echo "DIAG $db $node: $($CDB2SQL_EXE --tabs $opts $db $hostopt "select count(*) from ${tbl}" 2>&1) rows"
            done
        done
        fail_exit "verify_table_usable: ${tbl} has $n rows, expected 8"
        return 1
    fi
    $P_SQL "drop table ${tbl}"
    if (( $? != 0 )); then
        fail_exit "verify_table_usable: could not drop ${tbl}"
        return 1
    fi
    verify_table_gone ${tbl}
}

########################################
# Helper: clean up test table
########################################
function setup_testcase
{
    # A node lost in an earlier test would otherwise surface as an unrelated
    # fan-out error in this one
    if [[ -n "$CLUSTER" ]]; then
        for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                    "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
            IFS='|' read -r db opts <<< "$pair"
            if ! block_until_cluster_is_up $db "$opts" 60; then
                fail_exit "setup_testcase: $db is not fully up"
                return
            fi
        done
    fi

    $P_SQL "DROP TABLE IF EXISTS t" 2>/dev/null
    # Give a moment for drop to propagate
    sleep 1
}

########################################
# TEST 1: Basic 2PC create
########################################
function test_basic_create
{
    echo "=== TEST: test_basic_create ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_basic_create: could not create partitioned table"
        return
    fi

    verify_table "t"
    [[ -f $stopfile ]] && return

    echo "test_basic_create PASSED"
}

########################################
# TEST 2: Basic 2PC drop
########################################
function test_basic_drop
{
    echo "=== TEST: test_basic_drop ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    # Create first
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_basic_drop: could not create partitioned table"
        return
    fi

    verify_table "t"
    [[ -f $stopfile ]] && return

    # Now drop
    $P_SQL "drop table t"
    if (( $? != 0 )); then
        fail_exit "test_basic_drop: could not drop partitioned table"
        return
    fi

    # Verify llmeta is clean
    verify_llmeta t
    [[ -f $stopfile ]] && return

    echo "test_basic_drop PASSED"
}

########################################
# TEST 3: Create-then-drop lifecycle
########################################
function test_create_drop_lifecycle
{
    echo "=== TEST: test_create_drop_lifecycle ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    # Create
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not create"
        return
    fi
    verify_table "t"
    [[ -f $stopfile ]] && return

    # Drop
    $P_SQL "drop table t"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not drop"
        return
    fi
    verify_llmeta t
    [[ -f $stopfile ]] && return

    # Re-create to verify clean state
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_create_drop_lifecycle: could not re-create after drop"
        return
    fi
    verify_table "t"
    [[ -f $stopfile ]] && return

    # Final cleanup
    $P_SQL "drop table t"

    echo "test_create_drop_lifecycle PASSED"
}

########################################
# TEST 4: Non-key sharding still fails with 2PC
########################################
function test_nonkey_sharding_fails
{
    echo "=== TEST: test_nonkey_sharding_fails ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    $P_SQL "create table t(a int, b int) partitioned by columns(a) on (${shards})"
    if (( $? == 0 )); then
        fail_exit "test_nonkey_sharding_fails: should have failed with non-key sharding column"
        return
    fi

    echo "test_nonkey_sharding_fails PASSED"
}

########################################
# TEST 5: Multiple create/drop cycles with 2PC
# Stress test: create and drop multiple times to verify
# no resource leaks or state corruption.
########################################
function test_multiple_create_drop
{
    echo "=== TEST: test_multiple_create_drop ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    for i in 1 2 3; do
        echo "Cycle $i: create"
        $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
        if (( $? != 0 )); then
            fail_exit "test_multiple_create_drop: create failed on cycle $i"
            return
        fi
        verify_table "t"
        [[ -f $stopfile ]] && return

        echo "Cycle $i: drop"
        $P_SQL "drop table t"
        if (( $? != 0 )); then
            fail_exit "test_multiple_create_drop: drop failed on cycle $i"
            return
        fi
        verify_llmeta t
        [[ -f $stopfile ]] && return
    done

    echo "test_multiple_create_drop PASSED"
}

########################################
# 2pc outcome helpers
########################################

DEFAULT_DDL_TIMEOUT_MS=120000

# Start every node of db whose process is gone (a debug tunable made it exit)
function restart_db
{
    local db=$1 dir=$2 opts=$3 node
    local params="--no-global-lrl --lrl $dir/$db.lrl"
    if [[ -z "$CLUSTER" ]]; then
        # wait for the old process to be gone, its port to be free
        local pid=$(cat ${TMPDIR}/${db}.pid 2>/dev/null)
        while [[ -n "$pid" ]] && kill -0 $pid 2>/dev/null; do sleep 1; done
        (cd $dir; $COMDB2_EXE $db $params --pidfile ${TMPDIR}/${db}.pid >> $LOGDIR/${db}.db 2>&1 &)
    else
        for node in $CLUSTER; do
            $CDB2SQL_EXE $opts $db --host $node "select 1" >/dev/null 2>&1 && continue
            echo "restarting $db on $node"
            if [[ "$node" == "$(hostname)" ]]; then
                (cd $dir; $COMDB2_EXE $db $params --pidfile ${TMPDIR}/${db}.${node}.pid \
                    >> $LOGDIR/${db}.${node}.db 2>&1 &)
            else
                # like setup: a tty, so that unsetup killing this ssh kills the db
                ssh -n -tt -o StrictHostKeyChecking=no $node "cd $dir; source $dir/replicant_env_vars; \
                    $COMDB2_EXE $db $params --pidfile ${TMPDIR}/${db}.pid" >> $LOGDIR/${db}.${node}.db 2>&1 &
                echo $! > ${TMPDIR}/${db}.${node}.pid
            fi
        done
    fi
    block_until_cluster_is_up $db "$opts" 120 || fail_exit "restart_db: $db did not come back"
    # allow-coordinator is not in the lrl
    setup_coordinators
}

# Wait until db's master logs pattern
function wait_for_log
{
    local db=$1 pattern=$2 max_wait=${3:-60} elapsed=0
    while (( elapsed < max_wait )); do
        grep -q "$pattern" $LOGDIR/${db}*.db 2>/dev/null && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    fail_exit "wait_for_log: $db did not log '$pattern' in ${max_wait}s"
    return 1
}

# Print 1 if db has table tbl, else 0
function has_table
{
    local db=$1 opts=$2 tbl=$3
    if $CDB2SQL_EXE --tabs $opts $db default "select 1 from ${tbl} limit 1" >/dev/null 2>&1; then
        echo 1
    else
        echo 0
    fi
}

# Run ddl on the coordinator db directly, so the coordinator is known
C_SQL="cdb2sql ${CDB2_OPTIONS} ${DBNAME} default"

# Turn off every fault-injection tunable on every node of every shard
function clear_debug_tunables
{
    local pair db opts t
    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        for t in debug_fail_ddl_prepare debug_sleep_coordinator_before_commit \
                 debug_exit_participant_before_ddl_prepare debug_exit_participant_after_prepare \
                 debug_exit_coordinator_before_commit \
                 debug_sleep_ddl_before_lock_ms; do
            set_tunable $db "$opts" $t 0
        done
        set_tunable $db "$opts" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    done
}

function verify_ddl_outcome
{
    local kind=$1 applied=$2
    case $kind in
        create) if (( applied )); then verify_table t; else verify_table_gone t; fi ;;
        drop) if (( applied )); then verify_table_gone t; else verify_table t; fi ;;
    esac
}

function setup_outcome_ddl
{
    setup_testcase
    [[ -f $stopfile ]] && return
    if [[ "$1" != "create" ]]; then
        $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
        if (( $? != 0 )); then
            fail_exit "setup_outcome_ddl: could not create t"
            return
        fi
        verify_table t
    fi
}

########################################
# TEST 6: Coordinator decides abort
# The quaternary fails to prepare, so the coordinator aborts and every shard
# that prepared must roll its drop back.
########################################
function test_coordinator_decides_abort
{
    echo "=== TEST: test_coordinator_decides_abort ==="

    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_fail_ddl_prepare 1

    $C_SQL "drop table t" 2>&1
    local rc=$?
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_fail_ddl_prepare 0
    if (( rc == 0 )); then
        fail_exit "test_coordinator_decides_abort: drop should have failed"
        return
    fi

    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return

    # The rolled back drop must leave a table that is listed once and works
    verify_table_usable t
    [[ -f $stopfile ]] && return

    echo "test_coordinator_decides_abort PASSED"
}

########################################
# TEST 7: Replicants do not show a prepared schema change
# The coordinator sleeps after every participant has prepared and before it
# commits.  In that window a participant replicant must still show the table;
# once the drop commits it must not.
########################################
function test_replicant_hides_prepare
{
    echo "=== TEST: test_replicant_hides_prepare ==="
    # needs a replicant
    [[ -z "$CLUSTER" ]] && { echo "SKIP: requires cluster"; return; }

    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    local master=$(find_tertiary_master) replicant node
    for node in $CLUSTER; do
        [[ "$node" != "$master" ]] && { replicant=$node; break; }
    done
    [[ -z "$replicant" ]] && { echo "SKIP: no tertiary replicant"; return; }

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1

    $C_SQL "drop table t" &
    local drop_pid=$!
    sleep 3

    local R_SQL="$CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME --host $replicant"
    local before=0
    $R_SQL "select 1 from t limit 1" >/dev/null 2>&1 && before=1
    wait $drop_pid
    local rc=$?
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0

    if (( ! before )); then
        fail_exit "test_replicant_hides_prepare: replicant $replicant lost table t before commit"
        return
    fi
    if (( rc != 0 )); then
        fail_exit "test_replicant_hides_prepare: drop failed rc=$rc"
        return
    fi
    sleep 2
    if $R_SQL "select 1 from t limit 1" >/dev/null 2>&1; then
        fail_exit "test_replicant_hides_prepare: replicant $replicant still shows table t after commit"
        return
    fi

    echo "test_replicant_hides_prepare PASSED"
}

########################################
# TEST 8: A slow participant does not time out the schema change
# The quaternary participant sleeps before it finalizes for longer than the
# coordinator's disttxn_ddl_timeout_ms.  It keeps heartbeating and waits for
# no lock, so the timeout, which bounds only schema lock waits, does not abort
# the drop: it commits on every shard.
########################################
function test_ddl_timeout
{
    echo "=== TEST: test_ddl_timeout ==="

    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms 3000
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_sleep_ddl_before_lock_ms 5000

    local out rc start=$(date +%s)
    out=$($C_SQL "drop table t" 2>&1)
    rc=$?
    local took=$(( $(date +%s) - start ))
    echo "$out"
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_sleep_ddl_before_lock_ms 0
    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    if (( rc != 0 )); then
        fail_exit "test_ddl_timeout: drop failed, a slow participant timed it out"
        return
    fi
    if (( took < 5 )); then
        fail_exit "test_ddl_timeout: drop took ${took}s, it did not wait for the slow participant"
        return
    fi
    if grep -q "distributed schema change .*timed out after 3000 ms" $LOGDIR/${DBNAME}*.db; then
        fail_exit "test_ddl_timeout: the drop timed out"
        return
    fi

    verify_ddl_outcome drop 1
    [[ -f $stopfile ]] && return

    echo "test_ddl_timeout PASSED"
}

########################################
# TEST 9: Distributed schema lock deadlock
# The primary coordinates a drop of t1 and the secondary a drop of t2, and each
# is the other's participant.  Both drops sleep before they take the schema
# lock, participants twice as long: both coordinators read every shard's
# table version before any lock is held, then each finalizes first and holds
# its db's schema lock
# while it waits for a participant that waits for that same lock: the two
# drops wait for each other.  The timeout must break that, and each drop
# commits on both shards or on none.
########################################
function test_ddl_deadlock_timeout
{
    echo "=== TEST: test_ddl_deadlock_timeout ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    local two_shards="${DBNAME}, ${SECONDARY_DBNAME}" tbl
    $C_SQL "drop table if exists t1" >/dev/null 2>&1
    $S1_SQL "drop table if exists t2" >/dev/null 2>&1
    $C_SQL "create table t1(a int unique, b int) partitioned by columns(a) on (${two_shards})" || \
        { fail_exit "test_ddl_deadlock_timeout: could not create t1"; return; }
    $S1_SQL "create table t2(a int unique, b int) partitioned by columns(a) on (${two_shards})" || \
        { fail_exit "test_ddl_deadlock_timeout: could not create t2"; return; }

    local pair db opts
    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        set_tunable $db "$opts" disttxn_ddl_timeout_ms 8000
        set_tunable $db "$opts" debug_sleep_ddl_before_lock_ms 1500
    done

    $C_SQL "drop table t1" > drop_t1.out 2>&1 &
    local p1=$!
    $S1_SQL "drop table t2" > drop_t2.out 2>&1 &
    local p2=$!

    # Without the timeout a deadlocked pair never returns
    local elapsed=0
    while kill -0 $p1 2>/dev/null || kill -0 $p2 2>/dev/null; do
        if (( elapsed > 90 )); then
            kill $p1 $p2 2>/dev/null
            fail_exit "test_ddl_deadlock_timeout: drops did not finish in 90s"
            return
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    wait $p1; local rc1=$?
    wait $p2; local rc2=$?
    echo "drop t1 rc $rc1: $(cat drop_t1.out)"
    echo "drop t2 rc $rc2: $(cat drop_t2.out)"

    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        set_tunable $db "$opts" debug_sleep_ddl_before_lock_ms 0
    done
    # They deadlocked, so a timeout aborted at least one; once its schema
    # lock is released the other can still commit
    if (( rc1 == 0 && rc2 == 0 )); then
        fail_exit "test_ddl_deadlock_timeout: drops did not wait for each other"
        return
    fi
    if ! grep -q "distributed schema change .*timed out after 8000 ms" $LOGDIR/${DBNAME}*.db \
            $LOGDIR/${SECONDARY_DBNAME}*.db; then
        fail_exit "test_ddl_deadlock_timeout: no schema change timed out"
        return
    fi
    # aborted participants learn the outcome once they get the schema lock
    sleep 10

    # Each drop applied on both shards or on none, as it reported
    for tbl in t1 t2; do
        local rc=$rc1 on0 on1
        [[ $tbl == t2 ]] && rc=$rc2
        on0=$(has_table $DBNAME "$CDB2_OPTIONS" $tbl)
        on1=$(has_table $SECONDARY_DBNAME "$SECONDARY_CDB2_OPTIONS" $tbl)
        if [[ "$on0" != "$on1" ]]; then
            fail_exit "test_ddl_deadlock_timeout: $tbl is on ${DBNAME}: $on0, on ${SECONDARY_DBNAME}: $on1"
            return
        fi
        if (( rc == 0 && on0 == 1 )) || (( rc != 0 && on0 == 0 )); then
            fail_exit "test_ddl_deadlock_timeout: drop $tbl rc $rc but table present: $on0"
            return
        fi
    done

    $C_SQL "drop table if exists t1" >/dev/null 2>&1
    $S1_SQL "drop table if exists t2" >/dev/null 2>&1
    echo "test_ddl_deadlock_timeout PASSED"
}

########################################
# TEST 10: Participant resumes and aborts
# The quaternary exits after finalizing its part of a create, before it
# prepares, so the create fails.  Its new master resumes the schema change
# from the 2pc sc_list; it must not commit it locally, but abort it and tell
# the coordinator.
########################################
function test_participant_resume_aborts
{
    echo "=== TEST: test_participant_resume_aborts ==="

    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_exit_participant_before_ddl_prepare 1

    $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1
    local rc=$?
    # on a cluster the participant's new master can resume, finalize and vote
    # before the coordinator gives up: then every shard commits
    if (( rc == 0 )) && [[ -z "$CLUSTER" ]]; then
        fail_exit "test_participant_resume_aborts: create should have failed"
        return
    fi

    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_exit_participant_before_ddl_prepare 0

    if (( rc == 0 )); then
        wait_for_log $QUATERNARY_DBNAME "committing resumed 2pc schema change .* as participant"
        [[ -f $stopfile ]] && return
        verify_ddl_outcome create 1
        [[ -f $stopfile ]] && return
        verify_table_usable t
        [[ -f $stopfile ]] && return
        echo "test_participant_resume_aborts PASSED (resumed participant committed)"
        return
    fi

    wait_for_log $QUATERNARY_DBNAME "aborting resumed 2pc schema change .* as participant"
    [[ -f $stopfile ]] && return

    verify_ddl_outcome create 0
    [[ -f $stopfile ]] && return

    # nothing is left behind: the create works now
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_participant_resume_aborts: could not create t after the resumed abort"
        return
    fi
    verify_table t
    [[ -f $stopfile ]] && return

    echo "test_participant_resume_aborts PASSED"
}

