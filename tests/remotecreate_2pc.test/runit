########################################
# TEST 40: a stored procedure on a fresh sql thread does not write to an
# undecided create.  TEST 34 passes only because the sql thread that runs the
# procedure still has an sqlite schema built before the participant
# finalized.  Here idle sql threads exit after 1s, so the procedure runs on a
# new thread, which builds its schema from the finalized but undecided tables.
# As in TEST 34, the coordinator exits once every participant has prepared,
# so the create is aborted.  The insert must not succeed, because the abort
# would lose a row that the client was told was committed.
########################################
function test_prepared_create_not_writable_from_sp_fresh_thread
{
    echo "=== TEST: test_prepared_create_not_writable_from_sp_fresh_thread ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    $S3_SQL - >/dev/null 2>&1 <<'EOF'
create procedure ins2pcf version 'v1' {
local function main()
    local rc = db:exec("insert into t values(1, 1)")
    if rc == nil then
        return -201, db:error()
    end
    return 0
end
}$$
put default procedure ins2pcf 'v1'
EOF

    local old_linger=$($S3_SQLT "select value from comdb2_tunables where name='sqlenginepool.linger'")
    local old_mint=$($S3_SQLT "select value from comdb2_tunables where name='sqlenginepool.mint'")
