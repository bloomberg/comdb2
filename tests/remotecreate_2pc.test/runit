    $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > resume_aborts.out 2>&1 &
    local cpid=$!
    if ! wait_quaternary_log "before voting on debug tunable" 30 $slept; then
        fail_exit "test_participant_resume_aborts: ${QUATERNARY_DBNAME} did not reach its vote"
        return
    fi
    kill_db_master $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    wait $cpid
    local rc=$?
    echo "create rc $rc: $(cat resume_aborts.out)"
    if (( rc == 0 )); then
