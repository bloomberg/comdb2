    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"

    # the quaternary's drop of tb sleeps 8s before it takes the schema lock
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault sleep_before_lock:4000
    timeout 120 $S1_SQL "drop table tb" > second_ddl_drop_tb.out 2>&1 &
    local tb_pid=$!
