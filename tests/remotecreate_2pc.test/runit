########################################
# TEST 21: A resumed participant sees lock-desired while it stays master
# The quaternary exits right after it votes yes on a drop, which the
# coordinator commits.  When it comes back, its resume sees lock-desired once
# (debug_2pc_ddl $DBG_RESUME_LOCK_DESIRED) but it stays master.  It must still
# apply the committed drop through its retry, rather than leave it to the next
# master change.
########################################
function test_resumed_participant_lock_desired_once
{
    echo "=== TEST: test_resumed_participant_lock_desired_once ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    local committed=$(quaternary_log_count "resumed 2pc schema change .*: committed")
    local injected=$(quaternary_log_count "lock desired for resumed")
    local lrl=$QUATERNARY_DBDIR/$QUATERNARY_DBNAME.lrl
    # a single node resumes as it starts, before a put tunable could reach it
    [[ -z "$CLUSTER" ]] && echo "debug_2pc_ddl $DBG_RESUME_LOCK_DESIRED" >> $lrl
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $DBG_RESUME_LOCK_DESIRED
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_exit_participant_after_prepare 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    [[ -z "$CLUSTER" ]] && sed -i.bak '/^debug_2pc_ddl /d' $lrl
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_exit_participant_after_prepare 0

    if ! wait_quaternary_log "lock desired for resumed" 60 $injected; then
        fail_exit "test_resumed_participant_lock_desired_once: the resume did not see lock-desired on the debug tunable"
        return
    fi
    # once: its retry, still master, must then apply the drop
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl 0
    if ! wait_quaternary_log "resumed 2pc schema change .*: committed" 75 $committed; then
        echo "${QUATERNARY_DBNAME} has t: $(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)"
        fail_exit "test_resumed_participant_lock_desired_once: ${QUATERNARY_DBNAME} did not apply the committed drop while it stayed master"
        return
    fi
    verify_ddl_outcome drop 1
    [[ -f $stopfile ]] && return

    echo "test_resumed_participant_lock_desired_once PASSED"
}

########################################
# TEST 22: A participant that never voted does not count as a yes vote
# The quaternary is killed while it waits to vote and is restarted at once,
# while the coordinator still waits for votes.  Its resume finds its sc_list
# not voted and aborts, rather than ask the coordinator with a PREPARED, which
# the coordinator would count as a yes vote: the create fails on every shard.
########################################
function kill_db_master
{
    local db=$1 opts=$2 master
    if [[ -z "$CLUSTER" ]]; then
        kill -9 $(cat ${TMPDIR}/${db}.pid)
    else
        master=$($CDB2SQL_EXE --tabs $opts $db default "select host from comdb2_cluster where is_master='Y'")
        ssh -n -o StrictHostKeyChecking=no $master "pkill -9 -f 'comdb2 $db '"
    fi
}

function test_unprepared_participant_cannot_vote
{
    echo "=== TEST: test_unprepared_participant_cannot_vote ==="

    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    local slept=$(quaternary_log_count "before voting on debug tunable")
    local aborted=$(quaternary_log_count "resumed 2pc schema change .*: aborted")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $DBG_SLEEP_BEFORE_VOTE

    local out=$TMPDIR/unprepared_vote.out
    rm -f $out $out.rc
    ( $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > $out 2>&1
      echo $? > $out.rc ) &
    local cpid=$!

    if ! wait_quaternary_log "before voting on debug tunable" 30 $slept; then
        fail_exit "test_unprepared_participant_cannot_vote: ${QUATERNARY_DBNAME} did not reach its vote"
        return
    fi
    kill_db_master $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    local t0=$SECONDS
    # restart it while the coordinator is still waiting for its vote
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    echo "restarted ${QUATERNARY_DBNAME} in $((SECONDS - t0))s"

    wait $cpid
    local rc=$(cat $out.rc)
    cat $out
    echo "create rc $rc"

    if (( rc == 0 )); then
        fail_exit "test_unprepared_participant_cannot_vote: create committed although ${QUATERNARY_DBNAME} never voted"
        return
    fi
    if ! wait_quaternary_log "resumed 2pc schema change .*: aborted" 30 $aborted; then
        fail_exit "test_unprepared_participant_cannot_vote: ${QUATERNARY_DBNAME} did not abort its resumed create"
        return
    fi
    verify_ddl_outcome create 0
    [[ -f $stopfile ]] && return

    # nothing is left behind: the create works now
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_unprepared_participant_cannot_vote: could not create t after the resumed abort"
        return
    fi
    verify_table t
    [[ -f $stopfile ]] && return

    echo "test_unprepared_participant_cannot_vote PASSED"
}

