########################################
# TEST 35: a participant that gave up mastership while prepared does not keep
# its table names reserved once another master resolved the schema change.
# As in TEST 24, the quaternary's master is asked to downgrade while its drop
# of t is prepared and the coordinator is frozen.  The new master learns the
# commit and redoes the drop.  When the old master is master again, a local
# create of t there must not fail as reserved by a pending distributed schema
# change: nothing is pending any more.  Needs replicants.
########################################
function test_gave_up_mastership_releases_names
{
    echo "=== TEST: test_gave_up_mastership_releases_names ==="
    if [[ -z "$CLUSTER" ]]; then
        echo "test_gave_up_mastership_releases_names needs CLUSTER (run it in tests/docker)"
        return
    fi
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" > releases_names_drop.out 2>&1 &
    local drop_pid=$!
    sleep 2
    signal_db_all_nodes $DBNAME STOP

    local old=$(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS") new="" start=$SECONDS
    $CDB2SQL_EXE -admin $QUATERNARY_CDB2_OPTIONS $QUATERNARY_DBNAME --host $old \
        "exec procedure sys.cmd.send('downgrade')" >/dev/null 2>&1
    while (( SECONDS - start < 90 )); do
        new=$(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS")
        [[ -n "$new" && "$new" != "$old" ]] && break
        sleep 1
    done
    signal_db_all_nodes $DBNAME CONT
    wait $drop_pid
    echo "drop: $(cat releases_names_drop.out); ${QUATERNARY_DBNAME} master $old -> $new"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0

    # the new master's resume asks the coordinator and commits or aborts it
    local waited=0
    until cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null |
          grep -q "resumed 2pc schema change .*: committed\|resumed 2pc schema change .*: aborted"; do
        if (( waited++ >= 90 )); then
            fail_exit "test_gave_up_mastership_releases_names: ${QUATERNARY_DBNAME} never resolved the drop"
            return
        fi
        sleep 1
    done

    sleep 15

    # hand mastership back to the old master
    local cur tries=0
    while cur=$(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"); [[ "$cur" != "$old" ]]; do
        if (( tries++ >= 10 )); then
            fail_exit "test_gave_up_mastership_releases_names: could not make $old master again (master $cur)"
            return
        fi
        [[ -n "$cur" ]] && $CDB2SQL_EXE -admin $QUATERNARY_CDB2_OPTIONS $QUATERNARY_DBNAME --host $cur \
            "exec procedure sys.cmd.send('downgrade')" >/dev/null 2>&1
        sleep 5
    done
    echo "${QUATERNARY_DBNAME} master is $old again"

    # the shard's own table is the one the participant dropped and reserved
    local shard=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep "kind SC_DROPTABLE" | tail -1 |
                  sed -n 's/.*Starting schema change: table \([^ ]*\) kind.*/\1/p')
    local out
    out=$($S3_SQL "create table '${shard}'(x int)" 2>&1)
    local rc=$?
    echo "local create of ${shard} on ${QUATERNARY_DBNAME} (master $old): rc $rc: $out"
    (( rc == 0 )) && $S3_SQL "drop table '${shard}'" >/dev/null 2>&1

    # whatever the outcome, '$shard' is no longer reserved: it may exist, but
    # the create must not be refused as reserved (SC_CANT_SET_RUNNING, -99,
    # whose message does not reach the client)
    if (( rc != 0 )) && [[ "$out" == *"reserved by a pending distributed"* || "$out" == *"rc -99"* ]]; then
        fail_exit "test_gave_up_mastership_releases_names: ${QUATERNARY_DBNAME} master $old still refuses ${shard} after the 2pc drop was resolved: $out"
        return
    fi
    echo "test_gave_up_mastership_releases_names PASSED"
}

