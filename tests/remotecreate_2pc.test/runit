        fail_exit "test_resumed_participant_lock_desired_once: ${QUATERNARY_DBNAME} did not apply the committed drop while it stayed master"
        return
    fi
    verify_ddl_outcome drop 1
    [[ -f $stopfile ]] && return

    echo "test_resumed_participant_lock_desired_once PASSED"
}

########################################
# TEST 22: A participant that never voted does not count as a yes vote
# The quaternary is killed while its part of a create waits to take the schema
# lock, before it can vote, and is restarted at once, while the coordinator
# still waits for votes.  Its resume must abort the create and tell the
# coordinator, not ask it with a PREPARED, which the coordinator would count as
# a yes vote: the create must fail on every shard.
########################################
function kill_db_master
{
    local db=$1 opts=$2 master
    if [[ -z "$CLUSTER" ]]; then
        kill -9 $(cat ${TMPDIR}/${db}.pid)
    else
        master=$($CDB2SQL_EXE --tabs $opts $db default "select host from comdb2_cluster where is_master='Y'")
        ssh -n -o StrictHostKeyChecking=no $master "pkill -9 -f 'comdb2 $db '"
    fi
}

function test_unprepared_participant_cannot_vote
{
    echo "=== TEST: test_unprepared_participant_cannot_vote ==="

    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    local slept=$(quaternary_log_count "before taking the schema lock on debug tunable")
    local aborted=$(quaternary_log_count "never voted, aborting it")
    # the quaternary, a participant, sleeps twice this long before the lock
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault sleep_before_lock:3000

    local out=$TMPDIR/unprepared_vote.out
    rm -f $out $out.rc
    ( $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > $out 2>&1
      echo $? > $out.rc ) &
    local cpid=$!

    if ! wait_quaternary_log "before taking the schema lock on debug tunable" 30 $slept; then
        fail_exit "test_unprepared_participant_cannot_vote: ${QUATERNARY_DBNAME} did not reach the schema lock"
        return
    fi
    kill_db_master $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    local t0=$SECONDS
    # restart it while the coordinator is still waiting for its vote
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    echo "restarted ${QUATERNARY_DBNAME} in $((SECONDS - t0))s"

    wait $cpid
    local rc=$(cat $out.rc)
    cat $out
    echo "create rc $rc"

    if (( rc == 0 )); then
        fail_exit "test_unprepared_participant_cannot_vote: create committed although ${QUATERNARY_DBNAME} never voted"
        return
    fi
    if ! wait_quaternary_log "never voted, aborting it" 30 $aborted; then
        fail_exit "test_unprepared_participant_cannot_vote: ${QUATERNARY_DBNAME} did not abort its resumed create"
        return
    fi
    verify_ddl_outcome create 0
    [[ -f $stopfile ]] && return

    # nothing is left behind: the create works now
    $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_unprepared_participant_cannot_vote: could not create t after the resumed abort"
        return
    fi
    verify_table t
    [[ -f $stopfile ]] && return

    echo "test_unprepared_participant_cannot_vote PASSED"
}

########################################
# TEST 23: A participant that gave up keeps its table name reserved
# The quaternary gives up on its coordinator after 2s and aborts its prepared
# create, which frees the name t on that shard until it learns the outcome.
# A local create of t in that window must not leave the shard with a table
# that is not the partition's once the coordinator commits.
########################################
function test_participant_gave_up_name_reserved
{
    echo "=== TEST: test_participant_gave_up_name_reserved ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return
    $S3_SQL "drop table if exists t" >/dev/null 2>&1

    local gaveup=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "gave up on coordinator")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1

    $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > name_reserved_create.out 2>&1 &
    local create_pid=$!

    local waited=0
    while (( $(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "gave up on coordinator") <= gaveup )); do
        if (( waited++ >= 300 )); then
            fail_exit "test_participant_gave_up_name_reserved: the participant did not give up"
            return
        fi
        sleep 0.1
    done
    local local_out
    local_out=$($S3_SQL "create table t(x int)" 2>&1)
    local local_rc=$?
    wait $create_pid
    local create_rc=$?
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    echo "distributed create rc $create_rc: $(cat name_reserved_create.out)"
    echo "local create on ${QUATERNARY_DBNAME} rc $local_rc: $local_out"

    # give the participant's resume time to redo the committed create
    sleep 30
    # the shard must still answer queries, and its t must be the partition's
    local any_out shard_out
    any_out=$($S3_SQLT "select 1" 2>&1)
    local any_rc=$?
    shard_out=$($S3_SQLT "select a, b from t limit 1" 2>&1)
    local shard_rc=$?
    echo "${QUATERNARY_DBNAME}: 'select 1' rc $any_rc [$any_out]; 'select a, b from t' rc $shard_rc [$shard_out]"

    # leave the shard usable for later testcases
    $S3_SQL "drop table t" >/dev/null 2>&1

    if (( create_rc == 0 )) && (( any_rc != 0 || shard_rc != 0 )); then
        fail_exit "test_participant_gave_up_name_reserved: distributed create succeeded, then ${QUATERNARY_DBNAME} broke: select 1 rc $any_rc [$any_out], select a, b from t rc $shard_rc [$shard_out]"
        return
    fi
    echo "test_participant_gave_up_name_reserved PASSED"
}

function master_of
{
    local db=$1 opts=$2
    $CDB2SQL_EXE --tabs $opts $db default "select host from comdb2_cluster where is_master='Y'" 2>/dev/null
}

########################################
# TEST 24: A prepared participant still gives up mastership
# Every participant prepares its drop, then the coordinator is frozen
# (SIGSTOP on every node, so no other coordinator node resumes and aborts it)
# while it sleeps before committing.  Asked to downgrade meanwhile, the
# quaternary's master must hand over promptly, not hold the cluster without a
# master until disttxn_ddl_timeout_ms (60s here).  Needs replicants.
########################################
function signal_db_all_nodes
{
    local db=$1 sig=$2 node
    for node in $CLUSTER; do
        if [[ "$node" == "$(hostname)" ]]; then
            kill -$sig $(cat ${TMPDIR}/${db}.${node}.pid) 2>/dev/null
        else
            ssh -n -o StrictHostKeyChecking=no $node "kill -$sig \$(cat ${TMPDIR}/${db}.pid)" 2>/dev/null
        fi
    done
}

function test_prepared_participant_yields_mastership
{
    echo "=== TEST: test_prepared_participant_yields_mastership ==="
    if [[ -z "$CLUSTER" ]]; then
        echo "test_prepared_participant_yields_mastership needs CLUSTER (run it in tests/docker)"
        return
    fi
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 60000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" > yields_mastership_drop.out 2>&1 &
    local drop_pid=$!
    # the coordinator sleeps 5s once every participant prepared
    sleep 2
    signal_db_all_nodes $DBNAME STOP

    local old=$(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS")
    echo "${QUATERNARY_DBNAME} master before downgrade: $old"
    # time from the request: the downgrade command itself blocks until the handover
    local start=$SECONDS new=""
    $CDB2SQL_EXE -admin $QUATERNARY_CDB2_OPTIONS $QUATERNARY_DBNAME --host $old \
        "exec procedure sys.cmd.send('downgrade')" >/dev/null 2>&1 &
    local downgrade_pid=$!
    while (( SECONDS - start < 90 )); do
        new=$(master_of $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS")
        [[ -n "$new" && "$new" != "$old" ]] && break
        sleep 1
    done
    local took=$((SECONDS - start))
    wait $downgrade_pid
    local gaveup=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "gave up on coordinator")
    echo "${QUATERNARY_DBNAME} master after downgrade: $new, after ${took}s; participant gave-up lines: $gaveup"

    signal_db_all_nodes $DBNAME CONT
    wait $drop_pid
    echo "drop: $(cat yields_mastership_drop.out)"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS

    if [[ -z "$new" || "$new" == "$old" ]] || (( took > 15 )); then
        fail_exit "test_prepared_participant_yields_mastership: prepared participant ${QUATERNARY_DBNAME} took ${took}s to hand over mastership (old $old, new $new)"
        return
    fi
    echo "test_prepared_participant_yields_mastership PASSED"
}

########################################
# TEST 25: .scabort can cancel a participant whose coordinator is gone
# The coordinator exits after every participant prepared and stays down; the
# quaternary gives up on it after 2s and keeps asking it.  An operator who
# restarts the quaternary with a .scabort marker must get the 2pc sc_list
# dropped, rather than have it resumed and retried forever.
########################################
function test_scabort_cancels_participant
{
    echo "=== TEST: test_scabort_cancels_participant ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    local gaveup=$(quaternary_log_count "gave up on coordinator")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    if ! wait_quaternary_log "gave up on coordinator" 30 $gaveup; then
        fail_exit "test_scabort_cancels_participant: the participant did not give up"
        return
    fi

    local before=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "not cancelling 2pc schema change")
    local marker_dir=$TESTDIR/tmp/cdb2
    mkdir -p $marker_dir
    touch $marker_dir/${QUATERNARY_DBNAME}.scabort
    stop_db $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    sleep 5
    rm -f $marker_dir/${QUATERNARY_DBNAME}.scabort
    local after=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "not cancelling 2pc schema change")
    echo "'not cancelling 2pc schema change' before $before, after scabort restart $after"

    # the coordinator's resume aborts it: clean up for later testcases
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS

    if (( after > before )); then
        fail_exit "test_scabort_cancels_participant: .scabort on ${QUATERNARY_DBNAME} did not cancel its 2pc schema change, it resumed it again"
        return
    fi
    echo "test_scabort_cancels_participant PASSED"
}

########################################
# TEST 26: A rowlocks participant is rejected
# 2pc ddl does not support rowlocks.  With rowlocks on the quaternary, the
# create must fail on every shard.  The other shards still build the table
# before the quaternary's bplog rejects it: rejecting the statement earlier
# would need the push path to report a participant's statement error.
########################################
function test_rowlocks_participant_rejected_early
{
    echo "=== TEST: test_rowlocks_participant_rejected_early ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    $S3_SQL "put rowlocks enable" 2>&1
    local s1before=$(cat $LOGDIR/${SECONDARY_DBNAME}*.db 2>/dev/null | grep -c "Start add table transaction ok")
    local out
    out=$($C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1)
    local rc=$?
    $S3_SQL "put rowlocks disable" 2>&1
    local s1after=$(cat $LOGDIR/${SECONDARY_DBNAME}*.db 2>/dev/null | grep -c "Start add table transaction ok")
    echo "create rc $rc: $out; ${SECONDARY_DBNAME} add-table starts: $((s1after - s1before))"

    if (( rc == 0 )); then
        verify_table t
        echo "test_rowlocks_participant_rejected_early PASSED (create allowed)"
        return
    fi
    verify_table_gone t
    [[ -f $stopfile ]] && return
    echo "test_rowlocks_participant_rejected_early PASSED"
}

########################################
# TEST 27: A 2pc schema change gets the schema lock under read load
# Readers keep taking the coordinator's schema read lock; the drop must still
# get the write lock within disttxn_ddl_timeout_ms.
########################################
function test_ddl_schema_lock_under_read_load
{
    echo "=== TEST: test_ddl_schema_lock_under_read_load ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $DBNAME "$CDB2_OPTIONS"

    local pids="" i
    for i in 1 2 3 4 5 6 7 8; do
        (yes "select count(*) from unrelated" | head -200000 | \
            $CDB2SQL_EXE $CDB2_OPTIONS $DBNAME default - >/dev/null 2>&1) &
        pids="$pids $!"
    done
    sleep 2
    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms 5000
    local out
    out=$($C_SQL "drop table t" 2>&1)
    local rc=$?
    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    kill $pids 2>/dev/null
    pkill -f "select count\(\*\) from unrelated" 2>/dev/null
    wait $pids 2>/dev/null
    echo "drop under read load rc $rc: $out"

    if (( rc != 0 )); then
        fail_exit "test_ddl_schema_lock_under_read_load: drop failed under read load: $out"
        return
    fi
    verify_table_gone t
    [[ -f $stopfile ]] && return
    echo "test_ddl_schema_lock_under_read_load PASSED"
}

########################################
# TEST 28: A participant whose commit fails does not report it propagated
# The tertiary's commit of its prepared drop fails after the coordinator
# committed (debug_remote_2pc_fault fail_commit).  It must still end up dropping t (or
# the client must hear of the failure), not tell the coordinator that it
# propagated and keep t.
########################################
function test_participant_commit_failure
{
    echo "=== TEST: test_participant_commit_failure ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_remote_2pc_fault fail_commit
    local out
    out=$($C_SQL "drop table t" 2>&1)
    local rc=$?
    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_remote_2pc_fault off
    echo "drop rc $rc: $out"

    local waited=0
    while (( $(has_table $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" t) == 1 )) && (( waited++ < 30 )); do
        sleep 1
    done
    local s2=$(has_table $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" t)
    local s0=$(has_table $DBNAME "$CDB2_OPTIONS" t)
    echo "after 30s: t on ${DBNAME}=$s0 ${TERTIARY_DBNAME}=$s2"

    # leave the shards consistent for later testcases
    $S2_SQL "drop table t" >/dev/null 2>&1

    if (( rc == 0 && s2 == 1 )); then
        fail_exit "test_participant_commit_failure: drop succeeded but ${TERTIARY_DBNAME}, whose commit failed, still has t"
        return
    fi
    echo "test_participant_commit_failure PASSED"
}

########################################
# TEST 29: A successful distributed create is visible on every shard
# The coordinator is slow to decide (it sleeps 5s once every participant
# prepared, as a coordinator behind a busy schema lock or a slow finalize
# would).  The quaternary, prepared, gives up after 2s and aborts its create.
# The coordinator still commits and the client is told the create succeeded:
# the table must then exist on every shard, not appear later on some shards.
########################################
function test_success_visible_on_every_shard
{
    echo "=== TEST: test_success_visible_on_every_shard ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    local out
    out=$($C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1)
    local rc=$?
    # right after the client hears success
    local s0=$(has_table $DBNAME "$CDB2_OPTIONS" t)
    local s1=$(has_table $SECONDARY_DBNAME "$SECONDARY_CDB2_OPTIONS" t)
    local s2=$(has_table $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" t)
    local s3=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    echo "create rc $rc: $out; right after: t on ${DBNAME}=$s0 ${SECONDARY_DBNAME}=$s1 ${TERTIARY_DBNAME}=$s2 ${QUATERNARY_DBNAME}=$s3"

    # let the quaternary's redo finish, then leave the shards clean
    sleep 10
    local s3later=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
    echo "10s later: t on ${QUATERNARY_DBNAME}=$s3later"
    $C_SQL "drop table t" >/dev/null 2>&1

    if (( rc == 0 )) && (( s0 + s1 + s2 + s3 != 4 )); then
        fail_exit "test_success_visible_on_every_shard: create succeeded but t is missing on a shard (${DBNAME}=$s0 ${SECONDARY_DBNAME}=$s1 ${TERTIARY_DBNAME}=$s2 ${QUATERNARY_DBNAME}=$s3)"
        return
    fi
    echo "test_success_visible_on_every_shard PASSED"
}

