    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" sqlenginepool.linger 1

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1
    echo "create rc $?"
    # idle sql threads, schemas built before the finalize, exit meanwhile
    sleep 4

    # the client waits through the coordinator's restart, which aborts the create
    timeout 120 $S3_SQL "exec procedure ins2pcf()" > prepared_create_spf_insert.out 2>&1 &
    local ins_pid=$!
    sleep 3
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    wait $ins_pid
    local ins_rc=$?
    echo "on ${QUATERNARY_DBNAME} while the create was undecided: sp insert rc ${ins_rc} ($(cat prepared_create_spf_insert.out))"
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" sqlenginepool.linger ${old_linger:-0}
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" sqlenginepool.mint ${old_mint:-0}
    verify_ddl_outcome create 0
    $S3_SQL "drop procedure ins2pcf version 'v1'" >/dev/null 2>&1
    [[ -f $stopfile ]] && return

    if (( ins_rc == 0 )) && ! grep -qi "error\|fail\|no such" prepared_create_spf_insert.out; then
        fail_exit "test_prepared_create_not_writable_from_sp_fresh_thread: a stored procedure on ${QUATERNARY_DBNAME} committed an insert into t before the coordinator decided; the aborted create lost it"
        return
    fi
    echo "test_prepared_create_not_writable_from_sp_fresh_thread PASSED"
}

########################################
# TEST 41: a second 2pc schema change on a waiting participant does not stop
# that db.  The quaternary is a participant of two drops: tb, coordinated by
# the secondary, and ta, coordinated by the primary.  The drop of tb sleeps
# before it votes.  Meanwhile the quaternary votes on the drop of ta, whose
# coordinator exits, so ta stays undecided.  When the drop of tb wakes up it
# marks its sc_list voted and goes on.  A read of an unrelated table on the
# quaternary must not wait for ta's coordinator.
########################################
function test_second_ddl_on_prepared_participant
{
    echo "=== TEST: test_second_ddl_on_prepared_participant ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    local a_shards="${DBNAME}, ${QUATERNARY_DBNAME}" b_shards="${SECONDARY_DBNAME}, ${QUATERNARY_DBNAME}"
    $C_SQL "drop table if exists ta" >/dev/null 2>&1
    $S1_SQL "drop table if exists tb" >/dev/null 2>&1
    $C_SQL "create table ta(a int unique, b int) partitioned by columns(a) on (${a_shards})" || \
        { fail_exit "test_second_ddl_on_prepared_participant: could not create ta"; return; }
    $S1_SQL "create table tb(a int unique, b int) partitioned by columns(a) on (${b_shards})" || \
        { fail_exit "test_second_ddl_on_prepared_participant: could not create tb"; return; }
    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"

    # the quaternary's drop of tb sleeps 8s before it votes
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $DBG_SLEEP_BEFORE_VOTE
    timeout 120 $S1_SQL "drop table tb" > second_ddl_drop_tb.out 2>&1 &
    local tb_pid=$!
    sleep 2
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl 0

    # the quaternary votes on ta, then ta's coordinator exits
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "drop table ta" > second_ddl_drop_ta.out 2>&1
    echo "drop ta rc $? ($(cat second_ddl_drop_ta.out))"

    # tb wakes up and votes
    sleep 8
    local took=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 15 "select count(*) from unrelated")
    echo "read of unrelated table on ${QUATERNARY_DBNAME} with ta prepared and tb finalizing took ${took}s"

    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    wait $tb_pid
    local tb_rc=$?
    echo "drop tb rc ${tb_rc} ($(cat second_ddl_drop_tb.out))"
    sleep 5
    $C_SQL "drop table if exists ta" >/dev/null 2>&1
    $S1_SQL "drop table if exists tb" >/dev/null 2>&1

    if [[ "$took" == "timeout" ]] || (( took >= 3 )); then
        fail_exit "test_second_ddl_on_prepared_participant: a read of an unrelated table on ${QUATERNARY_DBNAME} took ${took}s while a second 2pc drop held its schema lock behind the prepared one"
        return
    fi
    echo "test_second_ddl_on_prepared_participant PASSED"
}

