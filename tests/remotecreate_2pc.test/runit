########################################
# TEST 26b: An older participant is rejected before it receives 2pc DDL
# The DDL-specific 2pc protocol must be negotiated before the participant's
# transaction begins. A participant limited to the previous protocol must
# reject the create, leaving no committed shard table.
########################################
function test_old_participant_rejected_early
{
    echo "=== TEST: test_old_participant_rejected_early ==="
