########################################
# TEST 38: a participant that recorded its yes vote but died before sending it
# The quaternary exits right after its voted mark is replicated, before it
# sends the vote (debug_2pc_ddl $DBG_EXIT_AFTER_VOTED), and is restarted at once.
# Its resume asks the coordinator with a yes vote, which is right: it can redo
# the create.  Either the coordinator counts that vote and commits, or it has
# timed the quaternary out and aborts; either way every shard agrees with the
# client.  With redo_fails set, the quaternary's redo keeps failing until the
# fault is cleared (as a shard that cannot apply the change until an operator
# fixes it would): it keeps its sc_list and applies the commit then.
########################################
function unprepared_participant_counted_as_yes
{
    local redo_fails=$1 name=test_unprepared_participant_counted_as_yes${1:+_redo_fails}
    echo "=== TEST: $name ==="

    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    local exited=$(quaternary_log_count "exiting after recording the vote")
    local lrl=$QUATERNARY_DBDIR/$QUATERNARY_DBNAME.lrl
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $DBG_EXIT_AFTER_VOTED

    local out=$TMPDIR/unprepared_yes.out
    rm -f $out $out.rc
    ( $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > $out 2>&1
      echo $? > $out.rc ) &
    local cpid=$!

    if ! wait_quaternary_log "exiting after recording the vote" 40 $exited; then
        fail_exit "$name: ${QUATERNARY_DBNAME} did not exit after recording its vote"
        return
    fi
    (( redo_fails )) && echo "debug_2pc_ddl $DBG_FAIL_FINALIZE" >> $lrl
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    # clear the exit on every node, keep the failing redo
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $(( redo_fails ? DBG_FAIL_FINALIZE : 0 ))

    wait $cpid
    local rc=$(cat $out.rc)
    cat $out
    echo "create rc $rc"
    sed -i.bak '/^debug_2pc_ddl /d' $lrl

    if (( redo_fails )); then
        sleep 20
        local s3=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
        echo "with the fault on: ${QUATERNARY_DBNAME} has t=$s3, failed finalizes $(quaternary_log_count "failing finalize of committed")"
        set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl 0
    fi
    if ! wait_shards_agree t 60; then
        fail_exit "$name: the shards disagree on t (create rc $rc)"
        return
    fi
    local applied=$(has_table $DBNAME "$CDB2_OPTIONS" t)
    if (( rc == 0 && applied == 0 )); then
        fail_exit "$name: the create reported success, but no shard has t"
        return
    fi
    verify_clean_outcome
    [[ -f $stopfile ]] && return
    echo "$name PASSED"
}

function test_unprepared_participant_counted_as_yes
{
    unprepared_participant_counted_as_yes
}

function test_unprepared_participant_counted_as_yes_redo_fails
{
    unprepared_participant_counted_as_yes 1
}

