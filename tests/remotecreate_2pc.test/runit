# Count the quaternary's log lines matching pattern
function quaternary_log_count
{
    cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "$1"
}

# Wait up to max seconds for more than base quaternary log lines matching pattern
function wait_quaternary_log
{
    local pattern=$1 max=$2 base=$3 waited=0
    while (( $(quaternary_log_count "$pattern") <= base )); do
        (( waited++ >= max )) && return 1
        sleep 1
    done
    return 0
}

# The quaternary gives up on the coordinator during a drop of t, which the
# coordinator then commits
function quaternary_gives_up_on_drop
{
    local caller=$1
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return 1
    local gaveup=$(quaternary_log_count "gave up on coordinator")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    if ! wait_quaternary_log "gave up on coordinator" 60 $gaveup; then
        fail_exit "$caller: ${QUATERNARY_DBNAME} did not give up on the coordinator"
        return 1
    fi
    return 0
}

########################################
# TEST 20: The redo of a committed drop fails once
# The quaternary gives up on the coordinator, which commits; the quaternary's
# redo then fails its finalize once (debug_remote_2pc_fault fail_redo_finalize).  Its retry
# must apply the drop, rather than crash or find the table still marked as
# running a schema change.
########################################
function test_participant_redo_finalize_fails_once
{
    echo "=== TEST: test_participant_redo_finalize_fails_once ==="
    local committed=$(quaternary_log_count "committing resumed 2pc schema change")
    local injected=$(quaternary_log_count "failing finalize of 2pc redo")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault fail_redo_finalize:1
    quaternary_gives_up_on_drop test_participant_redo_finalize_fails_once || return
    if ! wait_quaternary_log "failing finalize of 2pc redo" 60 $injected; then
        fail_exit "test_participant_redo_finalize_fails_once: the redo did not fail on the debug tunable"
        return
    fi
    if ! wait_quaternary_log "committing resumed 2pc schema change" 75 $committed; then
        cat $LOGDIR/${QUATERNARY_DBNAME}*.db | sed -n '/failing finalize of 2pc redo/,$p' |
            grep -E "sc_set_running|retrying|redo of committed" | head -20
        fail_exit "test_participant_redo_finalize_fails_once: ${QUATERNARY_DBNAME} did not apply the committed drop after one failed redo"
        return
    fi
    verify_ddl_outcome drop 1
    [[ -f $stopfile ]] && return

    echo "test_participant_redo_finalize_fails_once PASSED"
}

########################################
# TEST 21: A resumed participant sees lock-desired while it stays master
# The quaternary gives up on the coordinator, which commits; while its resume
# asks the coordinator, it sees lock-desired once
# (debug_remote_2pc_fault resumed_lock_desired) but stays master.  It must still apply the
# committed drop, rather than leave it to the next master change.
########################################
function test_resumed_participant_lock_desired_once
{
    echo "=== TEST: test_resumed_participant_lock_desired_once ==="
    local committed=$(quaternary_log_count "committing resumed 2pc schema change")
    local injected=$(quaternary_log_count "lock desired for resumed")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault resumed_lock_desired:1
    quaternary_gives_up_on_drop test_resumed_participant_lock_desired_once || return
    if ! wait_quaternary_log "lock desired for resumed" 60 $injected; then
        fail_exit "test_resumed_participant_lock_desired_once: the resume did not see lock-desired on the debug tunable"
