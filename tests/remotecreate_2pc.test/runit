# Time (whole seconds) a statement takes on db, giving up after max seconds;
# prints the elapsed seconds, or "timeout"
function timed_sql
{
    local db=$1 opts=$2 max=$3 sql=$4 start rc
    start=$(date +%s)
    timeout $max $CDB2SQL_EXE --tabs $opts $db default "$sql" >/dev/null 2>&1
    rc=$?
    if (( rc == 124 )); then
        echo timeout
    else
        echo $(( $(date +%s) - start ))
    fi
}

# A local, non-partitioned table on db that no ddl here touches
function make_unrelated_table
{
    local db=$1 opts=$2
    $CDB2SQL_EXE $opts $db default "create table if not exists unrelated(a int)" >/dev/null 2>&1
    $CDB2SQL_EXE $opts $db default "insert into unrelated values(1)" >/dev/null 2>&1
}

########################################
# REVIEW A: a prepared participant blocks every query on its db until the
# coordinator decides.  The coordinator sleeps 5s after all participants
# prepared; a read of a table the ddl does not touch, on a participant,
# should not wait for that.
########################################
function test_review_participant_reads_block_while_prepared
{
    echo "=== TEST: test_review_participant_reads_block_while_prepared ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"

    local base=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 20 "select count(*) from unrelated")
    echo "baseline read took ${base}s"

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" > review_a.out 2>&1 &
    local drop_pid=$!
    sleep 2
    local took=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 20 "select count(*) from unrelated")
    wait $drop_pid
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    echo "read of unrelated table on prepared participant took ${took}s (drop: $(cat review_a.out))"

    if [[ "$took" == "timeout" ]] || (( took >= 2 )); then
        fail_exit "REVIEW A CONFIRMED: read of an unrelated table on prepared participant ${QUATERNARY_DBNAME} took ${took}s (baseline ${base}s)"
        return
    fi
    echo "test_review_participant_reads_block_while_prepared PASSED"
}

########################################
# REVIEW B: the coordinator holds its own schema write lock while it waits for
# participants, so a slow participant (up to disttxn_ddl_timeout_ms, 120s by
# default) blocks every query on the coordinator db.
########################################
function test_review_coordinator_reads_block_on_slow_participant
{
    echo "=== TEST: test_review_coordinator_reads_block_on_slow_participant ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $DBNAME "$CDB2_OPTIONS"

    # participants sleep twice this: 8s
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_sleep_ddl_before_lock_ms 4000
    $C_SQL "drop table t" > review_b.out 2>&1 &
    local drop_pid=$!
    sleep 2
    local took=$(timed_sql $DBNAME "$CDB2_OPTIONS" 30 "select count(*) from unrelated")
    wait $drop_pid
    local rc=$?
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_sleep_ddl_before_lock_ms 0
    echo "read of unrelated table on coordinator took ${took}s (drop rc $rc: $(cat review_b.out))"

    if [[ "$took" == "timeout" ]] || (( took >= 3 )); then
        fail_exit "REVIEW B CONFIRMED: read of an unrelated table on coordinator ${DBNAME} took ${took}s while waiting for a slow participant"
        return
    fi
    echo "test_review_coordinator_reads_block_on_slow_participant PASSED"
}

########################################
# REVIEW C: a participant that prepared has no bound on its wait: if the
# coordinator is gone, the participant keeps the schema write lock forever and
# its whole db stops answering.  The coordinator exits after every participant
# prepared and is left down for 30s.
########################################
function test_review_participant_unusable_while_coordinator_down
{
    echo "=== TEST: test_review_participant_unusable_while_coordinator_down ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    make_unrelated_table $SECONDARY_DBNAME "$SECONDARY_CDB2_OPTIONS"

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    sleep 3

    local took3=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 30 "select count(*) from unrelated")
    local took1=$(timed_sql $SECONDARY_DBNAME "$SECONDARY_CDB2_OPTIONS" 5 "select count(*) from unrelated")
    echo "with coordinator down: ${QUATERNARY_DBNAME} read ${took3}, ${SECONDARY_DBNAME} read ${took1}"

    # bring the coordinator back; its resume aborts the drop and frees them
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    local after=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 60 "select count(*) from unrelated")
    echo "after coordinator restart: ${QUATERNARY_DBNAME} read ${after}"

    if [[ "$took3" == "timeout" ]]; then
        fail_exit "REVIEW C CONFIRMED: participant ${QUATERNARY_DBNAME} did not answer a read of an unrelated table for 30s while the coordinator was down (after restart: ${after})"
        return
    fi
    echo "test_review_participant_unusable_while_coordinator_down PASSED"
}

