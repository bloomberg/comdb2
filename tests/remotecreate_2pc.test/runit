########################################
# TEST 29: A successful distributed create is visible on every shard
# The coordinator is slow to decide (it sleeps 5s once every participant
# prepared, as a coordinator behind a busy schema lock or a slow finalize
# would).  The quaternary, prepared, gives up after 2s and aborts its create.
# The coordinator still commits and the client is told the create succeeded:
# the table must then exist on every shard, not appear later on some shards.
########################################
function test_success_visible_on_every_shard
{
    echo "=== TEST: test_success_visible_on_every_shard ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    local out
    out=$($C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1)
    local rc=$?
    # right after the client hears success
    local s0=$(has_table $DBNAME "$CDB2_OPTIONS" t)
    local s1=$(has_table $SECONDARY_DBNAME "$SECONDARY_CDB2_OPTIONS" t)
    local s2=$(has_table $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" t)
    local s3=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS
    echo "create rc $rc: $out; right after: t on ${DBNAME}=$s0 ${SECONDARY_DBNAME}=$s1 ${TERTIARY_DBNAME}=$s2 ${QUATERNARY_DBNAME}=$s3"

    # let the quaternary's redo finish, then leave the shards clean
    sleep 10
    local s3later=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
    echo "10s later: t on ${QUATERNARY_DBNAME}=$s3later"
    $C_SQL "drop table t" >/dev/null 2>&1

    if (( rc == 0 )) && (( s0 + s1 + s2 + s3 != 4 )); then
        fail_exit "test_success_visible_on_every_shard: create succeeded but t is missing on a shard (${DBNAME}=$s0 ${SECONDARY_DBNAME}=$s1 ${TERTIARY_DBNAME}=$s2 ${QUATERNARY_DBNAME}=$s3)"
        return
    fi
    echo "test_success_visible_on_every_shard PASSED"
}

########################################
# TEST 37: a participant whose commit is logged but whose wait for replicants
# fails (trans_commit_logical returns nonzero after the commit) still has the
# table it created, and stays up.  debug_remote_2pc_fault fail_commit_wait
# returns ERR_NOT_DURABLE from a commit that succeeded, as trans_commit_int does
# when trans_wait_for_seqnum_int fails.
########################################
function test_participant_commit_wait_fails
{
    echo "=== TEST: test_participant_commit_wait_fails ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_remote_2pc_fault fail_commit_wait
    local out
    out=$($C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1)
    local rc=$?
    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_remote_2pc_fault off
    echo "create rc $rc: $out"
    sleep 5

    local alive=$($CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME default "select 1" 2>&1)
    local s2=$(has_table $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" t)
    local ins
    ins=$($CDB2SQL_EXE $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME default "insert into t values(1, 1)" 2>&1)
    local insrc=$?
    local sel=$($CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME default "select a, b from t" 2>&1)
    local st=$($CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME default "select status from comdb2_sc_history order by start desc limit 1" 2>&1)
    echo "after: ${TERTIARY_DBNAME} alive='$alive' has t=$s2 insert rc $insrc ($ins) select '$sel' sc status '$st'"

    if [[ "$st" == "ABORTED" ]]; then
        fail_exit "test_participant_commit_wait_fails: ${TERTIARY_DBNAME} ran the abort cleanup on its committed create (sc status $st)"
        return
    fi
    if [[ "$alive" != "1" ]]; then
        fail_exit "test_participant_commit_wait_fails: ${TERTIARY_DBNAME} is down after its committed create's replicant wait failed"
        return
    fi
    if (( s2 != 1 || insrc != 0 )) || [[ "$sel" != "1	1" ]]; then
        fail_exit "test_participant_commit_wait_fails: ${TERTIARY_DBNAME} lost the table it committed (has t=$s2, insert rc $insrc, select '$sel')"
        return
    fi
    $C_SQL "drop table t" >/dev/null 2>&1
    echo "test_participant_commit_wait_fails PASSED"
}

########################################
# TEST 38: a participant that never prepared does not count as a yes vote
# The quaternary marks its 2pc sc_list may_vote, finalizes its part of a
# create, and is killed while it pauses before preparing
# (test_sc_finalize_pause_ms); sync commits made the mark durable.  The coordinator sleeps before it collects
# votes (sleep_before_lock), long enough for the quaternary to restart.  The
# restarted quaternary has no prepared transaction: it never voted yes, so the
# create must fail on every shard.  Its resume must not send the coordinator a
# PREPARED, which the coordinator counts as a yes vote, before it withdrew its
# vote (it cannot tell that it never voted: see TEST 43).  (On a cluster the
# may_vote mark replicates, so a new master hits this without the flush.)
# With redo_fails set, the quaternary's redo of the committed create keeps
# failing (fail_redo_finalize from its lrl, as a shard that cannot apply the
# schema change would): a yes vote it never cast leaves the client told the
# create succeeded while the quaternary never has t.
########################################
function unprepared_participant_counted_as_yes
{
    local redo_fails=$1 name=test_unprepared_participant_counted_as_yes${1:+_redo_fails}
    echo "=== TEST: $name ==="

    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    local paused=$(quaternary_log_count "finalized, pausing")
    local unprepared=$(quaternary_log_count "has no prepare record, withdrew its vote")
    local lrl=$QUATERNARY_DBDIR/$QUATERNARY_DBNAME.lrl
    # sync commits make its may_vote mark durable at once, as replicating it
    # does on a cluster; a flush would wait for the finalize, which prepares
    echo "setattr SYNCTRANSACTIONS 1" >> $lrl
    stop_db $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    # counted after the restart above, which recovers earlier tests' prepares
    # still in the log
    local recovered=$(quaternary_log_count "Recovering prepared txn")
    # it pauses after it marked may_vote and finalized, before it prepares
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" test_sc_finalize_pause_ms 30000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_remote_2pc_fault sleep_before_lock:45000

    local out=$TMPDIR/unprepared_yes.out
    rm -f $out $out.rc
    ( $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" > $out 2>&1
      echo $? > $out.rc ) &
    local cpid=$!

    if ! wait_quaternary_log "finalized, pausing" 40 $paused; then
        fail_exit "$name: ${QUATERNARY_DBNAME} did not pause before preparing"
        return
    fi
    sleep 2
    kill_db_master $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    (( redo_fails )) && echo "debug_remote_2pc_fault fail_redo_finalize:1000000" >> $lrl
    local t0=$SECONDS
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    echo "restarted ${QUATERNARY_DBNAME} in $((SECONDS - t0))s"

    wait $cpid
    local rc=$(cat $out.rc)
    cat $out
    echo "create rc $rc"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_remote_2pc_fault off
    # on a cluster the nodes that were not killed still have it
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" test_sc_finalize_pause_ms 0
    sed -i.bak '/SYNCTRANSACTIONS/d; /fail_redo_finalize/d' $lrl

    # the kill must have come before the prepare
    if (( $(quaternary_log_count "Recovering prepared txn") > recovered )); then
        fail_exit "$name: ${QUATERNARY_DBNAME} prepared before it was killed"
        return
    fi
    if (( redo_fails )); then
        sleep 20
        local s3=$(has_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" t)
        local failed=$(quaternary_log_count "failing finalize of 2pc redo")
        echo "after 20s: ${QUATERNARY_DBNAME} has t=$s3, failed redos $failed"
        set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault off
        if (( rc == 0 && s3 == 0 )); then
            $C_SQL "drop table t" >/dev/null 2>&1
            fail_exit "$name: the create reported success, but ${QUATERNARY_DBNAME}, which never prepared, has no t"
            return
        fi
    fi
    if (( rc == 0 )); then
        $C_SQL "drop table t" >/dev/null 2>&1
        fail_exit "$name: create committed although ${QUATERNARY_DBNAME} never prepared"
        return
    fi
    if ! wait_quaternary_log "has no prepare record, withdrew its vote" 30 $unprepared; then
        fail_exit "$name: ${QUATERNARY_DBNAME} did not withdraw the vote of its resumed, unprepared create"
        return
    fi
    verify_ddl_outcome create 0
    [[ -f $stopfile ]] && return
    echo "$name PASSED"
}

function test_unprepared_participant_counted_as_yes
{
    unprepared_participant_counted_as_yes
}

function test_unprepared_participant_counted_as_yes_redo_fails
{
    unprepared_participant_counted_as_yes 1
}

