########################################
# TEST 5: Multiple create/drop cycles with 2PC
# Stress test: create and drop multiple times to verify
# no resource leaks or state corruption.
########################################
function test_multiple_create_drop
{
    echo "=== TEST: test_multiple_create_drop ==="
    setup_testcase
    [[ -f $stopfile ]] && return

    for i in 1 2 3; do
        echo "Cycle $i: create"
        $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
        if (( $? != 0 )); then
            fail_exit "test_multiple_create_drop: create failed on cycle $i"
            return
        fi
        verify_table "t"
        [[ -f $stopfile ]] && return

        echo "Cycle $i: drop"
        $P_SQL "drop table t"
        if (( $? != 0 )); then
            fail_exit "test_multiple_create_drop: drop failed on cycle $i"
            return
        fi
        verify_llmeta t
        [[ -f $stopfile ]] && return
    done

    echo "test_multiple_create_drop PASSED"
}

########################################
# TEST 6: Distributed ALTER TABLE — add column
# ALTER TABLE on a genshard partition propagates to all shards via 2PC.
########################################
function test_alter_add_column
{
    echo "=== TEST: test_alter_add_column ==="

    setup_testcase
    [[ -f $stopfile ]] && return

    $P_SQL "create table ta(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_column: create failed"
        return
    fi
    verify_table "ta"
    [[ -f $stopfile ]] && return

    echo "Adding column c to partitioned table..."
    $P_SQL "alter table ta add column c int"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_column: alter failed"
        return
    fi

    # Verify column c exists on all shards
    $S0_SQL "select c from ta limit 1" 2>/dev/null
    (( $? != 0 )) && { fail_exit "test_alter_add_column: column c missing on shard 0"; return; }
    $S1_SQL "select c from ta limit 1" 2>/dev/null
    (( $? != 0 )) && { fail_exit "test_alter_add_column: column c missing on shard 1"; return; }
    $S2_SQL "select c from ta limit 1" 2>/dev/null
    (( $? != 0 )) && { fail_exit "test_alter_add_column: column c missing on shard 2"; return; }
    $S3_SQL "select c from ta limit 1" 2>/dev/null
    (( $? != 0 )) && { fail_exit "test_alter_add_column: column c missing on shard 3"; return; }

    echo "test_alter_add_column PASSED"
}

########################################
# TEST 7: Distributed ALTER TABLE — add index
# ADD INDEX on a genshard partition propagates to all shards; a second ALTER
# and a DROP afterwards must still reach every shard.
# Uses table 't2' to avoid interference from test 6's ALTER/DROP cycle.
########################################
function test_alter_add_index
{
    echo "=== TEST: test_alter_add_index ==="

    $P_SQL "DROP TABLE IF EXISTS t2" 2>/dev/null
    sleep 1

    $P_SQL "create table t2(a int unique, b int) partitioned by columns(a) on (${shards})"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_index: create failed"
        return
    fi
    verify_table "t2"
    [[ -f $stopfile ]] && return

    echo "Adding index idx_b to partitioned table..."
    $P_SQL "alter table t2 add index idx_b(b)"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_index: alter failed"
        return
    fi

    # Every shard must have the new index
    sleep 2
    local sqlt nkeys
    for sqlt in "$S0_SQLT" "$S1_SQLT" "$S2_SQLT" "$S3_SQLT"; do
        nkeys=$($sqlt "select count(*) from comdb2_keys where upper(keyname) like '%IDX_B%'" 2>/dev/null)
        if [[ "$nkeys" != "1" ]]; then
            fail_exit "test_alter_add_index: idx_b missing on a shard ($sqlt returned '$nkeys')"
            return
        fi
    done

    # A second ALTER and a DROP must still fan out: the first ALTER replaced the
    # shard's dbtable and must not have lost its partition membership
    $P_SQL "alter table t2 add column c int"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_index: second alter failed"
        return
    fi
    sleep 2
    for sqlt in "$S0_SQLT" "$S1_SQLT" "$S2_SQLT" "$S3_SQLT"; do
        if ! $sqlt "select c from t2 limit 1" >/dev/null 2>&1; then
            fail_exit "test_alter_add_index: column c missing on a shard after second alter ($sqlt)"
            return
        fi
    done

    $P_SQL "drop table t2"
    if (( $? != 0 )); then
        fail_exit "test_alter_add_index: drop after alter failed"
        return
    fi
    sleep 2
    for sqlt in "$S0_SQLT" "$S1_SQLT" "$S2_SQLT" "$S3_SQLT"; do
        if $sqlt "select 1 from t2 limit 1" >/dev/null 2>&1; then
            fail_exit "test_alter_add_index: t2 still present on a shard after drop ($sqlt)"
            return
        fi
    done

    echo "test_alter_add_index PASSED"
}

########################################
# Crash-recovery helpers
########################################

# Run ddl on the coordinator db directly, so the coordinator is known
C_SQL="cdb2sql ${CDB2_OPTIONS} ${DBNAME} default"

# Turn off every crash-injection tunable on every node of every shard
function clear_debug_tunables
{
    local pair db opts t
    for pair in "$DBNAME|$CDB2_OPTIONS" "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS" \
                "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS" "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        for t in debug_exit_participant_after_prepare debug_fail_ddl_prepare debug_exit_coordinator_before_commit \
                 debug_exit_coordinator_after_commit debug_sleep_coordinator_before_commit; do
            set_tunable $db "$opts" $t 0
        done
    done
}

# Verify a column exists (or not) on every shard
function verify_column
{
    local tbl=$1 col=$2 want=$3 sqlt
    for sqlt in "$S0_SQLT" "$S1_SQLT" "$S2_SQLT" "$S3_SQLT"; do
        if $sqlt "select ${col} from ${tbl} limit 1" >/dev/null 2>&1; then
            [[ "$want" == "absent" ]] && { fail_exit "verify_column: ${tbl}.${col} should be absent ($sqlt)"; return 1; }
        else
            [[ "$want" == "present" ]] && { fail_exit "verify_column: ${tbl}.${col} should be present ($sqlt)"; return 1; }
        fi
    done
    return 0
}

# The ddl run by a crash test, and the state it leaves if it committed
function crash_ddl_sql
{
    case $1 in
        create) echo "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" ;;
        drop) echo "drop table t" ;;
        alter) echo "alter table t add column c int" ;;
    esac
}

function verify_ddl_outcome
{
    local kind=$1 applied=$2
    case $kind in
        create) if (( applied )); then verify_table t; else verify_table_gone t; fi ;;
        drop) if (( applied )); then verify_table_gone t; else verify_table t; fi ;;
        alter) verify_table t && if (( applied )); then verify_column t c present; else verify_column t c absent; fi ;;
    esac
}

function setup_crash_ddl
{
    setup_testcase
    [[ -f $stopfile ]] && return
    if [[ "$1" != "create" ]]; then
        $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"
        if (( $? != 0 )); then
            fail_exit "setup_crash_ddl: could not create t"
            return
        fi
        verify_table t
    fi
}

function wait_for_master
{
    local dbname=$1 opts=$2 max_wait=${3:-60} elapsed=0 m
    while (( elapsed < max_wait )); do
        m=$($CDB2SQL_EXE --tabs $opts $dbname default 'select host from comdb2_cluster where is_master="Y"' 2>/dev/null)
        [[ -n "$m" ]] && { echo $m; return 0; }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 1
}

# The id of the prepared schema change a participant's startup is blocked on
function blocked_dist_txnid
{
    local dbname=$1
    cat $LOGDIR/${dbname}.db $LOGDIR/${dbname}.*.db 2>/dev/null | grep -o "no outcome for prepared schema change [^ ]*" |
        tail -1 | awk '{print $NF}'
}

########################################
# TEST 8: Participant master exits after preparing a schema change
# The tertiary master sends "prepared" and exits; the rest of its cluster is
# killed and restarted.  The restarting master asks the coordinator for the
# outcome before opening llmeta, so it must not deadlock, and every shard must
# end up with the coordinator's decision.
########################################
function test_participant_crash_after_prepare
{
    local kind=$1
    echo "=== TEST: test_participant_crash_after_prepare $kind ==="

    setup_crash_ddl $kind
    [[ -f $stopfile ]] && return

    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_exit_participant_after_prepare 1

    $C_SQL "$(crash_ddl_sql $kind)" 2>&1
    local rc=$?
    echo "$kind returned rc=$rc"

    kill_restart_cluster $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" $TERTIARY_DBDIR 2
    if ! block_until_cluster_is_up $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 120; then
        fail_exit "test_participant_crash_after_prepare $kind: tertiary did not come up (deadlock?)"
        return
    fi
    allow_coordinator_all

    # Every participant prepared, so the coordinator committed
    if (( rc != 0 )); then
        fail_exit "test_participant_crash_after_prepare $kind: ddl failed rc=$rc"
        return
    fi
    verify_ddl_outcome $kind 1
    [[ -f $stopfile ]] && return

    echo "test_participant_crash_after_prepare $kind PASSED"
}

########################################
# TEST 9: Coordinator decides abort
# The quaternary fails to prepare, so the coordinator aborts.  The tertiary
# master prepared and exited: after restart it must roll its drop back.
########################################
function test_coordinator_decides_abort
{
    echo "=== TEST: test_coordinator_decides_abort ==="

    setup_crash_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_exit_participant_after_prepare 1
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_fail_ddl_prepare 1

    $C_SQL "drop table t" 2>&1
    local rc=$?
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_fail_ddl_prepare 0
    if (( rc == 0 )); then
        fail_exit "test_coordinator_decides_abort: drop should have failed"
        return
    fi

    kill_restart_cluster $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" $TERTIARY_DBDIR 2
    if ! block_until_cluster_is_up $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 120; then
        fail_exit "test_coordinator_decides_abort: tertiary did not come up"
        return
    fi
    allow_coordinator_all

    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return

    echo "test_coordinator_decides_abort PASSED"
}

########################################
# TEST 10/11: Coordinator unreachable on restart, and the operator override
# The coordinator master exits before committing and the tertiary master exits
# after preparing.  With the coordinator cluster down, the restarted tertiary
# must not finish starting.  With override=1 the tertiary is restarted with
# 'disttxn_resolve <id> abort' in its lrl and starts without the coordinator.
# Either way the coordinator never wrote its decision, so the drop aborts.
########################################
function test_coordinator_unreachable
{
    local override=$1
    echo "=== TEST: test_coordinator_unreachable override=$override ==="

    setup_crash_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    set_tunable $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" debug_exit_participant_after_prepare 1

    $C_SQL "drop table t" 2>&1
    echo "drop returned rc=$?"

    kill_cluster $DBNAME "$CDB2_OPTIONS"
    kill_restart_cluster $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" $TERTIARY_DBDIR 2

    sleep 20
    if block_until_cluster_is_up $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 1; then
        fail_exit "test_coordinator_unreachable: tertiary started without an outcome for its prepare"
        return
    fi

    local lrl=$TERTIARY_DBDIR/${TERTIARY_DBNAME}.lrl
    if (( override )); then
        local id=$(blocked_dist_txnid $TERTIARY_DBNAME)
        if [[ -z "$id" ]]; then
            fail_exit "test_coordinator_unreachable: could not find the blocked dist-txnid"
            return
        fi
        edit_lrl $lrl "echo 'disttxn_resolve $id abort' >> \$lrl"
        kill_restart_cluster $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" $TERTIARY_DBDIR 2
        if ! block_until_cluster_is_up $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 120; then
            fail_exit "test_coordinator_unreachable: tertiary did not start with the override"
            return
        fi
        edit_lrl $lrl 'grep -v "^disttxn_resolve " $lrl > $lrl.tmp && mv $lrl.tmp $lrl'
        if ! $S2_SQLT "select 1 from t limit 1" >/dev/null 2>&1; then
            fail_exit "test_coordinator_unreachable: override did not roll back the drop on the tertiary"
            return
        fi
    fi

    restart_cluster $DBNAME $DBDIR
    for pair in "$DBNAME|$CDB2_OPTIONS" "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS"; do
        IFS='|' read -r db opts <<< "$pair"
        if ! block_until_cluster_is_up $db "$opts" 120; then
            fail_exit "test_coordinator_unreachable: $db did not come up"
            return
        fi
    done
    allow_coordinator_all

    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return

    echo "test_coordinator_unreachable override=$override PASSED"
}

########################################
# TEST 12: Master swing
# Only the tertiary master exits after preparing.  A replicant becomes master
# and must resolve the prepare (before it resumes schema changes).
########################################
function test_master_swing
{
    echo "=== TEST: test_master_swing ==="
    # needs replicants to elect a new master
    [[ -z "$CLUSTER" ]] && { echo "SKIP: requires cluster"; return; }

    setup_crash_ddl alter
    [[ -f $stopfile ]] && return

    local master=$(find_tertiary_master)
    [[ -z "$master" ]] && { fail_exit "test_master_swing: no tertiary master"; return; }
    $CDB2SQL_EXE -admin $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME --host $master \
        "put tunable debug_exit_participant_after_prepare 1"

    $C_SQL "alter table t add column c int" 2>&1
    local rc=$?
    echo "alter returned rc=$rc"

    local newmaster
    newmaster=$(wait_for_master $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 60)
    if [[ -z "$newmaster" || "$newmaster" == "$master" ]]; then
        fail_exit "test_master_swing: tertiary did not elect a new master (got '$newmaster')"
        return
    fi
    echo "tertiary master $master -> $newmaster"

    if (( rc != 0 )); then
        fail_exit "test_master_swing: alter failed rc=$rc"
        return
    fi
    verify_ddl_outcome alter 1
    [[ -f $stopfile ]] && return

    restart_node $TERTIARY_DBNAME $TERTIARY_DBDIR $master
    if ! block_until_cluster_is_up $TERTIARY_DBNAME "$TERTIARY_CDB2_OPTIONS" 120; then
        fail_exit "test_master_swing: old tertiary master did not rejoin"
        return
    fi
    allow_coordinator_all

    echo "test_master_swing PASSED"
}

########################################
# TEST 13: Coordinator exits before / after committing its decision
# The coordinator does not prepare its own schema change: its local commit is
# the decision.  Exiting before it aborts every shard; exiting after it
# commits every shard.  The coordinator restarts without deadlocking.
########################################
function test_coordinator_crash
{
    local when=$1
    echo "=== TEST: test_coordinator_crash $when ==="

    setup_crash_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_${when}_commit 1

    $C_SQL "drop table t" 2>&1
    echo "drop returned rc=$?"

    kill_restart_cluster $DBNAME "$CDB2_OPTIONS" $DBDIR 2
    if ! block_until_cluster_is_up $DBNAME "$CDB2_OPTIONS" 120; then
        fail_exit "test_coordinator_crash $when: coordinator did not come up (deadlock?)"
        return
    fi
    allow_coordinator_all

    if [[ "$when" == "before" ]]; then
        verify_ddl_outcome drop 0
    else
        verify_ddl_outcome drop 1
    fi
    [[ -f $stopfile ]] && return

    echo "test_coordinator_crash $when PASSED"
}

########################################
# TEST 14: Replicants do not show a prepared schema change
# The coordinator sleeps after every participant has prepared and before it
# commits.  In that window a participant replicant must not show the new
# column; once the alter commits it must.
########################################
function test_replicant_hides_prepare
{
    echo "=== TEST: test_replicant_hides_prepare ==="
    # needs a replicant
    [[ -z "$CLUSTER" ]] && { echo "SKIP: requires cluster"; return; }

    setup_crash_ddl alter
    [[ -f $stopfile ]] && return

    local master=$(find_tertiary_master) replicant node
    for node in $CLUSTER; do
        [[ "$node" != "$master" ]] && { replicant=$node; break; }
    done
    [[ -z "$replicant" ]] && { echo "SKIP: no tertiary replicant"; return; }

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1

    $C_SQL "alter table t add column c int" &
    local alter_pid=$!
    sleep 3

    local R_SQL="$CDB2SQL_EXE --tabs $TERTIARY_CDB2_OPTIONS $TERTIARY_DBNAME --host $replicant"
    local before=0
    $R_SQL "select c from t limit 1" >/dev/null 2>&1 && before=1
    wait $alter_pid
    local rc=$?
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0

    if (( before )); then
        fail_exit "test_replicant_hides_prepare: replicant $replicant showed column c before commit"
        return
    fi
    if (( rc != 0 )); then
        fail_exit "test_replicant_hides_prepare: alter failed rc=$rc"
        return
    fi
    sleep 2
    if ! $R_SQL "select c from t limit 1" >/dev/null 2>&1; then
        fail_exit "test_replicant_hides_prepare: replicant $replicant missing column c after commit"
        return
    fi

    echo "test_replicant_hides_prepare PASSED"
}

