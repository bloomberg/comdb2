# Allow all databases as coordinators for each other
# In single-node mode, use cdb2sql -admin directly
function setup_coordinators
{
    local all_dbs="$DBNAME $SECONDARY_DBNAME $TERTIARY_DBNAME $QUATERNARY_DBNAME"
    local db_opts_pairs=(
        "$DBNAME|$CDB2_OPTIONS"
        "$SECONDARY_DBNAME|$SECONDARY_CDB2_OPTIONS"
        "$TERTIARY_DBNAME|$TERTIARY_CDB2_OPTIONS"
        "$QUATERNARY_DBNAME|$QUATERNARY_CDB2_OPTIONS"
    )

    # allow-coordinator is per-node; in cluster mode send to every node
    local targets="default"
    if [[ -n "$CLUSTER" ]]; then
        targets=""
        for node in $CLUSTER; do
            targets="$targets --host $node"
        done
    fi

    for pair in "${db_opts_pairs[@]}"; do
        IFS='|' read -r db opts <<< "$pair"
        for coord_db in $all_dbs; do
            if [[ -n "$CLUSTER" ]]; then
                for node in $CLUSTER; do
                    $CDB2SQL_EXE -admin $opts $db --host $node \
                        "exec procedure sys.cmd.send('allow-coordinator ${coord_db}/${COORDINATOR_TIER}')" 2>/dev/null
                done
            else
                $CDB2SQL_EXE -admin $opts $db default \
                    "exec procedure sys.cmd.send('allow-coordinator ${coord_db}/${COORDINATOR_TIER}')" 2>/dev/null
            fi
        done
    done
}

########################################
# TEST 30: a local schema change on a prepared participant does not stop that
# db.  The participant releases its schema lock once prepared, but its
# prepared txn keeps the llmeta pages it wrote.  The coordinator sleeps 5s
# after every participant prepared; meanwhile a local create on a participant
# takes the schema write lock to finalize.  A read of an unrelated table there
# should not wait for the coordinator's decision.
########################################
function test_local_ddl_on_prepared_participant
{
    echo "=== TEST: test_local_ddl_on_prepared_participant ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    $S3_SQL "drop table if exists local_ddl" >/dev/null 2>&1

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" > local_ddl_drop.out 2>&1 &
    local drop_pid=$!
    sleep 2
    local ddl_start=$(date +%s)
    $S3_SQL "create table local_ddl(a int)" > local_ddl_create.out 2>&1 &
    local ddl_pid=$!
    sleep 1
    local took=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 20 "select count(*) from unrelated")
    wait $ddl_pid
    local ddl_took=$(( $(date +%s) - ddl_start ))
    wait $drop_pid
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    echo "local create on prepared participant took ${ddl_took}s ($(cat local_ddl_create.out)); read of unrelated table took ${took}s (drop: $(cat local_ddl_drop.out))"
    $S3_SQL "drop table if exists local_ddl" >/dev/null 2>&1

    if [[ "$took" == "timeout" ]] || (( took >= 2 )); then
        fail_exit "test_local_ddl_on_prepared_participant: read of an unrelated table on ${QUATERNARY_DBNAME} took ${took}s while a local create waited for the prepared drop"
        return
    fi
    echo "test_local_ddl_on_prepared_participant PASSED"
}

########################################
# TEST 31: a prepared participant does not show its undecided drop.  The
# coordinator exits once every participant prepared, so the drop is aborted
# when it comes back.  A read of the table on a participant meanwhile must not
# fail with 'no such table': it waits for the decision and finds the table.
########################################
function test_prepared_drop_not_visible
{
    echo "=== TEST: test_prepared_drop_not_visible ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1
    $C_SQL "drop table t" 2>&1
    echo "drop rc $?"
    sleep 2

    timeout 120 $S3_SQLT "select count(*) from t" > prepared_drop_read.out 2>&1 &
    local read_pid=$!
    sleep 2
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0
    wait $read_pid
    local read_rc=$?
    echo "read on ${QUATERNARY_DBNAME} while the drop was undecided: rc ${read_rc} ($(cat prepared_drop_read.out))"

    if (( read_rc != 0 )); then
        fail_exit "test_prepared_drop_not_visible: ${QUATERNARY_DBNAME} failed a read of t before the coordinator decided: $(cat prepared_drop_read.out)"
        return
    fi
    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return
