    local out=$TMPDIR/gave_up_crash.out
    rm -f $out
    ( $C_SQL "drop table t" > $out 2>&1; echo "rc $?" >> $out ) &
    local cpid=$!
    if ! wait_quaternary_log "before keeping that" 40 $exited; then
        fail_exit "test_gave_up_crash_before_voted: ${QUATERNARY_DBNAME} did not exit after giving up"
        return
    fi
    wait $cpid
    echo "drop: $(cat $out)"
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    # the fault and timeout are not in the lrl: the restart clears them
    restart_db $QUATERNARY_DBNAME $QUATERNARY_DBDIR "$QUATERNARY_CDB2_OPTIONS"
    [[ -f $stopfile ]] && return

    if ! wait_quaternary_log "committing resumed 2pc schema change" 60 $committed; then
        echo "${QUATERNARY_DBNAME} resume: $(cat $LOGDIR/${QUATERNARY_DBNAME}*.db | grep -E 'never prepared|never voted|resume_2pc' | tail -3)"
        fail_exit "test_gave_up_crash_before_voted: ${QUATERNARY_DBNAME} did not apply the committed drop after its restart"
        return
    fi
    verify_ddl_outcome drop 1
    [[ -f $stopfile ]] && return
    echo "test_gave_up_crash_before_voted PASSED"
}

########################################
# TEST 44: a coordinator whose commit fails before it is logged backs out its
# schema.  The coordinator writes its decision, but its logical commit fails
# unlogged (fail_coordinator_commit), so it aborts every participant.  Its
# finalized drop was already published in memory: it must back that out, not
# run the abort cleanup on it, so t is still there and usable on every shard,
# the coordinator included.  System-table readers run through the backout,
# which must hold comdb2_tables as the participant's does.
########################################
function test_coordinator_commit_fails_unlogged
{
    echo "=== TEST: test_coordinator_commit_fails_unlogged ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_remote_2pc_fault fail_coordinator_commit
    ( while :; do $S0_SQL "select count(*) from comdb2_columns" >/dev/null 2>&1; done ) &
    local reader=$!
    local out
    out=$($C_SQL "drop table t" 2>&1)
    local rc=$?
    kill $reader; wait $reader 2>/dev/null
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_remote_2pc_fault off
    echo "drop rc $rc: $out"
    if (( rc == 0 )); then
        fail_exit "test_coordinator_commit_fails_unlogged: drop should have failed"
        return
    fi
    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return
    if ! $S0_SQL "insert into t values(4400, 1)" >/dev/null 2>&1; then
        fail_exit "test_coordinator_commit_fails_unlogged: t on ${DBNAME} is not writable after the failed commit"
        return
    fi
    # the coordinator's table is whole after a restart too
    stop_db $DBNAME "$CDB2_OPTIONS"
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    if [[ "$($S0_SQLT "select count(*) from t where a = 4400" 2>&1)" != "1" ]]; then
        fail_exit "test_coordinator_commit_fails_unlogged: t on ${DBNAME} lost its row after a restart"
        return
    fi
    echo "test_coordinator_commit_fails_unlogged PASSED"
}

########################################
# TEST 45: a participant whose create fails to finalize, after it locked
# comdb2_tables, backs out cleanly.  Its comdb2_tables lock is held in a
# transaction of its own; the failed request must release it, not leave it
# open past the request (which the master asserts against), and the create
# must fail on every shard and work once the fault is gone.
########################################
function test_participant_finalize_fails
{
    echo "=== TEST: test_participant_finalize_fails ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault fail_finalize
    local out
    out=$($C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1)
    local rc=$?
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_remote_2pc_fault off
    echo "create rc $rc: $out"
    if (( rc == 0 )); then
        fail_exit "test_participant_finalize_fails: create should have failed"
        return
    fi
    if ! $S3_SQL "select 1" >/dev/null 2>&1; then
        fail_exit "test_participant_finalize_fails: ${QUATERNARY_DBNAME} is down after its failed finalize"
        return
    fi
    verify_ddl_outcome create 0
    [[ -f $stopfile ]] && return
    # comdb2_tables is readable, and the create works once the fault is gone
    if ! $S3_SQL "select count(*) from comdb2_tables" >/dev/null 2>&1; then
        fail_exit "test_participant_finalize_fails: comdb2_tables on ${QUATERNARY_DBNAME} is not readable"
        return
    fi
    if ! $P_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})"; then
        fail_exit "test_participant_finalize_fails: create failed after the fault was cleared"
        return
    fi
    verify_ddl_outcome create 1
    [[ -f $stopfile ]] && return
    echo "test_participant_finalize_fails PASSED"
}

########################################
# TEST 46: a local stored procedure on a prepared participant does not stop
# that db.  As TEST 30, but the local schema change is a procedure, which
# writes llmeta only in its finalize, holding the schema write lock: it must
# not take that lock while a prepared schema change holds llmeta pages.
########################################
function test_local_sp_on_prepared_participant
{
    echo "=== TEST: test_local_sp_on_prepared_participant ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return
    make_unrelated_table $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS"
    $S3_SQL "drop procedure local_sp version 'v1'" >/dev/null 2>&1

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
    $C_SQL "drop table t" > local_sp_drop.out 2>&1 &
    local drop_pid=$!
    sleep 2
    $S3_SQL "create procedure local_sp version 'v1' {local function main() return 0 end}" > local_sp_create.out 2>&1 &
    local sp_pid=$!
    sleep 1
    local took=$(timed_sql $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" 20 "select count(*) from unrelated")
    wait $sp_pid
    wait $drop_pid
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    echo "local procedure on prepared participant: $(cat local_sp_create.out); read of unrelated table took ${took}s (drop: $(cat local_sp_drop.out))"
    $S3_SQL "drop procedure local_sp version 'v1'" >/dev/null 2>&1

    if [[ "$took" == "timeout" ]] || (( took >= 2 )); then
        fail_exit "test_local_sp_on_prepared_participant: read of an unrelated table on ${QUATERNARY_DBNAME} took ${took}s while a local procedure waited for the prepared drop"
        return
    fi
    echo "test_local_sp_on_prepared_participant PASSED"
}

########################################
# TEST 47: a reverse scan of sqlite_master on a prepared participant does not
# show its undecided create.  The new table's entries are the last ones in
# sqlite_master, which is where a reverse scan starts.
########################################
function test_prepared_create_not_in_reverse_master_scan
{
    echo "=== TEST: test_prepared_create_not_in_reverse_master_scan ==="
    setup_outcome_ddl create
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1
