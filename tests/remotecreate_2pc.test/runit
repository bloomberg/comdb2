########################################
# TEST 12: Coordinator resumes and aborts
# The coordinator exits after every participant prepared its drop, before it
# commits the decision.  Its new master finds the drop's 2pc sc_list; it must
# not commit its own shard's drop, but abort it, without redoing it, and tell
# the participants, which abort theirs.  It must also clear its shard's
# schema change record, so that a later master does not resume the drop as a
# local schema change.
########################################
function test_coordinator_resume_aborts
{
    echo "=== TEST: test_coordinator_resume_aborts ==="

    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 1

    $C_SQL "drop table t" 2>&1
    if (( $? == 0 )); then
        fail_exit "test_coordinator_resume_aborts: drop should have failed"
        return
    fi

    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_exit_coordinator_before_commit 0

    # aborted from the sc_list, not after redoing the drop
    wait_for_log $DBNAME "resume_sc_multiddl_txn uuid .*: aborting resumed 2pc schema change .* as coordinator"
    [[ -f $stopfile ]] && return

    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return

    # a later master of the coordinator must not resume the drop on its own
    local resumed=$(cat $LOGDIR/${DBNAME}*.db 2>/dev/null | grep -c "in the middle of a schema change, resuming")
    stop_db $DBNAME "$CDB2_OPTIONS"
    restart_db $DBNAME $DBDIR "$CDB2_OPTIONS"
    [[ -f $stopfile ]] && return
    sleep 5
    if (( $(cat $LOGDIR/${DBNAME}*.db 2>/dev/null | grep -c "in the middle of a schema change, resuming") > resumed )); then
        fail_exit "test_coordinator_resume_aborts: the coordinator resumed the aborted drop as a local schema change"
        return
    fi
    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return
    verify_table_usable t
    [[ -f $stopfile ]] && return

    echo "test_coordinator_resume_aborts PASSED"
}

########################################
# TEST 13: Prepared participant gives up, coordinator commits later
# The quaternary waits at most 2s for its coordinator, which sleeps 5s after
# every participant prepared before it commits.  The quaternary aborts its
# prepared schema change, releases it in memory and frees its schema lock,
# then asks the coordinator again holding no locks, and redoes the schema
# change when it learns that it committed: every shard ends up changed.  Run
# for a drop and for a create, whose new table the abort must release.
########################################
function participant_gives_up_then_commits
{
    local kind=$1
    echo "=== TEST: test_participant_gives_up_then_commits $kind ==="

    setup_outcome_ddl $kind
    [[ -f $stopfile ]] && return

    local committed=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "committing resumed 2pc schema change")
    local gaveup=$(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "gave up on coordinator")
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms 2000
    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 1

    if [[ "$kind" == "create" ]]; then
        $C_SQL "create table t(a int unique, b int) partitioned by columns(a) on (${shards})" 2>&1
    else
        $C_SQL "drop table t" 2>&1
    fi
    echo "$kind rc $?"

    set_tunable $DBNAME "$CDB2_OPTIONS" debug_sleep_coordinator_before_commit 0
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" disttxn_ddl_timeout_ms $DEFAULT_DDL_TIMEOUT_MS

    local waited=0
    while (( $(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "gave up on coordinator") <= gaveup )); do
        if (( waited++ >= 60 )); then
            fail_exit "test_participant_gives_up_then_commits $kind: the participant did not give up"
            return
        fi
        sleep 1
    done
    waited=0
    while (( $(cat $LOGDIR/${QUATERNARY_DBNAME}*.db 2>/dev/null | grep -c "committing resumed 2pc schema change") <= committed )); do
        if (( waited++ >= 60 )); then
            fail_exit "test_participant_gives_up_then_commits $kind: the participant did not redo the committed $kind"
            return
        fi
        sleep 1
    done

    verify_ddl_outcome $kind 1
    [[ -f $stopfile ]] && return

    echo "test_participant_gives_up_then_commits $kind PASSED"
}

function test_participant_gives_up_then_commits
{
    participant_gives_up_then_commits drop
}

function test_participant_gives_up_then_commits_create
{
    participant_gives_up_then_commits create
}

