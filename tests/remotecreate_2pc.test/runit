########################################
# TEST 53: The coordinator gives up on a held schema lock
# A local schema change on the coordinator holds its schema lock past
# disttxn_ddl_timeout_ms.  The coordinator's drop collects every yes vote,
# times out on the schema lock and aborts: t stays on every shard.
########################################
function test_coordinator_schema_lock_timeout
{
    echo "=== TEST: test_coordinator_schema_lock_timeout ==="
    setup_outcome_ddl drop
    [[ -f $stopfile ]] && return

    $S0_SQL "drop table if exists unrelated53" >/dev/null 2>&1
    # set every tunable first: sql, put tunable included, blocks while the schema lock is held
    local paused=$(cat $LOGDIR/${DBNAME}*.db 2>/dev/null | grep -c "finalized, pausing")
    local slept=$(quaternary_log_count "sleeping before voting")
    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms 8000
    set_tunable $DBNAME "$CDB2_OPTIONS" test_sc_finalize_pause_ms 15000
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl $DBG_SLEEP_BEFORE_VOTE

    # the drop is past its sql and collecting votes before the local schema change takes the lock
    $C_SQL "drop table t" > drop53.out 2>&1 &
    local dropper=$!
    local holder=
    if wait_quaternary_log "sleeping before voting" 30 $slept; then
        $S0_SQL "create table unrelated53(a int)" > unrelated53.out 2>&1 &
        holder=$!
    fi
    wait $dropper
    local rc=$?
    local out=$(cat drop53.out)
    local held=$(cat $LOGDIR/${DBNAME}*.db 2>/dev/null | grep -c "finalized, pausing")
    [[ -n "$holder" ]] && wait $holder
    set_tunable $DBNAME "$CDB2_OPTIONS" test_sc_finalize_pause_ms 0
    set_tunable $DBNAME "$CDB2_OPTIONS" disttxn_ddl_timeout_ms 120000
    set_tunable $QUATERNARY_DBNAME "$QUATERNARY_CDB2_OPTIONS" debug_2pc_ddl 0
    echo "drop rc $rc: $out"
    if [[ -z "$holder" ]] || (( held <= paused )); then
        fail_exit "test_coordinator_schema_lock_timeout: the local schema change never held the schema lock"
        return
    fi
    if (( rc == 0 )) || [[ "$out" != *"timed out"*"schema lock"* ]]; then
        fail_exit "test_coordinator_schema_lock_timeout: drop should have timed out on the schema lock"
        return
    fi
    verify_ddl_outcome drop 0
    [[ -f $stopfile ]] && return
    $S0_SQL "drop table if exists unrelated53" >/dev/null 2>&1
    echo "test_coordinator_schema_lock_timeout PASSED"
}

function run_testcase
{
    local testcase=$1 start=$SECONDS label=$(testcase_label $1)
    current_testcase=$testcase
    last_testcase=$testcase
    current_start=$start
    echo "##### RUNNING: $label #####"
    $testcase
    current_testcase=""
    local took=$((SECONDS - start))
    timings="$timings
    $label ${took}s"
    echo "TIMING: $label took ${took}s"
}

# the failure goes last: CI shows only the tail of this log
function fail_with_timings
{
    echo "Testcase timings:$timings"
    echo "Failed testcase(s): $(testcase_label "${1:-$last_testcase}")"
    if [[ -s ${DBNAME}.fail_exit ]]; then
        cat ${DBNAME}.fail_exit
    else
        echo "Failed: no reason recorded"
    fi
    echo "Testcase failed"
    exit -1
}

# the harness's timeout sends TERM first: still say what ran and for how long
trap 'echo "Failed: timed out in ${current_testcase:-setup} after $((SECONDS - current_start))s" >> ${DBNAME}.fail_exit; fail_with_timings "${current_testcase:-setup}"' TERM

# RC2PC_ONLY="test_a test_b": run only these testcases; each failure is
# recorded and the next one still runs
if [[ -n "$RC2PC_ONLY" ]]; then
    failed=""
    for testcase in $RC2PC_ONLY; do
        rm -f $stopfile
        run_testcase $testcase
        clear_debug_tunables
        [[ -f $stopfile ]] && failed="$failed $testcase"
    done
    if [[ -n "$failed" ]]; then
        fail_with_timings "$failed"
    fi
    echo "Success"
    exit 0
fi

