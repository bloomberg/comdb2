#!/usr/bin/env bash
bash -n "$0" | exit 1

#export debug=1
[[ $debug == "1" ]] && set -x

. ${TESTSROOTDIR}/tools/write_prompt.sh
. ${TESTSROOTDIR}/tools/ddl.sh
. ${TESTSROOTDIR}/tools/cluster_utils.sh

export stopfile=./stop.test

# Locks are short-lived, so every check here is "generate load, then poll
# comdb2_locks until the row we want shows up or we give up".
export poll_iters=60

function failexit
{
    touch $stopfile
    echo "Failed: $1: $2"
    exit -1
}

# Every check pins its load and its poll to the SAME node.  comdb2_locks,
# comdb2_connections and comdb2_active_osqls are all per-node, so a client on
# one node and a poll on another would silently never intersect.  An empty node
# means an unclustered run, where 'default' is the only node there is.
function query_node
{
    typeset node=$1
    typeset sql=$2
    if [[ -z "$node" ]]; then
        $CDB2SQL_EXE $CDB2_OPTIONS --tabs $DBNAME default "$sql" 2>/dev/null
    else
        $CDB2SQL_EXE $CDB2_OPTIONS --tabs $DBNAME --host $node "$sql" 2>/dev/null
    fi
}

function sql_on
{
    typeset node=$1
    typeset sql=$2
    if [[ -z "$node" ]]; then
        $CDB2SQL_EXE $CDB2_OPTIONS $DBNAME default "$sql" >/dev/null 2>&1
    else
        $CDB2SQL_EXE $CDB2_OPTIONS $DBNAME --host $node "$sql" >/dev/null 2>&1
    fi
}

function background_write_thread
{
    typeset table=$1
    typeset node=$2
    typeset j=0
    while [[ $j -lt 200 && ! -f $stopfile ]]; do
        sql_on "$node" "insert into $table(a) select * from generate_series(1, 1000)"
        let j=j+1
    done
}

function background_read_thread
{
    typeset table=$1
    typeset node=$2
    typeset j=0
    while [[ $j -lt 1000 && ! -f $stopfile ]]; do
        sql_on "$node" "select count(*) from $table where a > 0"
        let j=j+1
    done
}

function background_writeload
{
    typeset table=$1
    typeset node=$2
    typeset i=0
    while [[ $i -lt 10 ]]; do
        background_write_thread "$table" "$node" &
        let i=i+1
    done
    wait
}

function background_readload
{
    typeset table=$1
    typeset node=$2
    typeset i=0
    while [[ $i -lt 10 ]]; do
        background_read_thread "$table" "$node" &
        let i=i+1
    done
    wait
}

# Poll $node until 'select count(*) ... $from_where' is non-zero.  Returns 0 on
# success, 1 if we ran out of iterations.
#
# 'select count(*)' always returns exactly one row, so empty output means the
# query itself failed -- an unreachable node, say.  Treating that as "not yet"
# would burn the full poll budget and then report the far more interesting-
# sounding "never saw this", so call it out instead.
function poll_for_count
{
    typeset node=$1
    typeset from_where=$2
    typeset j=0
    typeset empties=0
    typeset x=

    while [[ ! -f $stopfile && $j -lt $poll_iters ]]; do
        x=$(query_node "$node" "select count(*) $from_where")
        if [[ -z "$x" ]]; then
            let empties=empties+1
            if [[ $empties -ge 3 ]]; then
                stop_load
                failexit "poll_for_count" "querying ${node:-default} failed 3x -- node unreachable?"
            fi
        else
            empties=0
            [[ "$x" != "0" ]] && return 0
        fi
        let j=j+1
        sleep 1
    done
    return 1
}

# Called before giving up, so a failure says what the node actually looked like
# rather than only what it was missing.
function dump_diagnostics
{
    typeset node=$1
    write_prompt "diagnostics" "State of ${node:-default}:"
    echo "  total locks: $(query_node "$node" "select count(*) from comdb2_locks")"
    echo "  by role (locks, with client_id):"
    query_node "$node" "select coalesce(fingerprint_role,'NULL'), count(*), count(client_id) from comdb2_locks group by fingerprint_role" | sed 's/^/    /'
    echo "  active_osqls by type (rows, with argv0, with client_id):"
    query_node "$node" "select type, count(*), count(argv0), count(client_id) from comdb2_active_osqls group by type" | sed 's/^/    /'
    echo "  connections: $(query_node "$node" "select count(*) from comdb2_connections")"
    echo "  replication (threads, with taskname, with fingerprint):"
    query_node "$node" "select count(*), count(taskname), count(fingerprint) from comdb2_replication" | sed 's/^/    /'
}

function stop_load
{
    touch $stopfile
    wait
    rm $stopfile >/dev/null 2>&1
}

# client_id is either NULL or non-zero, and never appears without a role -- the
# role is what tells you which table to join.  Checked under load, so it sees
# the widest variety of lock holders.
function verify_column_contract
{
    typeset func="verify_column_contract"
    typeset node=$1
    typeset x=
    write_prompt $func "Verify client_id is well-formed on ${node:-default}"

    x=$(query_node "$node" "select count(*) from comdb2_locks where client_id is not null and client_id = 0")
    [[ "$x" != "0" ]] && failexit $func "$x locks have a zero client_id instead of NULL"

    x=$(query_node "$node" "select count(*) from comdb2_locks where client_id is not null and fingerprint_role is null")
    [[ "$x" != "0" ]] && failexit $func "$x locks have a client_id but no role to say which table it joins"

    write_prompt $func "client_id is well-formed on ${node:-default}"
}

# A read lock's client is its connection.
function verify_read_client
{
    typeset func="verify_read_client"
    typeset node=$1
    write_prompt $func "Verify 'R' locks on ${node:-default} join comdb2_connections"

    background_readload t1 "$node" &

    if ! poll_for_count "$node" "from comdb2_locks where fingerprint_role='R' and client_id is not null"; then
        dump_diagnostics "$node" ; stop_load
        failexit $func "Never saw an 'R' lock carrying a client_id"
    fi
    write_prompt $func "Found 'R' locks carrying a client_id"

    if ! poll_for_count "$node" "from comdb2_locks l join comdb2_connections c on l.client_id = c.client_id where l.fingerprint_role='R'"; then
        dump_diagnostics "$node" ; stop_load
        failexit $func "An 'R' lock's client_id never matched a comdb2_connections row"
    fi
    write_prompt $func "'R' locks join comdb2_connections"

    verify_column_contract "$node"

    stop_load
}

# A write lock's client is its osql session.  Writes are routed to the master no
# matter where they are submitted, so submit them there and poll the same node.
# With osql_send_clientinfo on (lrl.options) the session also knows the client's
# taskname and pid, which is the part the master cannot work out for itself.
function verify_write_client
{
    typeset func="verify_write_client"
    typeset master=$1
    write_prompt $func "Verify 'W' locks on ${master:-default} join comdb2_active_osqls"

    background_writeload t1 "$master" &

    if ! poll_for_count "$master" "from comdb2_locks where fingerprint_role='W' and client_id is not null"; then
        dump_diagnostics "$master" ; stop_load
        failexit $func "Never saw a 'W' lock carrying a client_id"
    fi
    write_prompt $func "Found 'W' locks carrying a client_id"

    if ! poll_for_count "$master" "from comdb2_locks l join comdb2_active_osqls o on l.client_id = o.client_id where l.fingerprint_role='W'"; then
        dump_diagnostics "$master" ; stop_load
        failexit $func "A 'W' lock's client_id never matched a comdb2_active_osqls row"
    fi
    write_prompt $func "'W' locks join comdb2_active_osqls"

    # The whole point of OSQL_CLIENTINFO: without it the master has the origin
    # host but no idea which client task is behind the write.
    if ! poll_for_count "$master" "from comdb2_active_osqls where type='BPLOG' and argv0 is not null and pid is not null"; then
        dump_diagnostics "$master" ; stop_load
        failexit $func "A BPLOG session never reported the client taskname and pid"
    fi
    write_prompt $func "BPLOG sessions report the client taskname and pid"

    verify_column_contract "$master"

    stop_load
}

# The clientinfo log record has to survive a restart: recovery reads it back
# through handle_clientinfo, a path none of the live-state checks above touch.
# Restart a replicant when we have one -- its log carries the records too, and
# bouncing the master would just swing the cluster.
function verify_recovery
{
    typeset func="verify_recovery"
    typeset master=$1
    typeset node=$2
    typeset before=
    typeset after=
    typeset j=0

    [[ -z "$node" ]] && node=$(hostname)

    write_prompt $func "Verify $node recovers over logs holding clientinfo records"

    sql_on "$master" "insert into t1(a) select * from generate_series(1, 5000)"
    before=$(query_node "$master" "select count(*) from t1")
    [[ -z "$before" ]] && failexit $func "could not count t1 before the restart"

    # kill_restart_node uses kill -9, so flush or the tail of the log goes too.
    sql_on "$node" "exec procedure sys.cmd.send('flush')"
    kill_restart_node "$node" 10 1

    # Poll: a restarted replicant has to catch back up to the master.
    while [[ $j -lt 60 ]]; do
        after=$(query_node "$node" "select count(*) from t1")
        [[ "$after" == "$before" ]] && break
        sleep 1
        let j=j+1
    done
    [[ "$after" != "$before" ]] && failexit $func "after recovery $node has $after rows, wanted $before"
    write_prompt $func "Recovered with $after rows intact"

    # And the systables still answer -- a botched record would abort the apply.
    after=$(query_node "$node" "select count(*) from comdb2_replication")
    [[ -z "$after" ]] && failexit $func "comdb2_replication unqueryable after recovery"
    write_prompt $func "comdb2_replication queryable after recovery"
}

# A replicant reports one comdb2_replication row per thread applying, naming the
# client from the txn's log record.  Load runs on the master -- the replicant has
# to have something to apply -- and the poll runs on the replicant.  Clustered
# runs only: a single node never applies anything.
function verify_replication
{
    typeset func="verify_replication"
    typeset master=$1
    typeset replicant=$2
    typeset x=

    if [[ -z "$replicant" ]]; then
        write_prompt $func "Not a clustered run, skipping comdb2_replication"
        return 0
    fi

    write_prompt $func "Verify comdb2_replication on $replicant names the client"

    background_writeload t1 "$master" &

    if ! poll_for_count "$replicant" "from comdb2_replication"; then
        dump_diagnostics "$replicant" ; stop_load
        failexit $func "comdb2_replication never showed an applying thread"
    fi
    write_prompt $func "Found applying threads on $replicant"

    if ! poll_for_count "$replicant" "from comdb2_replication where taskname is not null and host is not null and pid is not null"; then
        dump_diagnostics "$replicant" ; stop_load
        failexit $func "comdb2_replication never named the client"
    fi
    write_prompt $func "comdb2_replication names the client"

    # log_fingerprint is on, so a thread should also report the statement it is
    # applying -- informational, since a txn can be logged without one.
    x=$(query_node "$replicant" "select count(*) from comdb2_replication where fingerprint is not null")
    write_prompt $func "$x applying threads report a fingerprint"

    stop_load
}

function run_test
{
    typeset func="run_test"
    typeset master=
    typeset replicant=
    typeset x=

    write_prompt $func "Running $func"

    if [[ -n "$CLUSTER" ]]; then
        master=$(get_master)
        [[ -z "$master" ]] && failexit $func "Could not determine the master"
        replicant=$(query_node "" "select host from comdb2_cluster where is_master='N' limit 1")
        [[ -z "$replicant" ]] && failexit $func "Could not find a replicant"
        write_prompt $func "master=$master replicant=$replicant"
    fi

    sql_on "" "create table t1(a int)"
    x=$(query_node "" "select count(*) from comdb2_tables where tablename='t1'")
    [[ "$x" != "1" ]] && failexit $func "Failed to create t1"

    # Seed enough rows that a scan lasts long enough to be caught mid-flight.
    # Chunked: one 100k-row insert is a big enough transaction to risk rc 202
    # 'transaction too big', and a silently empty t1 makes every later check
    # fail as "never saw a lock".
    typeset i=0
    while [[ $i -lt 10 ]]; do
        sql_on "" "insert into t1(a) select * from generate_series(1, 10000)"
        let i=i+1
    done
    x=$(query_node "$master" "select count(*) from t1")
    [[ "$x" != "100000" ]] && failexit $func "t1 seed incomplete: $x rows on ${master:-default}, wanted 100000"
    write_prompt $func "Seeded t1 with $x rows"

    # Reads can run anywhere; pin them to the master so a single-node run and a
    # clustered run exercise the same node, and so the poll cannot miss them.
    verify_read_client "$master"
    verify_write_client "$master"
    verify_replication "$master" "$replicant"
    # Last: it restarts a node, so nothing after it can assume a steady cluster.
    verify_recovery "$master" "$replicant"
}

rm $stopfile >/dev/null 2>&1
run_test
# No trailing wait: kill_restart_node leaves the restarted node as a background
# job of this shell, and waiting on it blocks for the life of the database.
# Every load thread is already joined by stop_load.

echo "Success"
