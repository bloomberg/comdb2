nowatch
logmsg level info
dtastripe   1
osql_send_clientinfo 1
osql_send_fingerprint 1
log_clientinfo 1
log_fingerprint 1

# Locks are held across the page fetch, so a nanosleep at the top of
# __memp_fget widens the window in which comdb2_locks can see them.  READONLY,
# so it has to be set here rather than with 'put tunable'.
slowfget 1000
