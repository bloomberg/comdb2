#!/usr/bin/env bash

# A statement that writes locally and only reads a remote table should not
# create a remote transaction; the remote db counts remtran requests in
# comdb2_appsock_handlers, which we sum across its nodes before and after
# every scenario.
#
# DBNAME is the remote db, SECONDARY_DBNAME is the source db

vars="DBNAME CDB2_CONFIG SECONDARY_DBNAME SECONDARY_CDB2_CONFIG"
for required in $vars; do
    if [[ -z "${!required}" ]]; then
        echo "$required not set" >&2
        exit 1
    fi
done

REM="${CDB2SQL_EXE} --tabs --cdb2cfg ${CDB2_CONFIG} ${DBNAME}"
SRC="${CDB2SQL_EXE} --tabs --cdb2cfg ${SECONDARY_CDB2_CONFIG} ${SECONDARY_DBNAME}"
RTBL="LOCAL_${DBNAME}.t"

failexit()
{
    echo "Failed: $1"
    exit 1
}

# with push writes on, remote writes run over cdb2api, never over remtran
pushw=$($SRC default "select value from comdb2_tunables where name='foreign_db_push_remote_writes'")
[[ -z "$pushw" ]] && failexit "cannot read foreign_db_push_remote_writes"
if [[ "$pushw" == "ON" ]]; then
    wexp=0
else
    wexp=+
fi
echo "push writes $pushw"

nodes=$($REM default "select host from comdb2_cluster")
[[ -z "$nodes" ]] && failexit "no remote nodes"

remtran_count()
{
    local total=0 n c
    for n in $nodes; do
        c=$(${CDB2SQL_EXE} --tabs --cdb2cfg ${CDB2_CONFIG} ${DBNAME} --host $n "select exec_count from comdb2_appsock_handlers where name='remtran'")
        total=$((total + ${c:-0}))
    done
    echo $total
}

# run sql on source db, check remtran delta on remote db
# $1: expected delta ("0" or "+" for any positive), $2: name, stdin: sql
check()
{
    local exp=$1 name=$2 before after delta out
    before=$(remtran_count)
    out=$($SRC default - 2>&1)
    if [[ $? -ne 0 ]] || echo "$out" | grep -q "failed with rc"; then
        failexit "$name: sql failed: $out"
    fi
    after=$(remtran_count)
    delta=$((after - before))
    echo "$name: remtran delta $delta"
    if [[ "$exp" == "0" && $delta -ne 0 ]]; then
        failexit "$name: unexpected remote transaction(s) $delta"
    fi
    if [[ "$exp" == "+" && $delta -le 0 ]]; then
        failexit "$name: expected a remote transaction"
    fi
}

$REM default "create table t(id int)" || failexit "create remote table"
$SRC default "create table t(id int)" || failexit "create local table"
$REM default "insert into t select value from generate_series(1, 10)" || failexit "populate remote"
$SRC default "insert into t select value from generate_series(1, 20)" || failexit "populate local"

# the remote db is known after first access
$SRC default "select count(*) from ${RTBL}" || failexit "remote select"

check 0 "standalone local update, remote read" <<EOF
update t set id=id where id>(select max(id) from ${RTBL})
EOF

check 0 "socksql txn local update, remote read" <<EOF
begin
update t set id=id where id>(select max(id) from ${RTBL})
commit
EOF

check 0 "read committed txn local update, remote read" <<EOF
set transaction read committed
begin
update t set id=id where id>(select max(id) from ${RTBL})
commit
EOF

check 0 "standalone local insert, remote read" <<EOF
insert into t select id + 100 from ${RTBL} where id < 3
EOF

check $wexp "standalone remote write" <<EOF
insert into ${RTBL} values (11)
EOF

check $wexp "txn remote write followed by local update, remote read" <<EOF
begin
insert into ${RTBL} values (12)
update t set id=1000 where id=(select max(id) from ${RTBL})
commit
EOF

# the read after the remote write joined the remote transaction, but socksql
# does not see its own uncommitted writes: max is 11, not the uncommitted 12,
# so local row 11 was updated and 12 was not
res=$($SRC default "select id from t where id in (11, 12, 1000) order by id" | xargs)
[[ "$res" != "12 1000" ]] && failexit "socksql remote read saw its own uncommitted write, got '$res'"

res=$($REM default "select count(*) from t")
[[ "$res" != "12" ]] && failexit "remote row count $res, expected 12"

# the source db traces the first remtran it sends (and every 1000th after);
# the read-only scenarios run first, so a remtran for any of them shows up
# here; with push writes on, no remtran is sent at all
trace=$(cat ${TESTDIR}/logs/${SECONDARY_DBNAME}*.db 2>/dev/null | grep "SENDING REMTRAN")
echo "remtran trace: ${trace:-none}"
if echo "$trace" | grep -qi "update t set"; then
    failexit "remtran sent for read-only remote access"
fi
if [[ "$pushw" == "ON" && -n "$trace" ]]; then
    failexit "remtran sent with push writes on"
fi
if [[ "$pushw" != "ON" && -z "$trace" ]]; then
    failexit "no remtran trace for remote writes, check source db logs"
fi

echo "SUCCESS"
