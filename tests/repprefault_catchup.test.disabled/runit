#!/usr/bin/env bash

bash -n "$0" | exit 1

# Catch-up benchmark for rep prefault: the case the feature exists for.  A
# replicant that was down while the master took writes must re-apply the whole
# backlog at full speed, with no coherency coupling to hide behind.  SIGSTOP
# stands in for the downtime; catchup_s is the claim.

dbnm=$1

ROWS=${ROWS:-50000}
BATCH=2500
PASSES=${PASSES:-12}
SCATTER=$PASSES
MODES=${MODES:-"off adapt off adapt"}

if [ -z "${CLUSTER}" ]; then
    echo "this benchmark needs a cluster" >&2
    exit 1
fi

master=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbnm default \
    'select host from comdb2_cluster where is_master="Y"')
rep=""
for node in ${CLUSTER}; do
    [ "$node" != "$master" ] && rep=$node && break
done
[ -z "$rep" ] && echo "no replicant in CLUSTER='${CLUSTER}'" >&2 && exit 1
echo "master=$master replicant=$rep rows=$ROWS passes=$PASSES"

m() { cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host "$master" "$1"; }
r() { cdb2sql --tabs ${CDB2_OPTIONS} $dbnm --host "$rep" "$1"; }

lsn_of() {
    m "select logfile*10000000000+logoffset from comdb2_cluster where host='$1'"
}

apply_miss() {
    r 'exec procedure sys.cmd.send("bdb cachestat")' 2>/dev/null | awk '
        /^st_apply_miss:/ {print $2}'
}

sweep() {
    local k=0
    while [ $k -lt $PASSES ]; do
        m "update t set c = c + 1 where a % $SCATTER = $k" >/dev/null
        k=$((k + 1))
    done
}

echo "loading ${ROWS} rows..."
m "create table t(a int, pad char(2000), c int)" >/dev/null
m "create index ta on t(a)" >/dev/null
loaded=0
while [ $loaded -lt $ROWS ]; do
    m "insert into t select value + $loaded, hex(randomblob(1000)), 0
         from generate_series(1, $BATCH)" >/dev/null
    loaded=$((loaded + BATCH))
done
echo "loaded $(m 'select count(*) from t') rows"

cache_kb=$(r "select value from comdb2_tunables where name='cachekb'")
tbl_b=$(m "select * from comdb2_tablesizes" | awk '$1=="t"{print $2}')
echo "replicant cache ${cache_kb}kb, table $((tbl_b / 1024))kb"

sleep 10

r "put tunable 'rep_prefault' '0'" >/dev/null 2>&1
echo "warming up..."
sweep
sleep 8

printf '\n%-8s %8s %10s %12s\n' mode write_s catchup_s apply_miss

for mode in ${MODES}; do
    if [ "$mode" = "off" ]; then
        r "put tunable 'rep_prefault' '0'" >/dev/null 2>&1
    elif [ "$mode" = "adapt" ]; then
        r "put tunable 'rep_prefault' '1'" >/dev/null 2>&1
        r "put tunable 'rep_prefault_adaptive' '1'" >/dev/null 2>&1
        b=$(r "select value from comdb2_tunables where name='rep_prefault_budget'")
        [ "$b" = "0" ] && r "put tunable 'rep_prefault_budget' '64'" >/dev/null 2>&1
    else
        r "put tunable 'rep_prefault' '1'" >/dev/null 2>&1
        r "put tunable 'rep_prefault_adaptive' '0'" >/dev/null 2>&1
        r "put tunable 'rep_prefault_lookahead' '${mode#static}'" >/dev/null 2>&1
    fi
    miss0=$(apply_miss)

    # The "downtime": freeze the replicant while the master takes the writes.
    ssh -o StrictHostKeyChecking=no $rep "pkill -STOP -f 'comdb2 ${dbnm}'" </dev/null
    t0=$SECONDS
    sweep
    t1=$SECONDS
    target=$(lsn_of "$master")
    ssh -o StrictHostKeyChecking=no $rep "pkill -CONT -f 'comdb2 ${dbnm}'" </dev/null

    # Catch-up: reconnect plus applying the whole backlog flat out.
    deadline=$((SECONDS + 300))
    while :; do
        cur=$(lsn_of "$rep")
        case "$cur" in ''|*[!0-9]*) cur=0 ;; esac
        [ "$cur" -ge "$target" ] && break
        if [ $SECONDS -gt $deadline ]; then
            echo "TIMEOUT waiting for replicant to catch up" >&2
            exit 1
        fi
        sleep 0.2
    done
    t2=$SECONDS
    miss1=$(apply_miss)

    suffix=""
    if [ "$mode" = "adapt" ]; then
        b=$(r "select value from comdb2_tunables where name='rep_prefault_budget'")
        suffix="  (budget=$b)"
    fi
    printf '%-8s %8s %10s %12s%s\n' "$mode" $((t1-t0)) $((t2-t1)) \
        $((miss1-miss0)) "$suffix"

    # Let replication and the cache settle before the next phase.
    sleep 5
done

r "put tunable 'rep_prefault' '1'" >/dev/null 2>&1
r "put tunable 'rep_prefault_budget' '64'" >/dev/null 2>&1
r "put tunable 'rep_prefault_adaptive' '1'" >/dev/null 2>&1

echo
echo "TESTCASE PASSED"
exit 0
