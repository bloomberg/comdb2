#!/usr/bin/env bash

# Client transactions with remote writes pushed over cdb2api; every scenario
# runs on the source db and checks the data on both dbs.
#
# DBNAME is the remote db, SECONDARY_DBNAME is the source db

vars="DBNAME CDB2_CONFIG SECONDARY_DBNAME SECONDARY_CDB2_CONFIG"
for required in $vars; do
    if [[ -z "${!required}" ]]; then
        echo "$required not set" >&2
        exit 1
    fi
done

REM="${CDB2SQL_EXE} --tabs --cdb2cfg ${CDB2_CONFIG} ${DBNAME}"
SRC="${CDB2SQL_EXE} --tabs --cdb2cfg ${SECONDARY_CDB2_CONFIG} ${SECONDARY_DBNAME}"
RTBL="LOCAL_${DBNAME}.t"

failexit()
{
    echo "Failed: $1"
    exit 1
}

# run sql (stdin) on source db, fail on any statement error
# $1: name
run()
{
    local out rc
    echo "== $1"
    out=$($SRC default - 2>&1)
    rc=$?
    echo "$out"
    if [[ $rc -ne 0 ]] || echo "$out" | grep -q "failed with rc"; then
        failexit "$1: sql failed"
    fi
}

# $1: name, $2: SRC|REM, $3: sql, $4: expected
expect()
{
    local got
    if [[ "$2" == "SRC" ]]; then
        got=$($SRC default "$3" | xargs)
    else
        got=$($REM default "$3" | xargs)
    fi
    [[ "$got" != "$4" ]] && failexit "$1: '$3' on $2 got '$got', expected '$4'"
}

# run sql (stdin) on source db with effects shown; returns the effects of the
# last statement (the commit), as "affected selected deleted updated inserted"
commit_effects()
{
    local out
    out=$($SRC --showeffects default - 2>&1)
    echo "$out" >&2
    if echo "$out" | grep -q "failed with rc"; then
        failexit "sql failed"
    fi
    echo "$out" | grep "Number of rows" | tail -5 | awk '{print $NF}' | xargs
}

pushw=$($SRC default "select value from comdb2_tunables where name='foreign_db_push_remote_writes'")
[[ "$pushw" != "ON" ]] && failexit "foreign_db_push_remote_writes is '$pushw', expected ON"

$REM default "create table t(id int)" || failexit "create remote table"
$SRC default "create table t(id int)" || failexit "create local table"
$REM default "insert into t select value from generate_series(1, 10)" || failexit "populate remote"
$SRC default "insert into t select value from generate_series(1, 20)" || failexit "populate local"

# the remote db is known after first access
$SRC default "select count(*) from ${RTBL}" > /dev/null || failexit "remote select"

# a local update/delete after a pushed remote write needs a local transaction
run "remote insert, local update" <<EOF
begin
insert into ${RTBL} values (100)
update t set id=1005 where id=5
commit
EOF
expect "remote insert, local update" SRC "select count(*) from t where id=1005" 1
expect "remote insert, local update" REM "select count(*) from t where id=100" 1

# socksql does not see its own uncommitted remote write: max is 100, not 101
run "remote insert, local update with remote read" <<EOF
begin
insert into ${RTBL} values (101)
update t set id=1007 where id=(select max(id) from ${RTBL}) - 93
commit
EOF
expect "remote insert, local update with remote read" SRC "select count(*) from t where id=1007" 1
expect "remote insert, local update with remote read" REM "select count(*) from t where id=101" 1

run "remote insert, local insert" <<EOF
begin
insert into ${RTBL} values (102)
insert into t values (500)
commit
EOF
expect "remote insert, local insert" SRC "select count(*) from t where id=500" 1
expect "remote insert, local insert" REM "select count(*) from t where id=102" 1

run "remote insert, local delete" <<EOF
begin
insert into ${RTBL} values (103)
delete from t where id=9
commit
EOF
expect "remote insert, local delete" SRC "select count(*) from t where id=9" 0
expect "remote insert, local delete" REM "select count(*) from t where id=103" 1

run "remote insert, local update, remote insert" <<EOF
begin
insert into ${RTBL} values (104)
update t set id=1010 where id=10
insert into ${RTBL} values (105)
commit
EOF
expect "remote insert, local update, remote insert" SRC "select count(*) from t where id=1010" 1
expect "remote insert, local update, remote insert" REM "select count(*) from t where id in (104, 105)" 2

run "local update, remote insert" <<EOF
begin
update t set id=1006 where id=6
insert into ${RTBL} values (106)
commit
EOF
expect "local update, remote insert" SRC "select count(*) from t where id=1006" 1
expect "local update, remote insert" REM "select count(*) from t where id=106" 1

run "remote insert, local update, rollback" <<EOF
begin
insert into ${RTBL} values (107)
update t set id=1011 where id=11
rollback
EOF
expect "remote insert, local update, rollback" SRC "select count(*) from t where id=11" 1
expect "remote insert, local update, rollback" REM "select count(*) from t where id=107" 0

# remote-only transactions, no local transaction
run "remote-only commit" <<EOF
begin
insert into ${RTBL} values (108)
commit
EOF
expect "remote-only commit" REM "select count(*) from t where id=108" 1

run "remote-only rollback" <<EOF
begin
insert into ${RTBL} values (109)
rollback
EOF
expect "remote-only rollback" REM "select count(*) from t where id=109" 0

echo "== remote-only, client disconnects without commit"
printf "begin\ninsert into ${RTBL} values (110)\n" | $SRC default - 2>&1
sleep 2
expect "remote-only, disconnect" REM "select count(*) from t where id=110" 0

# effects at commit, with verifyretry off (effects tracked per statement)
echo "== effects, remote insert, local read, local insert"
eff=$(commit_effects <<EOF
set verifyretry off
begin
insert into ${RTBL} select value from generate_series(120, 121)
select count(*) from t
insert into t values (600)
commit
EOF
)
echo "commit effects: $eff"
[[ "$eff" != "3 1 0 0 3" ]] && failexit "mixed commit effects '$eff', expected '3 1 0 0 3'"
expect "effects mixed" REM "select count(*) from t where id in (120, 121)" 2
expect "effects mixed" SRC "select count(*) from t where id=600" 1

echo "== effects, remote-only"
eff=$(commit_effects <<EOF
set verifyretry off
begin
insert into ${RTBL} select value from generate_series(130, 132)
commit
EOF
)
echo "commit effects: $eff"
[[ "$eff" != "3 0 0 0 3" ]] && failexit "remote-only commit effects '$eff', expected '3 0 0 0 3'"
expect "effects remote-only" REM "select count(*) from t where id between 130 and 132" 3

if cat ${TESTDIR}/logs/${SECONDARY_DBNAME}*.db 2>/dev/null | grep -q "wrong sql transaction"; then
    failexit "source db ran a local write without a local transaction"
fi

echo "SUCCESS"
