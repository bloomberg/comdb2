#!/usr/bin/env bash
bash -n "$0" || exit 1

# On a physrep, startup recovery leaves DB_AM_RECOVER handles ahead of the
# table handles, so load-cache borrows one.  Log apply closes those handles
# without the schema lock: load-cache must hold a reference while it reads
# pages, or the close frees the handle under it.

source ${TESTSROOTDIR}/tools/runit_common.sh

export COPYCOMDB2_EXE=${BUILDDIR}/db/copycomdb2
export DESTDB=${TESTCASE}dest${TESTID}
export DEST_DBDIR=${DBDIR}/$DESTDB
export replog=$DEST_DBDIR/$DESTDB.log

# load_cache_delay sleeps in load_fileids for files with this prefix
tbl=t_load_cache_race_a

function failexit
{
    echo "Failed: $1"
    [[ -f $DEST_DBDIR/${DESTDB}.pid ]] && kill -9 $(cat $DEST_DBDIR/${DESTDB}.pid) 2>/dev/null
    exit 1
}

function src_sql
{
    $CDB2SQL_EXE -s --tabs $CDB2_OPTIONS $DBNAME default "$1" 2>&1
}

function dest_sql
{
    $CDB2SQL_EXE -s --tabs $CDB2_OPTIONS $DESTDB @localhost "$1" 2>&1
}

function dest_send
{
    $CDB2SQL_EXE --admin $CDB2_OPTIONS --host localhost $DESTDB "exec procedure sys.cmd.send('$1')"
}

function physrep_alive
{
    kill -0 $(cat $DEST_DBDIR/${DESTDB}.pid) 2>/dev/null
}

function start_physrep
{
    ( timeout $TEST_TIMEOUT ${DEBUG_PREFIX} $COMDB2_EXE $DESTDB -lrl $DEST_DBDIR/${DESTDB}.lrl -pidfile $DEST_DBDIR/${DESTDB}.pid >$replog 2>&1) &
    local j=0
    while [[ $j -lt 60 ]]; do
        dest_sql "select 1" >/dev/null 2>&1 && return 0
        sleep 1
        let j=j+1
    done
    failexit "physrep did not come up"
}

function create_physrep
{
    mkdir -p $DEST_DBDIR
    if [[ -z "$CLUSTER" ]]; then
        cl="-y @localhost"
        rmt=""
    else
        cl="-y @$(echo $CLUSTER | tr ' ' ',')"
        if [[ "$CLUSTER" =~ .*$myhost.* ]]; then
            rmt=""
        else
            clarray=($CLUSTER)
            rmt="${clarray[0]}:"
        fi
    fi

    ${COPYCOMDB2_EXE} -x ${COMDB2_EXE} -H $DESTDB $cl $rmt${DBDIR}/${DBNAME}.lrl $DEST_DBDIR $DEST_DBDIR
    [[ $? -ne 0 ]] && failexit "copycomdb2 failed"

    df $DBDIR | awk '{print $1 }' | grep "tmpfs\|nfs" && echo "setattr directio 0" >> $DEST_DBDIR/${DESTDB}.lrl
    if [ -n "$PMUXPORT" ] ; then
        echo "portmux_port $PMUXPORT" >> $DEST_DBDIR/${DESTDB}.lrl
        echo "portmux_bind_path $pmux_socket" >> $DEST_DBDIR/${DESTDB}.lrl
    fi
    echo "physrep_debug 1" >> $DEST_DBDIR/${DESTDB}.lrl
    echo "physrep_reconnect_penalty 0" >> $DEST_DBDIR/${DESTDB}.lrl

    start_physrep
}

function override_physrep_sp
{
    local mnode=`getmaster`
    ${CDB2SQL_EXE} $CDB2_OPTIONS $DBNAME --host $mnode "create procedure 'sys.physrep.register_replicant' version '1' { `cat ./register_replicant.lua`  }"
    # No registry tables here: make the SPs that write them no-ops
    for sp in reset_nodes update_registry keepalive keepalive_v2; do
        ${CDB2SQL_EXE} $CDB2_OPTIONS $DBNAME --host $mnode "create procedure 'sys.physrep.$sp' version '1' { local function main() end }"
    done
}

function wait_for_sync
{
    local j=0 s d
    while [[ $j -lt 120 ]]; do
        s=$(src_sql "select count(*) from $tbl")
        d=$(dest_sql "select count(*) from $tbl")
        [[ "$s" == "$d" ]] && return 0
        sleep 1
        let j=j+1
    done
    failexit "physrep never caught up: source=$s physrep=$d"
}

function run_test
{
    src_sql "create table $tbl(a int, b blob)" >/dev/null || failexit "create table"
    src_sql "create index ${tbl}_a on $tbl(a)" >/dev/null || failexit "create index"
    src_sql "insert into $tbl select value, randomblob(256) from generate_series(1, 2000)" >/dev/null
    override_physrep_sp

    create_physrep
    wait_for_sync

    # Build and apply enough log history for the checkpoint to retain live
    # dbreg entries that startup recovery must reopen.
    local i=0
    while [[ $i -lt 10 ]]; do
        src_sql "insert into $tbl select value, randomblob(1024) from generate_series(1, 5000)" >/dev/null
        let i=i+1
    done
    wait_for_sync

    # Save a pagelist that includes the table, then stop the physrep
    dest_sql "select count(*) from $tbl where b is not null" >/dev/null
    dest_send "dump_cache" || failexit "dump_cache"
    dest_send "bdb checkpoint" || failexit "checkpoint physrep"
    sleep 2
    kill -9 $(cat $DEST_DBDIR/${DESTDB}.pid)
    sleep 2

    # Reuse the source's dbreg slots for new files while the physrep is down.
    # Applying the resulting DBREG_OPEN records closes the old recovery handles
    # on a fileid mismatch, without taking the schema lock.
    src_sql "truncate table $tbl" >/dev/null || failexit "truncate source table"

    # On restart the physrep's startup recovery leaves DB_AM_RECOVER handles
    # ahead of the table handles, so the startup cache load borrows them and
    # sleeps on each.  Log apply reaches the source's dbreg records meanwhile
    # and closes those handles without the schema lock.
    echo "load_cache_delay 1" >> $DEST_DBDIR/${DESTDB}.lrl
    start_physrep
    dest_send "bdb checkpoint" || failexit "checkpoint during cache load"
    sleep 20
    physrep_alive || failexit "physrep crashed during startup load_cache"
    wait_for_sync
    physrep_alive || failexit "physrep crashed after load_cache"

    kill -9 $(cat $DEST_DBDIR/${DESTDB}.pid)
}

run_test
echo "Success"
exit 0
