+tunable_value ::= INTEGER.
+tunable_value(V) ::= MINUS number(N). {
+    Token t;
+    char *z = sqlite3DbMallocRawNN(pParse->db, N.n+1);
+    t.z = z;
+    t.n = N.n+1;
+    memcpy(z+1, N.z, N.n);
+    z[0] = '-';
+    V = t;
+}
+tunable_value ::= STRING.
